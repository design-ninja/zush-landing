#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ -f "$ROOT_DIR/.env.1password.gsc" ]]; then
  exec "$ROOT_DIR/scripts/with-1password.sh" \
    --env-file .env.1password.gsc \
    -- python3 "$ROOT_DIR/scripts/gsc_mcp_server.py" "$@"
fi

exec python3 "$ROOT_DIR/scripts/gsc_mcp_server.py" "$@"
