#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MCP_BIN="$ROOT_DIR/node_modules/.bin/paddle"

[[ -x "$MCP_BIN" ]] || {
  echo "Pinned Paddle MCP binary not found. Run pnpm install without secrets." >&2
  exit 1
}

exec "$ROOT_DIR/scripts/with-1password.sh" \
  --env-file .env.1password.paddle-mcp \
  -- "$MCP_BIN" "$@"
