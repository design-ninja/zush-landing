{
  "name": "zush-landing",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "author": "lirik",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "dev:sandbox": "astro dev --mode sandbox",
    "build": "node scripts/ensure-git-history.mjs && pnpm check:pricing && pnpm check:paddle-env && astro sync --force && astro build",
    "build:sandbox": "pnpm check:pricing && pnpm check:paddle-env:sandbox && astro build --mode sandbox",
    "preview": "astro preview",
    "lint": "eslint .",
    "check:astro": "astro check",
    "check:locale": "node scripts/check-locale-autodetect.mjs",
    "check:blog-locales": "node scripts/check-blog-localization-coverage.mjs --strict",
    "check:locale-fallbacks": "node scripts/check-localized-copy-fallbacks.mjs --strict",
    "check:localized-landings": "node scripts/check-localized-landing-coverage.mjs",
    "check:localization-sources": "node scripts/check-localization-source-revisions.mjs",
    "check:paddle-env": "node scripts/check-production-paddle-env.mjs",
    "check:paddle-env:sandbox": "MODE=sandbox ALLOW_SANDBOX_PADDLE_BUILD=1 node scripts/check-production-paddle-env.mjs",
    "check:payments": "node scripts/verify-payments.mjs",
    "check:pricing": "node scripts/check-pricing.mjs",
    "check:product-facts": "node scripts/check-product-facts.mjs",
    "check:ads-plan": "node scripts/check-google-search-plan.mjs",
    "check:seo-middleware": "node scripts/check-seo-middleware.mjs",
    "check:seo-redirects": "node scripts/check-seo-redirects.mjs",
    "check:html": "node scripts/check-html-smoke.mjs",
    "check:links": "node scripts/check-internal-links.mjs",
    "seo:indexnow": "node scripts/indexnow-ping.mjs",
    "seo:indexnow:deployed": "node scripts/indexnow-after-deploy.mjs",
    "seo:snapshot": "node scripts/seo-snapshot.mjs",
    "blog:covers": "node scripts/blog-covers/generate.mjs",
    "og:images": "node scripts/og-images/generate.mjs",
    "check:seo": "pnpm check:astro && pnpm check:locale && pnpm check:localization-sources && pnpm check:locale-fallbacks && pnpm check:localized-landings && pnpm check:blog-locales && pnpm check:payments && pnpm check:pricing && pnpm check:product-facts && pnpm check:seo-middleware && pnpm check:seo-redirects && pnpm build && pnpm check:html && pnpm check:links",
    "check:seo:sandbox": "pnpm check:astro && pnpm check:locale && pnpm check:localization-sources && pnpm check:locale-fallbacks && pnpm check:localized-landings && pnpm check:blog-locales && pnpm check:payments && pnpm check:pricing && pnpm check:product-facts && pnpm check:seo-middleware && pnpm check:seo-redirects && pnpm build:sandbox && pnpm check:html && pnpm check:links",
    "youtube:auth": "node scripts/youtube-upload.mjs auth",
    "youtube:dry-run": "node scripts/youtube-upload.mjs dry-run",
    "youtube:upload": "node scripts/youtube-upload.mjs upload",
    "youtube:dry-run:hq": "node scripts/youtube-upload.mjs dry-run --config scripts/youtube-videos-hq-light.json",
    "youtube:upload:hq": "node scripts/youtube-upload.mjs upload --config scripts/youtube-videos-hq-light.json",
    "promo:feature-screenshots": "node scripts/promo/zush-feature-screenshots.mjs",
    "promo:responsive-showcase-images": "node scripts/promo/generate-showcase-responsive-assets.mjs",
    "promo:feature-videos": "node scripts/promo/zush-feature-videos.mjs",
    "promo:windows-feature-screenshots": "node scripts/promo/zush-windows-feature-screenshots.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "bowser": "^2.14.1",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/react": "^7.0.1",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/starlight": "^0.42.6",
    "@astrojs/vercel": "^11.0.13",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@paddle/paddle-mcp": "0.1.6",
    "@posthog/rollup-plugin": "^1.6.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/functions": "3.9.11",
    "astro": "^7.3.8",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "parse5": "8.0.1",
    "playwright-core": "1.64.0",
    "remark-gfm": "^4.0.1",
    "sass": "^1.105.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  }
}
