---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FeatureLandingPageShell from '@/components/FeatureLandingPage/FeatureLandingPageShell.astro';
import { SEARCH_LANDING_PAGES } from '@/data/searchLandingPages';
import { getSeoForPath } from '@/seo/config';
import { buildFeatureBreadcrumbJsonLd } from '@/utils/jsonLd';

const seo = getSeoForPath('/rename-scanned-documents');
const page = SEARCH_LANDING_PAGES['rename-scanned-documents'];
---

<BaseLayout seo={seo} headerWidth="container" jsonLd={[page.jsonLd, buildFeatureBreadcrumbJsonLd(page.h1, '/rename-scanned-documents')]}>
  <FeatureLandingPageShell {...page} />
</BaseLayout>
