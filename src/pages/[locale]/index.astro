---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomePageContent from '@/components/HomePage/HomePageContent.astro';
import { buildFAQPageJsonLd, buildWebPageJsonLd } from '@/utils/jsonLd';
import { getCopy } from '@/i18n/copy';
import { getLocalizedSeoForRoute } from '@/i18n/seo';
import { getLocaleBasePath, LOCALES, type Locale } from '@/i18n/config';
import { getLocalizedContent } from '@/i18n/localizedContent';

export function getStaticPaths() {
  return LOCALES
    .filter((locale) => locale !== 'en')
    .map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Exclude<Locale, 'en'>;
const localizedContent = getLocalizedContent(locale);
const copy = { ...getCopy(locale), home: localizedContent.home };
const seo = getLocalizedSeoForRoute('/', locale);
const chromeBasePath = getLocaleBasePath(locale);
const localizedWebPageJsonLd = buildWebPageJsonLd({
  pagePath: chromeBasePath,
  title: seo.title,
  description: seo.description,
  inLanguage: locale,
  mainEntityId: 'https://zushapp.com/#software',
});
---

<BaseLayout
  seo={seo}
  jsonLd={[localizedWebPageJsonLd, buildFAQPageJsonLd(copy.home.faqItems)]}
  locale={locale}
  chromeBasePath={chromeBasePath}
>
  <HomePageContent
    copy={copy}
    locale={locale}
    secondaryHref="#pricing"
    professionCopy={localizedContent.professions}
  />
</BaseLayout>
