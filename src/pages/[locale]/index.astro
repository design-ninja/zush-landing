---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomePageContent from '@/components/HomePage/HomePageContent.astro';
import { HOME_JSON_LD } from '@/seo/config';
import { buildFAQPageJsonLd } from '@/utils/jsonLd';
import { getCopy } from '@/i18n/copy';
import { getLocalizedSeoForRoute } from '@/i18n/seo';
import { getLocaleBasePath, LOCALES, type Locale } from '@/i18n/config';
import { PRO_PRICING } from '@/constants/pricing';
import { getLocalizedContent } from '@/i18n/localizedContent';

export function getStaticPaths() {
  return LOCALES
    .filter((locale) => locale !== 'en')
    .map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Exclude<Locale, 'en'>;
const localizedContent = getLocalizedContent(locale);
const copy = { ...getCopy(locale), home: localizedContent.home };
const seo = getLocalizedSeoForRoute('/', locale);
const chromeBasePath = getLocaleBasePath(locale);
const localizedJsonLd = {
  ...HOME_JSON_LD,
  '@graph': HOME_JSON_LD['@graph'].map((entry) => {
    const type = (entry as { '@type': string })['@type'];

    if (type === 'SoftwareApplication') {
      return {
        ...entry,
        description: copy.footer.description,
        offers: [
          {
            '@type': 'Offer',
            price: '0',
            priceCurrency: 'USD',
            description: copy.home.downloadHintPrefix,
          },
          {
            '@type': 'Offer',
            price: PRO_PRICING.monthly.schemaPrice,
            priceCurrency: 'USD',
            name: 'Zush PRO Monthly',
            description: 'Monthly subscription with unlimited renames across Cloud AI, BYOK, and Local AI.',
          },
          {
            '@type': 'Offer',
            price: PRO_PRICING.oneTime.schemaPrice,
            priceCurrency: 'USD',
            name: 'Zush PRO One-Time',
            description: 'One-time purchase with unlimited renames across Cloud AI, BYOK, and Local AI.',
          },
        ],
        featureList: copy.pricing.features.map((item) => item.title),
      };
    }

    return entry;
  }),
};
---

<BaseLayout
  seo={seo}
  jsonLd={[localizedJsonLd, buildFAQPageJsonLd(copy.home.faqItems)]}
  locale={locale}
  chromeBasePath={chromeBasePath}
>
  <HomePageContent
    copy={copy}
    locale={locale}
    secondaryHref="#pricing"
    professionCopy={localizedContent.professions}
  />
</BaseLayout>
