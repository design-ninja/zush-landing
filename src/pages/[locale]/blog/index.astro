---
import BaseLayout, { type AlternateLink } from '@/layouts/BaseLayout.astro';
import BlogPostCard from '@/components/blog/BlogPostCard.astro';
import { getTranslatedBlogLocales, getTranslatedPostsForLocale } from '@/data/blog';
import type { BlogLocale } from '@/data/blogSchema';
import { LOCALE_META, type Locale } from '@/i18n/config';
import { BLOG_INDEX_COPY } from '@/i18n/blogIndex';
import { getBlogPostCopy } from '@/i18n/blogPost';
import { SITE_ORIGIN, getCanonicalUrl, type SeoMeta } from '@/seo/config';
import { SOFTWARE_REF } from '@/seo/entity';
import headingStyles from '@/components/Heading/Heading.module.scss';
import textStyles from '@/components/Text/Text.module.scss';
import backToHomeStyles from '@/components/BackToHome/BackToHome.module.scss';
import sectionHeaderStyles from '@/components/SectionHeader/SectionHeader.module.scss';
import styles from '@/views/Blog/BlogList.module.scss';

/**
 * Lists the translated posts of one locale at `/<locale>/blog`. Before this page
 * existed, translations were reachable only through hreflang, the sitemap and a
 * few in-text links. More specific than `[locale]/[...slug].astro`, so Astro
 * routes `/de/blog` here.
 */
export async function getStaticPaths() {
  const locales = await getTranslatedBlogLocales();

  return locales.map((locale) => ({
    params: { locale: LOCALE_META[locale as Locale].slug },
    props: { blogLocale: locale },
  }));
}

const { blogLocale } = Astro.props as { blogLocale: Exclude<BlogLocale, 'en'> };
const localeMeta = LOCALE_META[blogLocale as Locale];
const copy = BLOG_INDEX_COPY[blogLocale];
const postCopy = getBlogPostCopy(blogLocale);
const basePath = `/${localeMeta.slug}`;
const indexPath = `${basePath}/blog`;
const indexUrl = getCanonicalUrl(indexPath);
const posts = await getTranslatedPostsForLocale(blogLocale);
const blogLocales = await getTranslatedBlogLocales();

const alternates: AlternateLink[] = [
  { hreflang: 'en', href: getCanonicalUrl('/blog') },
  ...blogLocales.map((locale) => ({
    hreflang: LOCALE_META[locale as Locale].lang,
    href: getCanonicalUrl(`/${LOCALE_META[locale as Locale].slug}/blog`),
  })),
];
const languagePaths: Partial<Record<Locale, string>> = {
  en: '/blog',
  ...Object.fromEntries(
    blogLocales.map((locale) => [locale, `/${LOCALE_META[locale as Locale].slug}/blog`]),
  ),
};

const seo: SeoMeta = {
  title: copy.title,
  description: copy.description,
  canonicalPath: indexPath,
  robots: 'index, follow',
  ogType: 'website',
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${indexUrl}#webpage`,
      url: indexUrl,
      name: copy.title,
      description: copy.description,
      inLanguage: localeMeta.lang,
      isPartOf: { '@id': `${SITE_ORIGIN}/#website` },
      about: SOFTWARE_REF,
      mainEntity: { '@id': `${indexUrl}#posts` },
      breadcrumb: { '@id': `${indexUrl}#breadcrumb` },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${indexUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: postCopy.breadcrumbHome, item: getCanonicalUrl(basePath) },
        { '@type': 'ListItem', position: 2, name: postCopy.breadcrumbBlog, item: indexUrl },
      ],
    },
    {
      '@type': 'ItemList',
      '@id': `${indexUrl}#posts`,
      name: copy.allPostsHeading,
      numberOfItems: posts.length,
      itemListElement: posts.map((post, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: getCanonicalUrl(`${basePath}/blog/${post.slug}`),
        name: post.title,
      })),
    },
  ],
};
---

<BaseLayout
  seo={seo}
  jsonLd={jsonLd}
  locale={blogLocale as Locale}
  chromeBasePath={basePath}
  alternates={alternates}
  languagePaths={languagePaths}
  disableTopOffset={true}
>
  <section class={[styles.BlogList, styles.BlogList_underHeader, styles.BlogList_glowTopRight].join(' ')}>
    <div class={styles.BlogList__Container}>
      <div class={sectionHeaderStyles.SectionHeader}>
        <h1
          class={[
            headingStyles.Heading,
            headingStyles.Heading_h1,
            headingStyles.Heading_center,
            sectionHeaderStyles.SectionHeader__Title,
          ].join(' ')}
        >
          <span class={styles.BlogList__TitleAccent}>Zush</span> {postCopy.breadcrumbBlog}
        </h1>
        <p
          class={[
            textStyles.Text,
            textStyles.Text_lg,
            textStyles.Text_subtle,
            textStyles.Text_center,
            sectionHeaderStyles.SectionHeader__Description,
          ].join(' ')}
        >
          {copy.intro}
        </p>
      </div>

      <div class={styles.BlogList__Sections}>
        <section class={styles.BlogList__Section}>
          <div class={styles.BlogList__SectionHeader}>
            <div class={styles.BlogList__SectionTitleRow}>
              <h2
                class={[
                  headingStyles.Heading,
                  headingStyles.Heading_h3,
                  styles.BlogList__SectionTitle,
                ].join(' ')}
              >
                {copy.allPostsHeading}
              </h2>
              <span class={styles.BlogList__SectionCount}>{posts.length}</span>
            </div>
          </div>
          <div class={styles.BlogList__SectionActions}>
            <a class={styles.BlogList__SectionAction} href='/blog' hreflang='en'>
              {copy.englishBlogLink}
            </a>
          </div>
          <div class={styles.BlogList__SectionPosts}>
            {posts.map((post) => <BlogPostCard post={post} basePath={basePath} />)}
          </div>
        </section>
      </div>

      <a class={[backToHomeStyles.BackToHome, styles.BlogList__BackLink].join(' ')} href={basePath}>
        ← {postCopy.breadcrumbHome}
      </a>
    </div>
  </section>
</BaseLayout>
