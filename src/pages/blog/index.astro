---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ArrowRight, History, Search, Tags } from 'lucide-react';
import BlogPostCard from '@/components/blog/BlogPostCard.astro';
import {
  type BlogPost,
  getAllTags,
  getBlogIndexSections,
  getRecentBlogPosts,
} from '@/data/blog';
import { PRIMARY_AUTHOR } from '@/data/author';
import { getSeoForPath, SITE_ORIGIN, toIsoDateTime } from '@/seo/config';
import { SOFTWARE_REF } from '@/seo/entity';
import headingStyles from '@/components/Heading/Heading.module.scss';
import textStyles from '@/components/Text/Text.module.scss';
import backToHomeStyles from '@/components/BackToHome/BackToHome.module.scss';
import sectionHeaderStyles from '@/components/SectionHeader/SectionHeader.module.scss';
import styles from '@/views/Blog/BlogList.module.scss';

const seo = getSeoForPath('/blog');
const sections = await getBlogIndexSections();
const recentPosts = await getRecentBlogPosts(6);
const allTags = await getAllTags();
const blogUrl = `${SITE_ORIGIN}/blog`;
const listedPosts = Array.from(
  new Map(
    [...recentPosts, ...sections.flatMap((section) => section.posts)]
      .map((post) => [post.slug, post]),
  ).values(),
);
const toBlogPostingJsonLd = (post: BlogPost) => {
  const postUrl = `${SITE_ORIGIN}/blog/${post.slug}`;

  return {
    '@type': 'BlogPosting',
    '@id': `${postUrl}#blog-posting`,
    headline: post.title,
    url: postUrl,
    mainEntityOfPage: postUrl,
    description: post.description,
    datePublished: toIsoDateTime(post.date),
    dateModified: toIsoDateTime(post.reviewedAt || post.date),
    author: {
      '@type': 'Person',
      '@id': `${PRIMARY_AUTHOR.url}#person`,
      name: PRIMARY_AUTHOR.name,
      alternateName: PRIMARY_AUTHOR.alternateName,
      url: PRIMARY_AUTHOR.url,
    },
    publisher: {
      '@id': `${SITE_ORIGIN}/#organization`,
    },
    isPartOf: {
      '@id': `${blogUrl}#blog`,
    },
    articleSection: post.platform,
    keywords: post.tags.join(', '),
  };
};
const blogPostItems = listedPosts.map(toBlogPostingJsonLd);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Blog',
      '@id': `${blogUrl}#blog`,
      name: 'Zush Blog',
      url: blogUrl,
      description: seo.description,
      publisher: {
        '@id': `${SITE_ORIGIN}/#organization`,
      },
      blogPost: blogPostItems.map((post) => ({
        '@id': post['@id'],
      })),
    },
    {
      '@type': 'CollectionPage',
      '@id': `${blogUrl}#webpage`,
      url: blogUrl,
      name: seo.title,
      description: seo.description,
      isPartOf: {
        '@id': `${SITE_ORIGIN}/#website`,
      },
      about: SOFTWARE_REF,
      mainEntity: {
        '@id': `${blogUrl}#featured-posts`,
      },
      breadcrumb: {
        '@id': `${blogUrl}#breadcrumb`,
      },
      inLanguage: 'en',
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${blogUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: SITE_ORIGIN,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Blog',
          item: blogUrl,
        },
      ],
    },
    {
      '@type': 'ItemList',
      '@id': `${blogUrl}#featured-posts`,
      name: 'Featured Zush blog posts',
      description:
        'Recent and featured guides about AI file renaming, batch renaming, file organization, Mac workflows, and Windows workflows.',
      numberOfItems: listedPosts.length,
      itemListElement: listedPosts.map((post, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: `${SITE_ORIGIN}/blog/${post.slug}`,
        name: post.title,
        item: {
          '@id': `${SITE_ORIGIN}/blog/${post.slug}#blog-posting`,
        },
      })),
    },
    ...blogPostItems,
  ],
};
---

<BaseLayout seo={seo} disableTopOffset={true} jsonLd={jsonLd} headerWidth='wide'>
  <section class={[styles.BlogList, styles.BlogList_underHeader, styles.BlogList_glowTopRight].join(' ')}>
    <div class={styles.BlogList__Container}>
      <div class={sectionHeaderStyles.SectionHeader}>
        <h1
          class={[
            headingStyles.Heading,
            headingStyles.Heading_h1,
            headingStyles.Heading_center,
            sectionHeaderStyles.SectionHeader__Title,
          ].join(' ')}
        >
          <span class={styles.BlogList__TitleAccent}>Zush</span> Blog
        </h1>
        <p
          class={[
            textStyles.Text,
            textStyles.Text_lg,
            textStyles.Text_subtle,
            textStyles.Text_center,
            sectionHeaderStyles.SectionHeader__Description,
          ].join(' ')}
        >
          Guides, comparisons, and real workflows for AI-powered file renaming across Mac, Windows,
          and general desktop setup
        </p>
      </div>

      <form action='/blog/search' class={styles.BlogList__Search} method='get' role='search'>
        <div class={styles.BlogList__SearchField}>
          <span class={styles.BlogList__SearchIcon} aria-hidden='true'>
            <Search size={18} strokeWidth={2.2} />
          </span>
          <input
            aria-label='Search the Zush blog'
            autocomplete='off'
            class={styles.BlogList__SearchInput}
            id='blog-search'
            name='q'
            placeholder='Search all posts…'
            spellcheck='false'
            type='search'
          />
        </div>
        <button class={styles.BlogList__SearchSubmit} type='submit'>Search</button>
      </form>

      <div class={styles.BlogList__IntroLinks}>
        <a class={styles.BlogList__IntroCard} href='/blog/archive'>
          <h2
            class={[
              headingStyles.Heading,
              headingStyles.Heading_h4,
              styles.BlogList__IntroCardTitle,
            ].join(' ')}
          >
            <span class={styles.BlogList__IntroCardTitleIcon} aria-hidden='true'>
              <History size={18} strokeWidth={2.2} />
            </span>
            <span>Browse the full archive</span>
          </h2>
          <p
            class={[
              textStyles.Text,
              textStyles.Text_md,
              textStyles.Text_subtle,
              styles.BlogList__IntroCardDescription,
            ].join(' ')}
          >
            See all posts in publish order, newest first
          </p>
          <span class={styles.BlogList__IntroCardMeta}>
            <span>Open archive</span>
            <ArrowRight size={16} strokeWidth={2.2} />
          </span>
        </a>
        <a class={styles.BlogList__IntroCard} href='/blog/tags'>
          <h2
            class={[
              headingStyles.Heading,
              headingStyles.Heading_h4,
              styles.BlogList__IntroCardTitle,
            ].join(' ')}
          >
            <span class={styles.BlogList__IntroCardTitleIcon} aria-hidden='true'>
              <Tags size={18} strokeWidth={2.2} />
            </span>
            <span>Explore topics and tags</span>
          </h2>
          <p
            class={[
              textStyles.Text,
              textStyles.Text_md,
              textStyles.Text_subtle,
              styles.BlogList__IntroCardDescription,
            ].join(' ')}
          >
            Browse posts by topic, workflow, file type, or platform
          </p>
          <span class={styles.BlogList__IntroCardMeta}>
            <span>{`${allTags.length} tags`}</span>
            <ArrowRight size={16} strokeWidth={2.2} />
          </span>
        </a>
      </div>

      <div class={styles.BlogList__Sections}>
        <section class={styles.BlogList__Section}>
          <div class={styles.BlogList__SectionHeader}>
            <div class={styles.BlogList__SectionTitleRow}>
              <h2
                class={[
                  headingStyles.Heading,
                  headingStyles.Heading_h3,
                  styles.BlogList__SectionTitle,
                ].join(' ')}
              >
                Latest Articles
              </h2>
              <span class={styles.BlogList__SectionCount}>{recentPosts.length}</span>
            </div>
          </div>
          <p
            class={[
              textStyles.Text,
              textStyles.Text_md,
              textStyles.Text_subtle,
              styles.BlogList__SectionDescription,
            ].join(' ')}
          >
            A balanced selection of recent Windows, Mac, and general guides
          </p>
          <div class={styles.BlogList__SectionActions}>
            <a class={styles.BlogList__SectionAction} href='/blog/archive'>
              View all posts
            </a>
            <a class={styles.BlogList__SectionAction} href='/blog/tags'>
              Browse tags
            </a>
          </div>
          <div class={styles.BlogList__SectionPosts}>
            {recentPosts.map((post) => <BlogPostCard post={post} />)}
          </div>
        </section>

        {
          sections.map((section) => (
            <section class={styles.BlogList__Section}>
              <div class={styles.BlogList__SectionHeader}>
                <div class={styles.BlogList__SectionTitleRow}>
                  <h2
                    class={[
                      headingStyles.Heading,
                      headingStyles.Heading_h3,
                      styles.BlogList__SectionTitle,
                    ].join(' ')}
                  >
                    {section.title}
                  </h2>
                  <span class={styles.BlogList__SectionCount}>{section.posts.length}</span>
                </div>
              </div>
              <p
                class={[
                  textStyles.Text,
                  textStyles.Text_md,
                  textStyles.Text_subtle,
                  styles.BlogList__SectionDescription,
                ].join(' ')}
              >
                {section.description}
              </p>
              <div class={styles.BlogList__SectionActions}>
                <a class={styles.BlogList__SectionAction} href='/blog/archive'>
                  Browse archive
                </a>
                <a class={styles.BlogList__SectionAction} href={section.ctaHref}>
                  {section.ctaLabel}
                </a>
              </div>
              <div class={styles.BlogList__SectionPosts}>
                {section.posts.map((post) => <BlogPostCard post={post} />)}
              </div>
            </section>
          ))
        }
      </div>

      <a class={[backToHomeStyles.BackToHome, styles.BlogList__BackLink].join(' ')} href='/'>
        ← Back to Home
      </a>
    </div>
  </section>

</BaseLayout>
