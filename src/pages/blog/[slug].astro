---
import BlogPostLayout, { type TranslationLink } from '@/components/blog/BlogPostLayout.astro';
import type { AlternateLink } from '@/layouts/BaseLayout.astro';
import {
  getAllPosts,
  getBlogPostBySlug,
  getRelatedPosts,
  getTranslationsBySlug,
} from '@/data/blog';
import { PRO_PRICING } from '@/constants/pricing';
import type { BlogLocale } from '@/data/blogSchema';
import { buildAppAggregateRatingJsonLd } from '@/seo/appRating';
import { getBlogSeo, getCanonicalUrl } from '@/seo/config';
import {
  buildBlogPostingJsonLd,
  buildBreadcrumbJsonLd,
  buildFAQPageJsonLd,
  buildHowToJsonLd,
} from '@/utils/jsonLd';
import { HOW_TO_SCHEMAS } from '@/data/howToSchemas';
import { LOCALE_META, type Locale } from '@/i18n/config';
import { TRANSLATION_LINK_LABEL, TRANSLATION_LINK_PRIORITY } from '@/i18n/blogPost';

export async function getStaticPaths() {
  const posts = await getAllPosts();

  return posts.map((post) => ({
    params: { slug: post.slug },
  }));
}

const { slug } = Astro.params;

if (!slug) {
  throw new Error('Missing blog slug');
}

const details = await getBlogPostBySlug(slug);

if (!details) {
  throw new Error(`Unknown blog slug: ${slug}`);
}

const { entry, post, faq } = details;
const relatedPosts = await getRelatedPosts(post.slug);
const seo = getBlogSeo(post);
const howTo = HOW_TO_SCHEMAS[post.slug];
const blogPath = `/blog/${post.slug}`;
const isSelfCanonical = seo.canonicalPath === blogPath;
const canonicalUrl = getCanonicalUrl(seo.canonicalPath);
const macAiRenamerComparisonJsonLd = post.slug === 'best-ai-file-renamer-tools-mac-compared'
  ? {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      '@id': `${canonicalUrl}#mac-ai-file-renamers`,
      name: 'Mac AI renamer app comparison',
      description:
        'Comparison of Mac file renaming apps by mixed-folder support, automation, rollback, BYOK, offline AI, RAW files, and pricing.',
      numberOfItems: 6,
      itemListOrder: 'https://schema.org/ItemListOrderAscending',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Zush',
          description:
            'Strong fit for mixed Mac folders that include screenshots, PDFs, RAW photos, design files, iWork files, audio, video, and documents.',
          url: 'https://zushapp.com/mac',
          item: {
            '@type': 'SoftwareApplication',
            '@id': 'https://zushapp.com/mac#software',
            name: 'Zush',
            url: 'https://zushapp.com/mac',
            applicationCategory: 'UtilitiesApplication',
            applicationSubCategory: 'File Management',
            operatingSystem: ['macOS 15.0+', 'Windows 10', 'Windows 11'],
            description:
              'AI file renamer for Mac with content-aware batch rename, preview, folder monitoring, templates, 145+ Naming Blocks, BYOK, Offline AI mode, and rollback history.',
            ...buildAppAggregateRatingJsonLd(),
            featureList: [
              'Mixed-folder AI file renaming',
              'RAW, HEIC, PDF, Office, iWork, design, audio, and video support',
              'Folder monitoring',
              'Preview before applying',
              'Rename history and rollback',
              'BYOK and Offline AI mode',
            ],
            offers: [
              {
                '@type': 'Offer',
                name: 'Free',
                price: '0',
                priceCurrency: 'USD',
                description: 'Free starter tier with 50 renames across Cloud AI, BYOK, and Offline AI.',
              },
              {
                '@type': 'Offer',
                name: 'Zush PRO Monthly',
                price: PRO_PRICING.monthly.schemaPrice,
                priceCurrency: 'USD',
                description: 'Monthly PRO plan.',
              },
              {
                '@type': 'Offer',
                name: 'Zush PRO One-Time',
                price: PRO_PRICING.oneTime.schemaPrice,
                priceCurrency: 'USD',
                description: 'One-time PRO plan.',
              },
            ],
          },
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Renamer.ai',
          description:
            'Best for OCR-heavy document and vector workflows (EPS, SVG, AI) with Magic Folders, on metered subscription pricing.',
          url: 'https://renamer.ai/',
          item: {
            '@type': 'SoftwareApplication',
            name: 'Renamer.ai',
            url: 'https://renamer.ai/',
            applicationCategory: 'UtilitiesApplication',
            applicationSubCategory: 'File Management',
            operatingSystem: ['macOS', 'Windows'],
          },
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: 'AI Renamer',
          description:
            'Lowest-cost local-model desktop app: $19 one-time Local Mode or $10 per 200 cloud credits.',
          url: 'https://airenamer.app/',
          item: {
            '@type': 'SoftwareApplication',
            name: 'AI Renamer',
            url: 'https://airenamer.app/',
            applicationCategory: 'UtilitiesApplication',
            applicationSubCategory: 'File Management',
            operatingSystem: ['macOS', 'Windows'],
          },
        },
        {
          '@type': 'ListItem',
          position: 4,
          name: 'NameQuick',
          description:
            'Best for Mac-native depth with Watch Folders, undo, and a Rules Engine; Managed from $12/mo or $69 one-time Self-Managed.',
          url: 'https://www.namequick.app/',
          item: {
            '@type': 'SoftwareApplication',
            name: 'NameQuick',
            url: 'https://www.namequick.app/',
            applicationCategory: 'UtilitiesApplication',
            applicationSubCategory: 'File Management',
            operatingSystem: ['macOS', 'Windows'],
          },
        },
        {
          '@type': 'ListItem',
          position: 5,
          name: 'RenameClick',
          description:
            'Best for local-first processing in desktop-native Mac and Windows apps, with AI Search and folder sorting.',
          url: 'https://rename.click/',
          item: {
            '@type': 'SoftwareApplication',
            name: 'RenameClick',
            url: 'https://rename.click/',
            applicationCategory: 'UtilitiesApplication',
            applicationSubCategory: 'File Management',
            operatingSystem: ['macOS', 'Windows'],
          },
        },
        {
          '@type': 'ListItem',
          position: 6,
          name: 'Riffo',
          description:
            'Free-positioned Mac app and web demo with limited public documentation of formats, undo, and pricing.',
          url: 'https://riffo.ai/',
          item: {
            '@type': 'SoftwareApplication',
            name: 'Riffo',
            url: 'https://riffo.ai/',
            applicationCategory: 'UtilitiesApplication',
            applicationSubCategory: 'File Management',
            operatingSystem: 'macOS',
          },
        },
      ],
    }
  : null;
const jsonLd = isSelfCanonical
  ? [
      buildBlogPostingJsonLd(post, canonicalUrl),
      buildBreadcrumbJsonLd(post.title, canonicalUrl),
      ...(faq.length > 0 ? [buildFAQPageJsonLd(faq)] : []),
      ...(howTo ? [buildHowToJsonLd(howTo, canonicalUrl)] : []),
      ...(macAiRenamerComparisonJsonLd ? [macAiRenamerComparisonJsonLd] : []),
    ]
  : [];

const translations = await getTranslationsBySlug(post.slug);
const translationLocales = Object.keys(translations) as BlogLocale[];
// hreflang is emitted only when this page is itself indexable and self-canonical:
// a cluster that includes a noindex or canonicalised member is discarded wholesale.
const canJoinCluster = isSelfCanonical && seo.robots !== 'noindex, nofollow';
const alternates: AlternateLink[] | undefined =
  canJoinCluster && translationLocales.length > 0
    ? [
        { hreflang: 'en', href: getCanonicalUrl(blogPath) },
        ...translationLocales.map((locale) => ({
          hreflang: LOCALE_META[locale as Locale].lang,
          href: getCanonicalUrl(
            `/${LOCALE_META[locale as Locale].slug}/blog/${translations[locale]!.slug}`,
          ),
        })),
      ]
    : undefined;

const languagePaths: Partial<Record<Locale, string>> | undefined =
  translationLocales.length > 0
    ? {
        en: blogPath,
        ...Object.fromEntries(
          translationLocales.map((locale) => [
            locale,
            `/${LOCALE_META[locale as Locale].slug}/blog/${translations[locale]!.slug}`,
          ]),
        ),
      }
    : undefined;

const firstTranslationLocale =
  TRANSLATION_LINK_PRIORITY.find((locale) => locale in translations) ?? translationLocales[0];
const firstTranslation = firstTranslationLocale ? translations[firstTranslationLocale] : undefined;
const translationLink: TranslationLink | undefined =
  firstTranslationLocale && firstTranslation
    ? {
        label: TRANSLATION_LINK_LABEL[firstTranslationLocale],
        href: `/${LOCALE_META[firstTranslationLocale as Locale].slug}/blog/${firstTranslation.slug}`,
        title: firstTranslation.title,
        lang: LOCALE_META[firstTranslationLocale as Locale].lang,
      }
    : undefined;
---

<BlogPostLayout
  entry={entry}
  post={post}
  relatedPosts={relatedPosts}
  seo={seo}
  jsonLd={jsonLd}
  chromeLocale='en'
  chromeBasePath='/'
  blogIndexHref='/blog'
  alternates={alternates}
  languagePaths={languagePaths}
  translationLink={translationLink}
/>
