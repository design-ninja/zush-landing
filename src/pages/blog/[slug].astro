---
import BlogPostLayout, { type TranslationLink } from '@/components/blog/BlogPostLayout.astro';
import type { AlternateLink } from '@/layouts/BaseLayout.astro';
import {
  getAllPosts,
  getBlogPostBySlug,
  getRelatedPosts,
  getTranslationsBySlug,
} from '@/data/blog';
import type { BlogLocale } from '@/data/blogSchema';
import { getBlogSeo, getCanonicalUrl } from '@/seo/config';
import {
  buildBlogPostingJsonLd,
  buildBreadcrumbJsonLd,
  buildFAQPageJsonLd,
  buildHowToJsonLd,
} from '@/utils/jsonLd';
import { HOW_TO_SCHEMAS } from '@/data/howToSchemas';
import { LOCALE_META, type Locale } from '@/i18n/config';
import { TRANSLATION_LINK_LABEL, TRANSLATION_LINK_PRIORITY } from '@/i18n/blogPost';

export async function getStaticPaths() {
  const posts = await getAllPosts();

  return posts.map((post) => ({
    params: { slug: post.slug },
  }));
}

const { slug } = Astro.params;

if (!slug) {
  throw new Error('Missing blog slug');
}

const details = await getBlogPostBySlug(slug);

if (!details) {
  throw new Error(`Unknown blog slug: ${slug}`);
}

const { entry, post, faq } = details;
const relatedPosts = await getRelatedPosts(post.slug);
const seo = getBlogSeo(post);
const howTo = HOW_TO_SCHEMAS[post.slug];
const blogPath = `/blog/${post.slug}`;
const isSelfCanonical = seo.canonicalPath === blogPath;
const canonicalUrl = getCanonicalUrl(seo.canonicalPath);
const macAiRenamerComparisonJsonLd = post.slug === 'best-ai-file-renamer-tools-mac-compared'
  ? {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      '@id': `${canonicalUrl}#mac-ai-file-renamers`,
      name: 'Best AI file renamers for Mac',
      description:
        'Zush is the best overall AI file renamer for Mac in this editorial comparison of naming control, mixed-file coverage, automation, preview, rollback, and pricing.',
      numberOfItems: 6,
      itemListOrder: 'https://schema.org/ItemListOrderAscending',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Zush — Best overall',
          description:
            'Best overall for configurable naming across mixed Mac folders, with 100+ published formats, folder monitoring, preview, and full Rename History with batch revert.',
          url: 'https://zushapp.com/mac',
          item: {
            '@id': 'https://zushapp.com/mac#software',
          },
        },
        ...[
          ['Renamer.ai', 'Ranks below Zush because every paid tier is metered and no BYOK or local-model mode is published.'],
          ['AI Renamer', 'Ranks below Zush because folder monitoring, Rename History, and granular mixed-file coverage are not documented.'],
          ['NameQuick', 'Ranks below Zush because RAW and per-platform documentation is incomplete and Managed tiers meter renames.'],
          ['RenameClick', 'Ranks below Zush because RAW, design, and video support are not published in its checked format documentation.'],
          ['Riffo', 'Ranks below Zush because dependable format, monitoring, recovery, and pricing documentation is not published.'],
        ].map(([name, description], index) => ({
          '@type': 'ListItem',
          position: index + 2,
          name,
          description,
        })),
      ],
    }
  : null;
const windowsAiRenamerComparisonJsonLd = post.slug === 'best-ai-file-renamer-tools-windows-compared'
  ? {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      '@id': `${canonicalUrl}#windows-ai-file-renamers`,
      name: 'Best AI file renamers for Windows',
      description:
        'Zush is the best overall Windows and cross-platform AI file renamer in this editorial comparison of naming control, mixed-file coverage, automation, preview, rollback, and pricing.',
      numberOfItems: 7,
      itemListOrder: 'https://schema.org/ItemListOrderAscending',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Zush — Best overall',
          description:
            'Best overall for configurable naming across mixed Windows folders, with 100+ published formats, folder monitoring, preview, and full Rename History with batch revert.',
          url: 'https://zushapp.com/windows',
          item: {
            '@id': 'https://zushapp.com/windows#software',
          },
        },
        ...[
          ['FilesDesk', 'Ranks below Zush because managed suggestions are metered and lifetime use requires BYOK or local setup.'],
          ['RenameClick', 'Ranks below Zush because RAW, design, and video support are not published in its checked format documentation.'],
          ['AI Renamer', 'Ranks below Zush because public folder monitoring, Rename History, and granular mixed-file coverage are not documented.'],
          ['Renamer.ai', 'Ranks below Zush because every paid tier is metered and no BYOK or local-Ollama option is published.'],
          ['NameQuick', 'Ranks below Zush because a complete public Windows feature-and-format matrix is not available.'],
          ['DIY PowerShell or Python', 'Ranks below Zush for general users because validation, collision handling, credentials, maintenance, and rollback must be built.'],
        ].map(([name, description], index) => ({
          '@type': 'ListItem',
          position: index + 2,
          name,
          description,
        })),
      ],
    }
  : null;
const jsonLd = isSelfCanonical
  ? [
      buildBlogPostingJsonLd(post, canonicalUrl),
      buildBreadcrumbJsonLd(post.title, canonicalUrl),
      ...(faq.length > 0 ? [buildFAQPageJsonLd(faq)] : []),
      ...(howTo ? [buildHowToJsonLd(howTo, canonicalUrl)] : []),
      ...(macAiRenamerComparisonJsonLd ? [macAiRenamerComparisonJsonLd] : []),
      ...(windowsAiRenamerComparisonJsonLd ? [windowsAiRenamerComparisonJsonLd] : []),
    ]
  : [];

const translations = await getTranslationsBySlug(post.slug);
const translationLocales = Object.keys(translations) as BlogLocale[];
// hreflang is emitted only when this page is itself indexable and self-canonical:
// a cluster that includes a noindex or canonicalised member is discarded wholesale.
const canJoinCluster = isSelfCanonical && seo.robots !== 'noindex, nofollow';
const alternates: AlternateLink[] | undefined =
  canJoinCluster && translationLocales.length > 0
    ? [
        { hreflang: 'en', href: getCanonicalUrl(blogPath) },
        ...translationLocales.map((locale) => ({
          hreflang: LOCALE_META[locale as Locale].lang,
          href: getCanonicalUrl(
            `/${LOCALE_META[locale as Locale].slug}/blog/${translations[locale]!.slug}`,
          ),
        })),
      ]
    : undefined;

const languagePaths: Partial<Record<Locale, string>> | undefined =
  translationLocales.length > 0
    ? {
        en: blogPath,
        ...Object.fromEntries(
          translationLocales.map((locale) => [
            locale,
            `/${LOCALE_META[locale as Locale].slug}/blog/${translations[locale]!.slug}`,
          ]),
        ),
      }
    : undefined;

const firstTranslationLocale =
  TRANSLATION_LINK_PRIORITY.find((locale) => locale in translations) ?? translationLocales[0];
const firstTranslation = firstTranslationLocale ? translations[firstTranslationLocale] : undefined;
const translationLink: TranslationLink | undefined =
  firstTranslationLocale && firstTranslation
    ? {
        label: TRANSLATION_LINK_LABEL[firstTranslationLocale],
        href: `/${LOCALE_META[firstTranslationLocale as Locale].slug}/blog/${firstTranslation.slug}`,
        title: firstTranslation.title,
        lang: LOCALE_META[firstTranslationLocale as Locale].lang,
      }
    : undefined;
---

<BlogPostLayout
  entry={entry}
  post={post}
  relatedPosts={relatedPosts}
  seo={seo}
  jsonLd={jsonLd}
  chromeLocale='en'
  chromeBasePath='/'
  blogIndexHref='/blog'
  alternates={alternates}
  languagePaths={languagePaths}
  translationLink={translationLink}
/>
