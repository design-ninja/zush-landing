---
import BaseLayout from '@/layouts/BaseLayout.astro';
import RealEstateLandingPage from '@/components/RealEstateLandingPage/RealEstateLandingPage.astro';
import {
  REAL_ESTATE_JSON_LD,
  REAL_ESTATE_PAGE_PATH,
  REAL_ESTATE_PAGE_TITLE,
} from '@/data/realEstateLanding';
import { getSeoForPath } from '@/seo/config';
import { getCopy } from '@/i18n/copy';
import { buildFeatureBreadcrumbJsonLd, buildWebPageJsonLd } from '@/utils/jsonLd';

const seo = getSeoForPath(REAL_ESTATE_PAGE_PATH);
const header = getCopy('en').header;
const pageJsonLd = buildWebPageJsonLd({
  pagePath: REAL_ESTATE_PAGE_PATH,
  title: REAL_ESTATE_PAGE_TITLE,
  description: seo.description,
});

const headerNav = [
  { href: '#fields', label: header.features },
  { href: '#privacy', label: header.security },
  { href: '#pricing', label: header.pricing },
  { href: '#faq', label: header.faq },
  { href: '/blog', label: header.blog },
];
---

<BaseLayout
  seo={seo}
  headerNav={headerNav}
  disableTopOffset
  jsonLd={[
    pageJsonLd,
    REAL_ESTATE_JSON_LD,
    buildFeatureBreadcrumbJsonLd(REAL_ESTATE_PAGE_TITLE, REAL_ESTATE_PAGE_PATH),
  ]}
>
  <RealEstateLandingPage />
</BaseLayout>
