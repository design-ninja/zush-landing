---
import BaseLayout from '@/layouts/BaseLayout.astro';
import MedicalLandingPage from '@/components/MedicalLandingPage/MedicalLandingPage.astro';
import { MEDICAL_JSON_LD, MEDICAL_PAGE_PATH, MEDICAL_PAGE_TITLE } from '@/data/medicalLanding';
import { getSeoForPath } from '@/seo/config';
import { getCopy } from '@/i18n/copy';
import { buildFeatureBreadcrumbJsonLd } from '@/utils/jsonLd';

const seo = getSeoForPath(MEDICAL_PAGE_PATH);
const header = getCopy('en').header;

// Nav points at this landing's own sections, so the links scroll in-page
// instead of jumping back to the homepage.
const headerNav = [
  { href: '#fields', label: header.features },
  { href: '#privacy', label: header.security },
  { href: '#pricing', label: header.pricing },
  { href: '#faq', label: header.faq },
  { href: '/blog', label: header.blog },
];
---

<BaseLayout
  seo={seo}
  headerNav={headerNav}
  disableTopOffset
  jsonLd={[MEDICAL_JSON_LD, buildFeatureBreadcrumbJsonLd(MEDICAL_PAGE_TITLE, MEDICAL_PAGE_PATH)]}
>
  <MedicalLandingPage />
</BaseLayout>
