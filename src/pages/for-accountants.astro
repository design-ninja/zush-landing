---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AccountantsLandingPage from '@/components/AccountantsLandingPage/AccountantsLandingPage.astro';
import {
  ACCOUNTANTS_JSON_LD,
  ACCOUNTANTS_PAGE_PATH,
  ACCOUNTANTS_PAGE_TITLE,
} from '@/data/accountantsLanding';
import { getSeoForPath } from '@/seo/config';
import { getCopy } from '@/i18n/copy';
import { buildFeatureBreadcrumbJsonLd } from '@/utils/jsonLd';

const seo = getSeoForPath(ACCOUNTANTS_PAGE_PATH);
const header = getCopy('en').header;
const headerNav = [
  { href: '#fields', label: header.features },
  { href: '#privacy', label: header.security },
  { href: '#pricing', label: header.pricing },
  { href: '#faq', label: header.faq },
  { href: '/blog', label: header.blog },
];
---

<BaseLayout
  seo={seo}
  headerNav={headerNav}
  disableTopOffset
  jsonLd={[
    ACCOUNTANTS_JSON_LD,
    buildFeatureBreadcrumbJsonLd(ACCOUNTANTS_PAGE_TITLE, ACCOUNTANTS_PAGE_PATH),
  ]}
>
  <AccountantsLandingPage />
</BaseLayout>
