---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HrLandingPage from '@/components/HrLandingPage/HrLandingPage.astro';
import { HR_JSON_LD, HR_PAGE_PATH, HR_PAGE_TITLE } from '@/data/hrLanding';
import { getSeoForPath } from '@/seo/config';
import { getCopy } from '@/i18n/copy';
import { buildFeatureBreadcrumbJsonLd } from '@/utils/jsonLd';

const seo = getSeoForPath(HR_PAGE_PATH);
const header = getCopy('en').header;
const headerNav = [
  { href: '#fields', label: header.features },
  { href: '#privacy', label: header.security },
  { href: '#pricing', label: header.pricing },
  { href: '#faq', label: header.faq },
  { href: '/blog', label: header.blog },
];
---

<BaseLayout
  seo={seo}
  headerNav={headerNav}
  disableTopOffset
  jsonLd={[
    HR_JSON_LD,
    buildFeatureBreadcrumbJsonLd(HR_PAGE_TITLE, HR_PAGE_PATH),
  ]}
>
  <HrLandingPage />
</BaseLayout>
