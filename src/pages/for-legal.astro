---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LegalLandingPage from '@/components/LegalLandingPage/LegalLandingPage.astro';
import { LEGAL_JSON_LD, LEGAL_PAGE_PATH } from '@/data/legalLanding';
import { getSeoForPath } from '@/seo/config';
import { buildFeatureBreadcrumbJsonLd, buildWebPageJsonLd } from '@/utils/jsonLd';

const seo = getSeoForPath(LEGAL_PAGE_PATH);
const pageJsonLd = buildWebPageJsonLd({
  pagePath: LEGAL_PAGE_PATH,
  title: 'Legal Document File Renamer for Law Firms',
  description: seo.description,
});
---

<BaseLayout
  seo={seo}
  headerWidth='container'
  disableTopOffset
  jsonLd={[
    pageJsonLd,
    LEGAL_JSON_LD,
    buildFeatureBreadcrumbJsonLd('Legal Document File Renamer', LEGAL_PAGE_PATH),
  ]}
>
  <LegalLandingPage />
</BaseLayout>
