---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LegalLandingPage from '@/components/LegalLandingPage/LegalLandingPage.astro';
import { LEGAL_JSON_LD, LEGAL_PAGE_PATH, LEGAL_PAGE_TITLE } from '@/data/legalLanding';
import { getSeoForPath } from '@/seo/config';
import { getCopy } from '@/i18n/copy';
import { buildFeatureBreadcrumbJsonLd } from '@/utils/jsonLd';

const seo = getSeoForPath(LEGAL_PAGE_PATH);
const header = getCopy('en').header;
const headerNav = [
  { href: '#fields', label: header.features },
  { href: '#privacy', label: header.security },
  { href: '#pricing', label: header.pricing },
  { href: '#faq', label: header.faq },
  { href: '/blog', label: header.blog },
];
---

<BaseLayout
  seo={seo}
  headerNav={headerNav}
  disableTopOffset
  jsonLd={[
    LEGAL_JSON_LD,
    buildFeatureBreadcrumbJsonLd(LEGAL_PAGE_TITLE, LEGAL_PAGE_PATH),
  ]}
>
  <LegalLandingPage />
</BaseLayout>
