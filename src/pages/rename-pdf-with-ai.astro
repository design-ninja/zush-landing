---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FeatureLandingPageShell from '@/components/FeatureLandingPage/FeatureLandingPageShell.astro';
import { getFeaturePageProps } from '@/utils/featurePageProps';
import RenamePDFWithAI from '@/views/FeaturePages/RenamePDFWithAI';
import { getSeoForPath } from '@/seo/config';
import { buildFeatureBreadcrumbJsonLd } from '@/utils/jsonLd';

const seo = getSeoForPath('/rename-pdf-with-ai');
const baseFeaturePage = getFeaturePageProps(RenamePDFWithAI);
const featurePage = {
  ...baseFeaturePage,
  relatedPages: [
    { title: 'AI File Renamer for Windows', href: '/windows' },
    ...(baseFeaturePage.relatedPages ?? []),
  ],
};
---

<BaseLayout seo={seo} headerWidth="container" jsonLd={[featurePage.jsonLd, buildFeatureBreadcrumbJsonLd(featurePage.h1, '/rename-pdf-with-ai')]}>
  <FeatureLandingPageShell {...featurePage} />
</BaseLayout>
