---
interface Pattern {
  label: string;
  useCase: string;
  value: string;
  example: string;
}

interface Props {
  patterns: Pattern[];
}

const { patterns } = Astro.props;
---

<div class='blog-copy-patterns'>
  {
    patterns.map((pattern) => (
      <article class='blog-copy-pattern'>
        <div class='blog-copy-pattern__head'>
          <div>
            <strong>{pattern.label}</strong>
            <span>{pattern.useCase}</span>
          </div>
          <button
            type='button'
            class='blog-copy-pattern__button'
            data-copy-pattern
            data-copy-label={pattern.label}
            data-copy-value={pattern.value}
            aria-label={`Copy ${pattern.label} naming pattern`}
          >
            Copy
          </button>
        </div>
        <code class='blog-copy-pattern__value'>{pattern.value}</code>
        <p class='blog-copy-pattern__example'>Example: <code>{pattern.example}</code></p>
      </article>
    ))
  }
</div>

<style is:global lang="scss">
  @use 'styles/variables' as *;
  @use 'styles/mixins' as *;

  .blog-copy-patterns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
    margin: 1.25rem 0 2rem;

    @include small {
      grid-template-columns: 1fr;
    }
  }

  .blog-copy-pattern {
    min-width: 0;
    padding: 1rem;
    @include surface-panel($radius-md);
  }

  .blog-copy-pattern__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.8rem;
  }

  .blog-copy-pattern__head div {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .blog-copy-pattern__head span,
  .blog-copy-pattern__example {
    color: var(--muted-foreground);
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .blog-copy-pattern__button {
    @include button-shape('sm');
    @include button-variant('outline');
    flex: 0 0 auto;

    &[data-copy-state='copied'] {
      color: var(--success);
    }
  }

  .blog-copy-pattern__value {
    display: block;
    overflow-x: auto;
    padding: 0.65rem 0.75rem;
    border-radius: 0.375rem;
    background: color-mix(in srgb, var(--foreground) 5%, transparent);
    white-space: nowrap;
  }

  .blog-copy-pattern__example {
    margin: 0.65rem 0 0;
  }
</style>
