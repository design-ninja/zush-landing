---
import { Image } from 'astro:assets';
import { BLOG_PLATFORM_LABELS } from '@/data/blogSchema';
import { formatBlogDate, type BlogPost } from '@/data/blog';
import { getBlogThumbnail } from '@/data/blogThumbnails';
import { getBlogPostCopy } from '@/i18n/blogPost';
import styles from './BlogPostCard.module.scss';

interface Props {
  post: BlogPost;
  /** Locale prefix of the surrounding page, e.g. '/' or '/de'. */
  basePath?: string;
}

const { post, basePath = '/' } = Astro.props;

const prefix = basePath === '/' ? '' : basePath.replace(/\/$/, '');
const href = `${prefix}/blog/${post.slug}`;
const copy = getBlogPostCopy(post.locale);
// Translations reuse their English source's thumbnail rather than duplicating
// the asset under a German slug.
const thumbnail = getBlogThumbnail(post.translationOf ?? post.slug);
---

<article class={styles.BlogPostCard}>
  <a class={styles.BlogPostCard__Link} href={href}>
    <Image
      alt={`${post.title} guide thumbnail`}
      class={styles.BlogPostCard__Image}
      decoding='async'
      densities={[1, 2]}
      height={126}
      loading='lazy'
      src={thumbnail}
      width={168}
    />
    <span class={styles.BlogPostCard__Body}>
      <span class={styles.BlogPostCard__Track}>
        {BLOG_PLATFORM_LABELS[post.platform]}
      </span>
      <h3 class={styles.BlogPostCard__Title}>{post.title}</h3>
      <span class={styles.BlogPostCard__Description}>{post.description}</span>
      <span class={styles.BlogPostCard__Meta}>
        <time datetime={post.date}>{formatBlogDate(post.dateValue, copy.dateLocale)}</time>
        <span aria-hidden='true'>·</span>
        <span>{copy.readingTime(post.readingTime)}</span>
      </span>
    </span>
  </a>
</article>
