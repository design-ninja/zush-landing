---
import { getImage } from 'astro:assets';
import ctaBackground from '@/assets/download-cta/try-zush-free-bg.webp';
import headingStyles from '@/components/Heading/Heading.module.scss';
import textStyles from '@/components/Text/Text.module.scss';
import downloadStyles from '@/components/DownloadButton/DownloadButton.module.scss';
import { WINDOWS_STORE_PROTOCOL_URL } from '@/constants';
import { getDownloadUrl, getOSLabel, getShortRequirements } from '@/utils/download';
import type { BlogPlatform } from '@/data/blogSchema';
import BlogOSIcon from '@/components/blog/BlogOSIcon.astro';
import styles from '@/components/BlogCTA/BlogCTA.module.scss';
import { PRO_PRICING_SUMMARY } from '@/constants/pricing';

type BlogCTAPlacement = 'early' | 'inline' | 'footer';

interface Props {
  placement?: BlogCTAPlacement;
  platform?: BlogPlatform;
  title?: string;
  description?: string;
}

const { placement = 'footer', platform = 'general', title, description } = Astro.props;

const placementTitles: Record<BlogCTAPlacement, (osLabel: string) => string> = {
  early: (os) => `Batch rename files with AI on ${os}`,
  inline: (os) => `Turn Zush into your automatic file renamer on ${os}`,
  footer: (os) => `Stop renaming files by hand — get Zush for ${os}`,
};

const placementDescriptions: Record<BlogCTAPlacement, string> = {
  early:
    'Zush renames screenshots, design files, PDFs, photos, audio, videos, documents, and downloads by content. 50 free renames, no signup.',
  inline:
    'Batch rename files, monitor folders, and keep documents, design files, screenshots, photos, audio, videos, and PDFs searchable with descriptive names and metadata.',
  footer:
    `AI batch renaming, automatic folder monitoring, and search-friendly names. 50 free renames to start — PRO from ${PRO_PRICING_SUMMARY}.`,
};

const titleClasses = [headingStyles.Heading, headingStyles.Heading_h3, styles.BlogCTA__Title].join(' ');
const descriptionClasses = [
  textStyles.Text,
  textStyles.Text_sm,
  textStyles.Text_subtle,
  styles.BlogCTA__Description,
].join(' ');
const hintClasses = [
  textStyles.Text,
  textStyles.Text_xs,
  textStyles.Text_subtle,
  styles.BlogCTA__Hint,
].join(' ');
// Rendered as a plain <img> rather than the Image component, which emits a
// bare `alt` that crawlers read as missing. The alt is non-empty for the same
// reason — Bing's Site Scan counts alt="" as undefined — while aria-hidden
// keeps this purely decorative background out of the accessibility tree.
const background = await getImage({
  src: ctaBackground,
  width: 1600,
  height: 914,
  format: 'webp',
  quality: 78,
});
---

{
  platform === 'general' ? (
    <aside
      class={styles.BlogCTA}
      data-blog-cta-os='mac'
      data-blog-cta-platform='general'
      data-placement={placement}
    >
      <img
        src={background.src}
        width='1600'
        height='914'
        alt='Decorative background'
        class={styles.BlogCTA__Background}
        loading='lazy'
        decoding='async'
        aria-hidden='true'
      />
      <div class={styles.BlogCTA__Content}>
        <h3
          class={titleClasses}
          data-blog-cta-title
          data-title-mac={title ?? placementTitles[placement]('Mac')}
          data-title-windows={title ?? placementTitles[placement]('Windows')}
        >
          {title ?? placementTitles[placement]('Mac')}
        </h3>
        <p class={descriptionClasses}>{description ?? placementDescriptions[placement]}</p>
        <div class={styles.BlogCTA__Buttons}>
          <div
            class={[
              downloadStyles.Group,
              downloadStyles.Group_black,
              downloadStyles.Group_md,
              downloadStyles.Group_single,
            ].join(' ')}
          >
            <a
              class={[downloadStyles.Main, downloadStyles.Main_single].join(' ')}
              data-blog-cta-link
              data-href-mac={getDownloadUrl('mac')}
              data-href-windows={getDownloadUrl('windows')}
              data-store-app-url-windows={WINDOWS_STORE_PROTOCOL_URL}
              data-download-os='mac'
              data-download-source={`blog-cta-${placement}`}
              data-download-channel='direct'
              data-article-cta
              data-article-cta-label='Download'
              data-article-cta-placement={`download-${placement}`}
              href={getDownloadUrl('mac')}
            >
              <span class={styles.BlogCTA__ButtonIcon} data-blog-cta-icon='mac'>
                <BlogOSIcon os='mac' />
              </span>
              <span class={styles.BlogCTA__ButtonIcon} data-blog-cta-icon='windows' hidden>
                <BlogOSIcon os='windows' />
              </span>
              <span data-blog-cta-label>Download</span>
            </a>
          </div>
        </div>
        <p
          class={hintClasses}
          data-blog-cta-hint
          data-hint-mac={`Free · 50 AI renames · ${getShortRequirements('mac')} · No signup`}
          data-hint-windows={`Free · 50 AI renames · ${getShortRequirements('windows')} · No signup`}
        >
          {`Free · 50 AI renames · ${getShortRequirements('mac')} · No signup`}
        </p>
      </div>
    </aside>
  ) : (
    <aside class={styles.BlogCTA} data-placement={placement}>
      <img
        src={background.src}
        width='1600'
        height='914'
        alt='Decorative background'
        class={styles.BlogCTA__Background}
        loading='lazy'
        decoding='async'
        aria-hidden='true'
      />
      <div class={styles.BlogCTA__Content}>
        <h3 class={titleClasses}>
          {title ?? placementTitles[placement](getOSLabel(platform === 'windows' ? 'windows' : 'mac'))}
        </h3>
        <p class={descriptionClasses}>{description ?? placementDescriptions[placement]}</p>
        <div class={styles.BlogCTA__Buttons}>
          <div
            class={[
              downloadStyles.Group,
              downloadStyles.Group_black,
              downloadStyles.Group_md,
              downloadStyles.Group_single,
            ].join(' ')}
          >
            <a
              class={[downloadStyles.Main, downloadStyles.Main_single].join(' ')}
              href={getDownloadUrl(platform === 'windows' ? 'windows' : 'mac')}
              data-store-os={platform === 'windows' ? 'windows' : undefined}
              data-store-app-url={platform === 'windows' ? WINDOWS_STORE_PROTOCOL_URL : undefined}
              data-download-os={platform === 'windows' ? 'windows' : 'mac'}
              data-download-source={`blog-cta-${placement}`}
              data-download-channel={platform === 'windows' ? 'microsoft-store' : 'direct'}
              data-article-cta
              data-article-cta-label='Download'
              data-article-cta-placement={`download-${placement}`}
              rel={platform === 'windows' ? 'noopener noreferrer' : undefined}
              target={platform === 'windows' ? '_blank' : undefined}
            >
              <BlogOSIcon os={platform === 'windows' ? 'windows' : 'mac'} />
              <span>Download</span>
            </a>
          </div>
        </div>
        <p class={hintClasses}>
          {`Free · 50 AI renames · ${getShortRequirements(
            platform === 'windows' ? 'windows' : 'mac',
          )} · No signup`}
        </p>
      </div>
    </aside>
  )
}

<script>
  import { bindStoreLink, bindStoreLinks } from '@/utils/storeLinks';

  (() => {
      const detectDownloadOS = () => {
        try {
          const preferred = window.localStorage.getItem('zush-preferred-os');
          if (preferred === 'mac' || preferred === 'windows') return preferred;
        } catch {}

        const uaData = (navigator as Navigator & {
          userAgentData?: { platform?: string };
        }).userAgentData;
        if (uaData?.platform) {
          const platform = uaData.platform.toLowerCase();
          if (platform.includes('win')) return 'windows';
          if (platform.includes('mac')) return 'mac';
        }

        const ua = navigator.userAgent || '';
        if (/Windows/i.test(ua)) return 'windows';
        return 'mac';
      };

      const os = detectDownloadOS();

      document
        .querySelectorAll('[data-blog-cta-platform=\"general\"]')
        .forEach((root) => {
          root.setAttribute('data-blog-cta-os', os);

          const title = root.querySelector('[data-blog-cta-title]');
          if (title instanceof HTMLElement) {
            title.textContent =
              os === 'windows'
                ? title.dataset.titleWindows || title.textContent
                : title.dataset.titleMac || title.textContent;
          }

          const link = root.querySelector('[data-blog-cta-link]');
          if (link instanceof HTMLAnchorElement) {
            link.href =
              os === 'windows'
                ? link.dataset.hrefWindows || link.href
                : link.dataset.hrefMac || link.href;

            if (os === 'windows' && link.dataset.storeAppUrlWindows) {
              link.dataset.storeOs = 'windows';
              link.dataset.storeAppUrl = link.dataset.storeAppUrlWindows;
              link.dataset.downloadOs = 'windows';
              link.dataset.downloadChannel = 'microsoft-store';
              link.target = '_blank';
              link.rel = 'noopener noreferrer';
              bindStoreLink(link);
            } else {
              delete link.dataset.storeOs;
              delete link.dataset.storeAppUrl;
              link.dataset.downloadOs = 'mac';
              link.dataset.downloadChannel = 'direct';
              link.removeAttribute('target');
              link.removeAttribute('rel');
            }
          }

          const hint = root.querySelector('[data-blog-cta-hint]');
          if (hint instanceof HTMLElement) {
            hint.textContent =
              os === 'windows'
                ? hint.dataset.hintWindows || hint.textContent
                : hint.dataset.hintMac || hint.textContent;
          }

          const macIcon = root.querySelector('[data-blog-cta-icon=\"mac\"]');
          const windowsIcon = root.querySelector('[data-blog-cta-icon=\"windows\"]');

          if (macIcon instanceof HTMLElement) {
            macIcon.hidden = os === 'windows';
          }

          if (windowsIcon instanceof HTMLElement) {
            windowsIcon.hidden = os !== 'windows';
          }
        });

      bindStoreLinks();

  })();
</script>
