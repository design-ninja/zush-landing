---
import styles from '@/components/Breadcrumbs/Breadcrumbs.module.scss';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<style lang="scss">
  @use '../../styles/variables' as *;

  // The shared Breadcrumbs stylesheet uses the marketing container (80rem). Blog
  // pages are narrower, and the trail has to start on the same line as the post
  // body and the header pill above it.
  .blog-breadcrumbs {
    max-width: $blog-container-max-width;
  }
</style>

<nav aria-label='Breadcrumb' class:list={[styles.Breadcrumbs, 'blog-breadcrumbs']}>
  <ol class={styles.Breadcrumbs__List}>
    {
      items.map((item, index) => {
        const isLast = index === items.length - 1;

        return (
          <li class={styles.Breadcrumbs__Item}>
            {!isLast && item.href ? (
              <a class={styles.Breadcrumbs__Link} href={item.href}>
                {item.label}
              </a>
            ) : (
              <span
                aria-current={isLast ? 'page' : undefined}
                class={styles.Breadcrumbs__Current}
              >
                {item.label}
              </span>
            )}
            {!isLast && (
              <span aria-hidden='true' class={styles.Breadcrumbs__Separator}>
                /
              </span>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
