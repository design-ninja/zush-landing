---
import { Image } from 'astro:assets';
import { BLOG_PLATFORM_LABELS } from '@/data/blogSchema';
import { formatBlogDate, type BlogPost } from '@/data/blog';
import { getBlogThumbnail } from '@/data/blogThumbnails';
import { getBlogPostCopy } from '@/i18n/blogPost';
import styles from './BlogHighlightCard.module.scss';

interface Props {
  post: BlogPost;
  /** Locale prefix of the surrounding page, e.g. '/' or '/de'. */
  basePath?: string;
}

const { post, basePath = '/' } = Astro.props;

const prefix = basePath === '/' ? '' : basePath.replace(/\/$/, '');
const href = `${prefix}/blog/${post.slug}`;
const copy = getBlogPostCopy(post.locale);
// Translations reuse their English source's thumbnail rather than duplicating
// the asset under a German slug.
const thumbnailSlug = post.translationOf ?? post.slug;
---

<article class={styles.BlogHighlightCard}>
  <a class={styles.BlogHighlightCard__Link} href={href}>
    <Image
      alt={post.title}
      class={styles.BlogHighlightCard__Image}
      decoding="async"
      loading="lazy"
      src={getBlogThumbnail(thumbnailSlug)}
      width={88}
      height={88}
      densities={[1, 2]}
    />
    <span class={styles.BlogHighlightCard__Body}>
      <span
        class:list={[
          styles.BlogHighlightCard__Track,
          styles[`BlogHighlightCard__Track_${post.platform}`],
        ]}
      >
        {BLOG_PLATFORM_LABELS[post.platform]}
      </span>
      <h3 class={styles.BlogHighlightCard__Title}>{post.title}</h3>
      <span class={styles.BlogHighlightCard__Meta}>
        <time datetime={post.date}>{formatBlogDate(post.dateValue, copy.dateLocale)}</time>
        <span aria-hidden="true">·</span>
        <span>{copy.readingTime(post.readingTime)}</span>
      </span>
    </span>
  </a>
</article>
