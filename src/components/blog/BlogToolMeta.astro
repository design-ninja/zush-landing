---
interface Props {
  platform?: string;
  website?: string;
  label?: string;
}

const { platform, website, label } = Astro.props;

const websiteIsExternal = !!website && !website.startsWith('https://zushapp.com') && !website.startsWith('/');
const linkLabel =
  label ??
  (website ? website.replace(/^https?:\/\/(www\.)?/, '').replace(/\/+$/, '') : '');
---

<dl class='blog-tool-meta'>
  <div class='blog-tool-meta__row'>
    <dt>Platform</dt>
    <dd>
      <slot name='platform'>{platform}</slot>
    </dd>
  </div>
  <div class='blog-tool-meta__row'>
    <dt>Pricing</dt>
    <dd>
      <slot name='pricing' />
    </dd>
  </div>
  {
    website && (
      <div class='blog-tool-meta__row'>
        <dt>Website</dt>
        <dd>
          <a
            class='blog-tool-meta__link'
            href={website}
            rel={websiteIsExternal ? 'nofollow noopener noreferrer' : undefined}
            target={websiteIsExternal ? '_blank' : undefined}
          >
            {linkLabel}
          </a>
        </dd>
      </div>
    )
  }
</dl>

<style is:global lang="scss">
  @use 'styles/variables' as *;
  @use 'styles/mixins' as *;

  // Tool facts in comparison posts: neutral callout with label/value rows.
  .blog-tool-meta {
    @include callout;
    margin: 0.5rem 0 1.5rem;
    display: grid;
    gap: 0.4rem;
  }

  .blog-tool-meta__row {
    display: grid;
    grid-template-columns: 6.25rem 1fr;
    gap: 0.6rem;
    align-items: baseline;

    @include small {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }

  .blog-tool-meta dt {
    color: var(--text-faint);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .blog-tool-meta dd {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    min-width: 0;
    color: var(--foreground);
  }

  .blog-tool-meta__link {
    @include text-link;
  }
</style>
