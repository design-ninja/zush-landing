---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import { Calendar, Glasses, Languages } from 'lucide-react';
import BaseLayout, { type AlternateLink } from '@/layouts/BaseLayout.astro';
import BlogBreadcrumbs from '@/components/blog/BlogBreadcrumbs.astro';
import BlogCTA from '@/components/blog/BlogCTA.astro';
import BlogMarkdownH2 from '@/components/blog/BlogMarkdownH2.astro';
import BlogMarkdownH3 from '@/components/blog/BlogMarkdownH3.astro';
import BlogMarkdownH4 from '@/components/blog/BlogMarkdownH4.astro';
import BlogMarkdownImage from '@/components/blog/BlogMarkdownImage.astro';
import BlogMarkdownLink from '@/components/blog/BlogMarkdownLink.astro';
import BlogMarkdownParagraph from '@/components/blog/BlogMarkdownParagraph.astro';
import BlogMarkdownTable from '@/components/blog/BlogMarkdownTable.astro';
import BlogHighlightCard from '@/components/blog/BlogHighlightCard.astro';
import { formatBlogDate, normalizeTagSlug, type BlogEntry, type BlogPost } from '@/data/blog';
import { getBlogPublicTagSlug } from '@/data/blogTaxonomy';
import { BLOG_PLATFORM_LABELS } from '@/data/blogSchema';
import { getBlogPostCopy } from '@/i18n/blogPost';
import type { SeoMeta } from '@/seo/config';
import type { Locale } from '@/i18n/config';
import headingStyles from '@/components/Heading/Heading.module.scss';
import textStyles from '@/components/Text/Text.module.scss';
import styles from '@/views/Blog/BlogPost.module.scss';
import '@/styles/markdown-content.scss';

interface TocItem {
  depth: number;
  slug: string;
  text: string;
}

export interface TranslationLink {
  label: string;
  href: string;
  title: string;
  lang: string;
}

interface Props {
  entry: BlogEntry;
  post: BlogPost;
  relatedPosts: BlogPost[];
  seo: SeoMeta;
  jsonLd: object[];
  /** Locale for the surrounding chrome (nav, footer, html lang). */
  chromeLocale: Locale;
  chromeBasePath?: string;
  /** Omitted for locales that have no blog index — the Blog crumb is then dropped. */
  blogIndexHref?: string;
  alternates?: AlternateLink[];
  translationLink?: TranslationLink;
}

const {
  entry,
  post,
  relatedPosts,
  seo,
  jsonLd,
  chromeLocale,
  chromeBasePath = '/',
  blogIndexHref,
  alternates,
  translationLink,
} = Astro.props;

const copy = getBlogPostCopy(post.locale);
const isDefaultLocale = post.locale === 'en';
const { Content, headings } = await render(entry);
const toc = headings.filter(
  (item: TocItem) => item.depth === 2 || item.depth === 3,
);
const showToc = toc.filter((item: TocItem) => item.depth === 2).length >= 4;

const mdxComponents = {
  a: BlogMarkdownLink,
  h2: BlogMarkdownH2,
  h3: BlogMarkdownH3,
  h4: BlogMarkdownH4,
  img: BlogMarkdownImage,
  p: BlogMarkdownParagraph,
  table: BlogMarkdownTable,
};

const breadcrumbItems = [
  { label: copy.breadcrumbHome, href: chromeBasePath },
  ...(blogIndexHref ? [{ label: copy.breadcrumbBlog, href: blogIndexHref }] : []),
  { label: post.title },
];
---

<BaseLayout
  jsonLd={jsonLd}
  seo={seo}
  locale={chromeLocale}
  chromeBasePath={chromeBasePath}
  alternates={alternates}
  headerWidth='wide'
>
  <BlogBreadcrumbs items={breadcrumbItems} />

  <article class={styles.BlogPost}>
    <div class={styles.BlogPost__Container}>
      <header class={styles.BlogPost__Header}>
        <span
          class={[styles.BlogPost__Track, styles[`BlogPost__Track_${post.platform}`]].join(' ')}
        >
          {BLOG_PLATFORM_LABELS[post.platform]}
        </span>
        <h1 class={[headingStyles.Heading, headingStyles.Heading_h1, styles.BlogPost__Title].join(' ')}>
          {post.title}
        </h1>
        <div class={styles.BlogPost__Author}>
          <Image
            alt='Kirill Isachenko'
            class={styles.BlogPost__AuthorAvatar}
            decoding='async'
            height={40}
            loading='lazy'
            src='/images/authors/lirik-ava-fancy.webp'
            width={40}
          />
          <div>
            <a class={styles.BlogPost__AuthorName} href='/authors/kirill-isachenko'>Kirill Isachenko</a>
            <div class={styles.BlogPost__Meta}>
              <span class={styles.BlogPost__MetaItem}>
                <Calendar aria-hidden='true' size={15} strokeWidth={2} />
                <time datetime={post.date}>{formatBlogDate(post.dateValue, copy.dateLocale)}</time>
              </span>
              {post.reviewedAt !== post.date && (
                <span class={styles.BlogPost__MetaItem}>
                  <Calendar aria-hidden='true' size={15} strokeWidth={2} />
                  <span>
                    {copy.reviewedPrefix}{' '}
                    <time datetime={post.reviewedAt}>
                      {formatBlogDate(post.reviewedDateValue, copy.dateLocale)}
                    </time>
                  </span>
                </span>
              )}
              <span class={styles.BlogPost__MetaItem}>
                <Glasses aria-hidden='true' size={15} strokeWidth={2} />
                <span>{copy.readingTime(post.readingTime)}</span>
              </span>
            </div>
          </div>
        </div>
        {/* Tags are an English-only taxonomy and translated posts do not appear in
            tag listings, so the chips are rendered on English posts only. */}
        {isDefaultLocale && post.tags.length > 0 && (
          <div class={styles.BlogPost__Tags}>
            {post.tags.map((tag) => (
              <a
                class={styles.BlogPost__Tag}
                href={`/blog/tags/${getBlogPublicTagSlug(tag) ?? normalizeTagSlug(tag)}`}
              >
                {tag}
              </a>
            ))}
          </div>
        )}
      </header>

      {translationLink && (
        <p class='blog-post-translation'>
          <Languages aria-hidden='true' size={15} strokeWidth={2} />
          <span>
            {translationLink.label}:{' '}
            <a href={translationLink.href} hreflang={translationLink.lang} lang={translationLink.lang}>
              {translationLink.title}
            </a>
          </span>
        </p>
      )}

      {post.tldr && (
        <div class={styles.BlogPost__Tldr}>
          <strong>{copy.tldrLabel}</strong> {post.tldr}
        </div>
      )}

      {showToc && (
        <details class={styles.BlogPost__MobileToc}>
          <summary class={styles.BlogPost__MobileTocSummary}>{copy.jumpToSection}</summary>
          <nav aria-label={copy.jumpToSection} class={styles.BlogPost__MobileTocLinks}>
            {toc
              .filter((item: TocItem) => item.depth === 2)
              .map((item: TocItem) => (
                <a class={styles.BlogPost__MobileTocLink} href={`#${item.slug}`}>
                  {item.text}
                </a>
              ))}
          </nav>
        </details>
      )}

      <div class={styles.BlogPost__Layout}>
        {showToc && (
          <aside aria-label={copy.onThisPage} class={styles.BlogPost__Toc}>
            <div class={styles.BlogPost__TocInner}>
              <p
                class={[
                  textStyles.Text,
                  textStyles.Text_xs,
                  textStyles.Text_base,
                  styles.BlogPost__TocTitle,
                ].join(' ')}
              >
                {copy.onThisPage}
              </p>
              <nav class={styles.BlogPost__TocNav}>
                {toc.map((item: TocItem) => (
                  <a
                    class={[
                      styles.BlogPost__TocLink,
                      item.depth === 3 ? styles.BlogPost__TocLink_subtle : '',
                    ].join(' ')}
                    href={`#${item.slug}`}
                  >
                    {item.text}
                  </a>
                ))}
              </nav>
            </div>
          </aside>
        )}

        <div class={`${styles.BlogPost__Content} markdown-content`}>
          <Content components={mdxComponents} />
        </div>
      </div>

      <BlogCTA placement='footer' platform={post.platform} />

      {relatedPosts.length > 0 && (
        <section class={styles.BlogPost__Related}>
          <h2
            class={[headingStyles.Heading, headingStyles.Heading_h3, styles.BlogPost__RelatedTitle].join(
              ' ',
            )}
          >
            {copy.relatedArticles}
          </h2>
          <div class={styles.BlogPost__RelatedGrid}>
            {relatedPosts.map((relatedPost) => (
              <BlogHighlightCard post={relatedPost} basePath={chromeBasePath} />
            ))}
          </div>
        </section>
      )}

    </div>
  </article>

  <script>
    import { bindStoreLink, bindStoreLinks } from '@/utils/storeLinks';

    (() => {
      const detectDownloadOS = () => {
        try {
          const preferred = window.localStorage.getItem('zush-preferred-os');
          if (preferred === 'mac' || preferred === 'windows') return preferred;
        } catch {}

        const uaData = (navigator as Navigator & {
          userAgentData?: { platform?: string };
        }).userAgentData;
        if (uaData?.platform) {
          const platform = uaData.platform.toLowerCase();
          if (platform.includes('win')) return 'windows';
          if (platform.includes('mac')) return 'mac';
        }

        const ua = navigator.userAgent || '';
        if (/Windows/i.test(ua)) return 'windows';
        return 'mac';
      };

      const os = detectDownloadOS();

      document
        .querySelectorAll('[data-blog-cta-platform=\"general\"]')
        .forEach((root) => {
          root.setAttribute('data-blog-cta-os', os);

          const title = root.querySelector('[data-blog-cta-title]');
          if (title instanceof HTMLElement) {
            title.textContent =
              os === 'windows'
                ? title.dataset.titleWindows || title.textContent
                : title.dataset.titleMac || title.textContent;
          }

          const link = root.querySelector('[data-blog-cta-link]');
          if (link instanceof HTMLAnchorElement) {
            link.href =
              os === 'windows'
                ? link.dataset.hrefWindows || link.href
                : link.dataset.hrefMac || link.href;

            if (os === 'windows' && link.dataset.storeAppUrlWindows) {
              link.dataset.storeOs = 'windows';
              link.dataset.storeAppUrl = link.dataset.storeAppUrlWindows;
              link.dataset.downloadOs = 'windows';
              link.dataset.downloadChannel = 'microsoft-store';
              bindStoreLink(link);
            } else {
              delete link.dataset.storeOs;
              delete link.dataset.storeAppUrl;
              link.dataset.downloadOs = 'mac';
              link.dataset.downloadChannel = 'direct';
            }
          }

          const hint = root.querySelector('[data-blog-cta-hint]');
          if (hint instanceof HTMLElement) {
            hint.textContent =
              os === 'windows'
                ? hint.dataset.hintWindows || hint.textContent
                : hint.dataset.hintMac || hint.textContent;
          }

          const macIcon = root.querySelector('[data-blog-cta-icon=\"mac\"]');
          const windowsIcon = root.querySelector('[data-blog-cta-icon=\"windows\"]');

          if (macIcon instanceof HTMLElement) {
            macIcon.hidden = os === 'windows';
          }

          if (windowsIcon instanceof HTMLElement) {
            windowsIcon.hidden = os !== 'windows';
          }
        });

      bindStoreLinks();
    })();
  </script>
</BaseLayout>

<style>
  .blog-post-translation {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 1.25rem;
    font-size: 0.875rem;
    color: var(--text-subtle, #666);
  }

  .blog-post-translation a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
