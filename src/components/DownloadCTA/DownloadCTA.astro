---
import { getImage } from 'astro:assets';
import ctaBackground from '@/assets/download-cta/try-zush-free-bg.webp';
import DownloadButton from '@/components/DownloadButton/DownloadButton';
import Heading from '@/components/Heading';
import Text from '@/components/Text';
import { getShortRequirements, type DownloadOS } from '@/utils/download';
import type { DownloadMenuCopy } from '@/i18n/copy';
import styles from './DownloadCTA.module.scss';

interface Props {
  title?: string;
  subtitle?: string;
  className?: string;
  forceOS?: DownloadOS;
  hintPrefix?: string;
  downloadLabel?: string;
  downloadMenu?: DownloadMenuCopy;
  includeOtherDownloadOS?: boolean;
}

const {
  title,
  subtitle = 'Batch rename files, monitor folders, and rename screenshots, design files, PDFs, photos, audio, videos, iWork, and Office documents by content.',
  className,
  forceOS,
  hintPrefix = 'Free · No credit card required',
  downloadLabel,
  downloadMenu,
  includeOtherDownloadOS = true,
} = Astro.props as Props;

const resolvedTitle = title ?? 'Try Zush free';
// Without a forced OS the CTA offers both platforms, so the hint has to name
// both requirements rather than speak for macOS alone.
const requirements = forceOS
  ? getShortRequirements(forceOS)
  : `${getShortRequirements('mac')} · ${getShortRequirements('windows')}`;
// Rendered as a plain <img> rather than the Image component, which emits a
// bare `alt` that crawlers read as missing. The alt is non-empty for the same
// reason — Bing's Site Scan counts alt="" as undefined — while aria-hidden
// keeps this purely decorative background out of the accessibility tree.
const background = await getImage({
  src: ctaBackground,
  width: 1600,
  height: 914,
  format: 'webp',
  quality: 78,
});
---

<section class:list={[styles.Section, className]}>
  <div class={styles.Container}>
    <div class={styles.Card}>
      <img
        src={background.src}
        width="1600"
        height="914"
        alt="Decorative background"
        class={styles.Background}
        loading="lazy"
        decoding="async"
        aria-hidden="true"
      />
      <div class={styles.Content}>
        <Heading as="h2" className={styles.Title}>{resolvedTitle}</Heading>
        <Text as="p" className={styles.Subtitle} color="subtle">{subtitle}</Text>
        <div class={styles.Buttons}>
          {forceOS ? (
            <DownloadButton
              client:visible
              source="download-cta"
              size="lg"
              forceOS={forceOS}
              showDropdown={false}
              label={downloadLabel}
              menuCopy={downloadMenu}
              includeOtherOS={includeOtherDownloadOS}
            />
          ) : (
            <Fragment>
              <DownloadButton
                client:visible
                source="download-cta"
                size="lg"
                forceOS="mac"
                showDropdown={false}
                label={downloadMenu?.downloadForMac ?? 'Download for Mac'}
              />
              <DownloadButton
                client:visible
                source="download-cta"
                size="lg"
                forceOS="windows"
                showDropdown={false}
                label={downloadMenu?.downloadForWindows ?? 'Download for Windows'}
              />
            </Fragment>
          )}
        </div>
        <Text as="p" size="xs" color="subtle" className={styles.Hint}>
          {hintPrefix} · {requirements}
        </Text>
      </div>
    </div>
  </div>
</section>
