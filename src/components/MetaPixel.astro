---
interface Props { pixelId: string; }
const { pixelId } = Astro.props;
---

<span data-zush-meta-pixel-id={pixelId} hidden></span>

<script>
  import { configureMetaTracking } from '@/utils/metaTracking';

  const configuredPixelId = document
    .querySelector<HTMLElement>('[data-zush-meta-pixel-id]')
    ?.dataset.zushMetaPixelId;
  if (configuredPixelId) configureMetaTracking(configuredPixelId);
</script>
