---
import {
  Blocks,
  Eye,
  Files,
  Gift,
  Languages,
  Settings2,
  ShieldCheck,
  Undo2,
} from 'lucide-react';
import {
  APP_CONFIG,
  APP_STORE_URL,
  CRUNCHBASE_URL,
  LINKEDIN_COMPANY_URL,
  PRODUCT_HUNT_URL,
  SUPPORTED_FORMAT_COUNT,
  WINDOWS_STORE_URL,
} from '@/constants';
import Heading from '@/components/Heading';
import PillLink from '@/components/PillLink';
import Text from '@/components/Text';
import sectionHeaderStyles from '@/components/SectionHeader/SectionHeader.module.scss';
import {
  DEFAULT_LOCALE,
  getLocalesForRoute,
  getLocalizedPath,
  isLocalizedRoute,
  type Locale,
} from '@/i18n/config';
import { getEvidenceSignalsCopy } from '@/i18n/evidenceSignals';
import styles from './EvidenceSignals.module.scss';

interface Props {
  locale?: Locale;
  variant?: 'all' | 'intro' | 'facts' | 'control' | 'sources';
  showControlHeading?: boolean;
}

const { locale = DEFAULT_LOCALE, variant = 'all', showControlHeading = false } = Astro.props as Props;
const copy = getEvidenceSignalsCopy(locale);
const titleParts = copy.title.split('Zush');
const description = copy.description.replace('{count}', String(SUPPORTED_FORMAT_COUNT));

const localizedHref = (route: string): string =>
  isLocalizedRoute(route) && getLocalesForRoute(route).includes(locale)
    ? getLocalizedPath(route, locale)
    : route;

const facts = [
  {
    icon: Gift,
    title: copy.freeTitle,
    description: copy.freeDescription.replace('{limit}', String(APP_CONFIG.free_tier_limit)),
    color: 'green',
  },
  {
    icon: Blocks,
    title: copy.blocksTitle,
    description: copy.blocksDescription,
    color: 'blue',
  },
  {
    icon: Languages,
    title: copy.languagesTitle,
    description: copy.languagesDescription,
    color: 'purple',
  },
  {
    icon: Files,
    title: copy.formatsTitle.replace('{count}', String(SUPPORTED_FORMAT_COUNT)),
    description: copy.formatsDescription,
    color: 'orange',
  },
];

const CONTROL_COPY: Record<Locale, Array<{ title: string; description: string }>> = {
  en: [
    { title: 'Preview every change', description: 'See the proposed filename before anything is renamed.' },
    { title: 'Build names your way', description: 'Choose the fields, their order, separators, language, and date format.' },
    { title: 'Undo any batch', description: 'Restore the original filenames with one click.' },
    { title: 'Choose where AI runs', description: 'Use Zush Cloud, your own AI provider, or supported local models.' },
  ],
  de: [
    { title: 'Jede Änderung prüfen', description: 'Sieh den vorgeschlagenen Dateinamen, bevor etwas umbenannt wird.' },
    { title: 'Namen nach deinen Regeln', description: 'Wähle Felder, Reihenfolge, Trennzeichen, Sprache und Datumsformat.' },
    { title: 'Jeden Stapel rückgängig', description: 'Stelle die ursprünglichen Dateinamen mit einem Klick wieder her.' },
    { title: 'Bestimme, wo die KI läuft', description: 'Nutze Zush Cloud, deinen eigenen KI-Anbieter oder unterstützte lokale Modelle.' },
  ],
  fr: [
    { title: 'Prévisualisez chaque changement', description: 'Voyez le nom proposé avant qu’un fichier soit renommé.' },
    { title: 'Créez vos propres noms', description: 'Choisissez les champs, leur ordre, les séparateurs, la langue et le format de date.' },
    { title: 'Annulez chaque lot', description: 'Restaurez les noms d’origine en un clic.' },
    { title: 'Choisissez où tourne l’IA', description: 'Utilisez Zush Cloud, votre fournisseur d’IA ou des modèles locaux compatibles.' },
  ],
  'pt-br': [
    { title: 'Prévia de cada alteração', description: 'Veja o nome sugerido antes de qualquer arquivo ser renomeado.' },
    { title: 'Nomes do seu jeito', description: 'Escolha campos, ordem, separadores, idioma e formato de data.' },
    { title: 'Desfaça qualquer lote', description: 'Restaure os nomes originais com um clique.' },
    { title: 'Escolha onde a IA roda', description: 'Use Zush Cloud, seu provedor de IA ou modelos locais compatíveis.' },
  ],
