    { title: 'Previsualiza cada cambio', description: 'Ve el nombre propuesto antes de renombrar ningún archivo.' },
    { title: 'Crea nombres a tu manera', description: 'Elige los campos, el orden, los separadores, el idioma y el formato de fecha.' },
    { title: 'Deshaz cualquier lote', description: 'Restaura los nombres originales con un clic.' },
    { title: 'Elige dónde se ejecuta la IA', description: 'Usa Zush Cloud, tu proveedor de IA o modelos locales compatibles.' },
  ],
