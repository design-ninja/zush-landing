    { title: 'Bekijk elke wijziging', description: 'Zie de voorgestelde bestandsnaam voordat iets wordt hernoemd.' },
    { title: 'Bouw namen op jouw manier', description: 'Kies velden, volgorde, scheidingstekens, taal en datumnotatie.' },
    { title: 'Maak elke batch ongedaan', description: 'Herstel de oorspronkelijke bestandsnamen met één klik.' },
    { title: 'Kies waar AI draait', description: 'Gebruik Zush Cloud, je eigen AI-provider of ondersteunde lokale modellen.' },
  ],
  it: [
    { title: 'Anteprima di ogni modifica', description: 'Visualizza il nome proposto prima di rinominare qualsiasi file.' },
    { title: 'Crea nomi a modo tuo', description: 'Scegli campi, ordine, separatori, lingua e formato data.' },
    { title: 'Annulla qualsiasi batch', description: 'Ripristina i nomi originali con un clic.' },
    { title: 'Scegli dove gira l’IA', description: 'Usa Zush Cloud, il tuo provider IA o modelli locali supportati.' },
  ],
  ja: [
    { title: 'すべての変更をプレビュー', description: 'ファイル名を変更する前に候補を確認できます。' },
    { title: '自分のルールで命名', description: '項目、順序、区切り文字、言語、日付形式を選べます。' },
    { title: 'バッチを元に戻す', description: 'ワンクリックで元のファイル名に復元できます。' },
    { title: 'AI の実行場所を選択', description: 'Zush Cloud、自分の AI プロバイダー、対応ローカルモデルから選べます。' },
  ],
  ko: [
    { title: '모든 변경 사항 미리보기', description: '파일 이름을 바꾸기 전에 제안된 이름을 확인하세요.' },
    { title: '내 방식대로 이름 만들기', description: '필드, 순서, 구분자, 언어와 날짜 형식을 선택하세요.' },
    { title: '모든 일괄 작업 되돌리기', description: '한 번의 클릭으로 원래 파일 이름을 복원하세요.' },
    { title: 'AI 실행 위치 선택', description: 'Zush Cloud, 내 AI 제공업체 또는 지원되는 로컬 모델을 사용하세요.' },
  ],
  'zh-cn': [
    { title: '预览每项更改', description: '重命名前先查看建议的文件名。' },
    { title: '按你的方式命名', description: '自由选择字段、顺序、分隔符、语言和日期格式。' },
    { title: '撤销任意批次', description: '一键恢复原始文件名。' },
    { title: '选择 AI 运行位置', description: '使用 Zush Cloud、自己的 AI 服务商或受支持的本地模型。' },
  ],
  tr: [
    { title: 'Her değişikliği önizleyin', description: 'Herhangi bir dosya yeniden adlandırılmadan önce öneriyi görün.' },
    { title: 'Adları kendi yönteminle oluştur', description: 'Alanları, sırayı, ayırıcıları, dili ve tarih biçimini seç.' },
    { title: 'Her toplu işlemi geri al', description: 'Özgün dosya adlarını tek tıkla geri yükle.' },
    { title: 'Yapay zekânın nerede çalışacağını seç', description: 'Zush Cloud’u, kendi sağlayıcını veya desteklenen yerel modelleri kullan.' },
  ],
  ar: [
    { title: 'عاين كل تغيير', description: 'شاهد اسم الملف المقترح قبل إعادة تسمية أي ملف.' },
    { title: 'أنشئ الأسماء بطريقتك', description: 'اختر الحقول وترتيبها والفواصل واللغة وتنسيق التاريخ.' },
    { title: 'تراجع عن أي دفعة', description: 'استعد أسماء الملفات الأصلية بنقرة واحدة.' },
    { title: 'اختر مكان تشغيل الذكاء الاصطناعي', description: 'استخدم Zush Cloud أو مزودك الخاص أو النماذج المحلية المدعومة.' },
  ],
};

const CONTROL_TITLES: Record<Locale, string> = {
  en: 'Stay in control of every rename',
  de: 'Behalte jede Umbenennung unter Kontrolle',
  fr: 'Gardez le contrôle de chaque renommage',
  'pt-br': 'Mantenha o controle de cada renomeação',
  es: 'Controla cada cambio de nombre',
  nl: 'Houd controle over elke naamswijziging',
  it: 'Mantieni il controllo su ogni rinomina',
  ja: 'すべての名前変更を自分で管理',
  ko: '모든 이름 변경을 직접 관리하세요',
  'zh-cn': '掌控每一次重命名',
  tr: 'Her yeniden adlandırmayı kontrol et',
  ar: 'تحكّم في كل عملية إعادة تسمية',
};

const localizedControlCopy = CONTROL_COPY[locale];
const controlFacts = [
  {
    icon: Eye,
    ...localizedControlCopy[0],
    color: 'green',
  },
  {
    icon: Settings2,
    ...localizedControlCopy[1],
    color: 'blue',
  },
  {
    icon: Undo2,
    ...localizedControlCopy[2],
    color: 'purple',
  },
  {
    icon: ShieldCheck,
    ...localizedControlCopy[3],
    color: 'orange',
  },
];

const sourceLinks = [
  { href: localizedHref('/'), label: copy.links.home },
  { href: localizedHref('/mac'), label: copy.links.mac },
  { href: localizedHref('/windows'), label: copy.links.windows },
  { href: localizedHref('/batch-rename-files'), label: copy.links.batchRename },
  { href: localizedHref('/ai-file-organizer'), label: copy.links.organizer },
  { href: localizedHref('/methodology'), label: copy.links.methodology },
  { href: localizedHref('/about'), label: copy.links.about },
  { href: '/authors/kirill-isachenko', label: copy.links.author },
  { href: '/pricing.md', label: copy.links.pricing },
  { href: localizedHref('/changelog'), label: copy.links.changelog },
  { href: '/llms.txt', label: 'llms.txt' },
  { href: localizedHref('/privacy-policy'), label: copy.links.privacy },
  { href: APP_STORE_URL, label: 'Mac App Store', external: true },
  { href: WINDOWS_STORE_URL, label: 'Microsoft Store', external: true },
  { href: PRODUCT_HUNT_URL, label: 'Product Hunt', external: true },
  { href: LINKEDIN_COMPANY_URL, label: 'LinkedIn', external: true },
  { href: CRUNCHBASE_URL, label: 'Crunchbase', external: true },
];

const visibleFacts = variant === 'control' ? controlFacts : facts;
const showFacts = variant !== 'intro' && variant !== 'sources';
const showSources = variant === 'all' || variant === 'sources';
const showIntro = variant === 'all' || variant === 'intro';
const showControlTitle = variant === 'control' && showControlHeading;
const labelledBy = showIntro
  ? 'about-zush-title'
  : showControlTitle
    ? 'evidence-control-title'
    : showSources
      ? 'evidence-sources-title'
      : undefined;
const sectionClass = [
  styles.EvidenceSignals,
  variant === 'intro' ? styles.EvidenceSignals_introOnly : '',
  variant === 'sources' ? styles.EvidenceSignals_sourcesOnly : '',
].filter(Boolean).join(' ');
---

<section
  class={sectionClass}
  aria-labelledby={labelledBy}
  aria-label={!labelledBy && showFacts ? copy.title : undefined}
  data-scroll-reveal-skip
>
  <div class={styles.EvidenceSignals__Container}>
    {showIntro && (
      <div class={`${sectionHeaderStyles.SectionHeader} ${variant === 'intro' ? styles.EvidenceSignals__IntroOnly : ''}`}>
        <Heading id="about-zush-title" as="h2" align="center" className={sectionHeaderStyles.SectionHeader__Title}>
          {titleParts[0]}{titleParts.length > 1 ? <span class="brand-accent-text">Zush</span> : null}{titleParts.slice(1).join('Zush')}
        </Heading>
        <Text as="p" size="lg" color="subtle" align="center" className={sectionHeaderStyles.SectionHeader__Description}>
          {description}
        </Text>
      </div>
    )}

    {showControlTitle && (
      <Heading id="evidence-control-title" as="h2" align="center" className={styles.EvidenceSignals__ControlTitle}>
        {CONTROL_TITLES[locale]}
      </Heading>
    )}

    {showFacts && (
      <dl class={styles.EvidenceSignals__Facts}>
        {visibleFacts.map((fact) => {
          const Icon = fact.icon;

          return (
            <div class={`${styles.EvidenceSignals__Fact} ${styles[`EvidenceSignals__Fact_${fact.color}`]}`}>
              <dt class={styles.EvidenceSignals__FactTitle}>
                <Icon size={30} aria-hidden="true" />
                <span>{fact.title}</span>
              </dt>
              <dd class={styles.EvidenceSignals__FactDescription}>{fact.description}</dd>
            </div>
          );
        })}
      </dl>
    )}

    {showSources && (
      <div class={styles.EvidenceSignals__Sources}>
        <Heading id="evidence-sources-title" as="h2" size="h4" align="center" className={styles.EvidenceSignals__SourcesTitle}>
          {copy.sourcesTitle}
        </Heading>
        <div class={styles.EvidenceSignals__SourceLinks}>
          {sourceLinks.map((link) => (
            <PillLink
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
              size="sm"
            >
              {link.label}
            </PillLink>
          ))}
        </div>
      </div>
    )}
  </div>
</section>
