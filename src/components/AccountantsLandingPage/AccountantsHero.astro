---
import { Image } from 'astro:assets';
import DownloadButton from '@/components/DownloadButton';
import ExternalRatings from '@/components/ExternalRatings/ExternalRatings.astro';
import Heading from '@/components/Heading';
import Text from '@/components/Text';
import { ACCOUNTANTS_HERO } from '@/data/accountantsLanding';
import heroPhoto from '@/assets/landing/accountants-hero.webp';
import styles from '@/components/MedicalLandingPage/MedicalHero.module.scss';
import accountantStyles from './AccountantsHero.module.scss';
---

<section class={styles.Hero} aria-labelledby='accountants-hero-title'>
  <div class={styles.Hero__Media} aria-hidden='true'>
    <Image
      class={`${styles.Hero__Photo} ${accountantStyles.HeroPhotoPosition}`}
      src={heroPhoto}
      alt={ACCOUNTANTS_HERO.photo.alt}
      widths={[640, 960, 1216, 1408]}
      sizes='100vw'
      loading='eager'
      decoding='async'
    />
  </div>
  <div class={styles.Hero__Scrim} aria-hidden='true'></div>

  <div class={styles.Hero__Container}>
    <div class={styles.Hero__Intro}>
      <ExternalRatings />
      <p class={styles.Hero__Eyebrow}>{ACCOUNTANTS_HERO.eyebrow}</p>
      <Heading as='h1' align='center' id='accountants-hero-title' className={styles.Hero__Title}>
        {ACCOUNTANTS_HERO.titleLead}<span class='brand-accent-text'>{ACCOUNTANTS_HERO.titleAccent}</span>
      </Heading>
      <Text as='p' size='lg' color='subtle' align='center' className={styles.Hero__Subtitle}>
        {ACCOUNTANTS_HERO.subtitle}
      </Text>

      <div class={styles.Hero__Actions}>
        <div class={styles.Hero__Buttons}>
          <DownloadButton client:visible source='hero' size='lg' forceOS='mac' showDropdown={false} label='Download for Mac' />
          <DownloadButton client:visible source='hero' size='lg' forceOS='windows' showDropdown={false} label='Download for Windows' />
        </div>
        <ul class={styles.Hero__TrustRow} aria-label='Why accounting teams use Zush'>
          {ACCOUNTANTS_HERO.trustLine.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>
