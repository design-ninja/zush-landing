---
import DownloadButton from '@/components/DownloadButton/DownloadButton';
import LanguageSwitcher from '@/components/LanguageSwitcher/LanguageSwitcher.astro';
import type { DownloadOS } from '@/utils/download';
import {
  DEFAULT_LOCALE,
  LOCALES,
  LOCALE_META,
  getAlternatePaths,
  getLocaleBasePath,
  getLocalizedPath,
  isLocalizedRoute,
  type Locale,
} from '@/i18n/config';
import { getCopy } from '@/i18n/copy';
import appLinkStyles from '@/components/AppLink/AppLink.module.scss';
import logoStyles from '@/components/Logo/Logo.module.scss';
import type { HeaderWidth } from './types';
import styles from './Header.module.scss';

interface Props {
  forceOS?: DownloadOS;
  basePath?: string;
  locale?: Locale;
  route?: string;
  hideDownload?: boolean;
  /**
   * How wide the pill is on desktop. `default` matches the 60rem content
   * container most pages use; `wide` matches the 72rem blog container. Phones
   * ignore it — there the pill always spans the viewport.
   */
  width?: HeaderWidth;
}

const {
  forceOS,
  basePath = '/',
  locale = DEFAULT_LOCALE,
  route = '/',
  hideDownload = false,
  width = 'default',
} = Astro.props as Props;
const localeCopy = getCopy(locale);
const copy = localeCopy.header;

const featuresHref = `${basePath}#features`;
const securityHref = `${basePath}#ways-to-run`;
const pricingHref = `${basePath}#pricing`;
const faqHref = `${basePath}#faq`;
const homeHref = getLocalizedPath('/', locale);
const blogHref = '/blog';
const navItems = [
  { href: featuresHref, label: copy.features },
  { href: securityHref, label: copy.security },
  { href: pricingHref, label: copy.pricing },
  { href: faqHref, label: copy.faq },
  { href: blogHref, label: copy.blog },
];
const menuLabel = copy.menu ?? 'Menu';
// Blog posts, the archive, tag pages, and the SEO landing pages exist in English
// only. Offering a language menu there used to dump the visitor on a translated
// homepage instead of the page they were reading, so it is hidden entirely.
const showLanguageSwitcher = isLocalizedRoute(route);
const shouldUseRouteLanguagePaths = isLocalizedRoute(route) && route !== '/404';
const languagePaths = shouldUseRouteLanguagePaths
  ? getAlternatePaths(route)
  : Object.fromEntries(
    LOCALES.map((item) => [item, getLocaleBasePath(item)]),
  ) as Partial<Record<Locale, string>>;
// Inside the burger panel the languages collapse into a native picker: it opens
// as the OS wheel instead of listing every locale in the panel, and unlike the
// pill's dropdown it cannot be clipped by the panel's own scroll container.
const languageOptions = LOCALES
  .map((item) => ({ locale: item, path: languagePaths[item], meta: LOCALE_META[item] }))
  .filter((option) => Boolean(option.path));
const navLinkClass = [appLinkStyles.AppLink, styles.Header__Link].join(' ');
const logoClass = [appLinkStyles.AppLink, logoStyles.Logo].join(' ');
const menuLinkClass = [appLinkStyles.AppLink, styles.Header__MenuLink].join(' ');
---

<!--
  The frosted-glass blur is authored inline. `is:inline` opts the block out of
  Astro's CSS pipeline (no scoping, bundling, or minification), so it ships
  verbatim. Routed through Header.module.scss the build mangled it — the space in
  `blur(24px) saturate(180%)` collapsed into an invalid value, and the unprefixed
  declaration was dropped from the prefix pair, leaving only the -webkit- one that
  Chrome ignores. Both consequences killed the blur on prod. Keep both prefixes:
  Safari < 18 needs -webkit-, everything else uses the unprefixed property.
-->
<style is:inline>
  [data-header-root] {
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    backdrop-filter: blur(24px) saturate(180%);
  }
</style>

<nav
  class:list={[
    styles.Header,
    width === 'wide' && styles.Header_wide,
    width === 'container' && styles.Header_container,
  ]}
  data-header-root
  data-menu-open='false'
>
  <div class={styles.Header__Container}>
    <button
      type='button'
      class={styles.Header__MenuToggle}
      aria-label={menuLabel}
      aria-expanded='false'
      aria-controls='header-mobile-menu'
      aria-haspopup='menu'
      data-header-menu-toggle
    >
      <span class={styles.Header__MenuIcon} aria-hidden='true'>
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>

    <a href={homeHref} class={logoClass}>
      <img
        src='/logo-96.webp'
        width='48'
        height='48'
        alt='Zush logo'
        aria-hidden='true'
        class={logoStyles.Logo__Icon}
        loading='eager'
        fetchpriority='high'
        decoding='async'
      />
      <span class={logoStyles.Logo__Wordmark}>
        <span class={logoStyles.Logo__Text}>Zush</span>
      </span>
    </a>

    <nav class={styles.Header__Nav} aria-label="Primary navigation">
      {navItems.map((item) => (
        <a href={item.href} class={navLinkClass}>{item.label}</a>
      ))}
    </nav>

    <div class={styles.Header__Actions}>
      <button
        type='button'
        class={styles.Header__ThemeToggle}
        aria-label={copy.toggleTheme}
        data-theme-toggle
      >
        <svg
          class={`${styles.Header__ThemeIcon} ${styles.Header__ThemeIcon_sun}`}
          width='20'
          height='20'
          viewBox='0 0 24 24'
          fill='none'
          stroke='currentColor'
          stroke-width='2'
          stroke-linecap='round'
          stroke-linejoin='round'
          aria-hidden='true'
        >
          <circle cx='12' cy='12' r='4'></circle>
          <path d='M12 2v2'></path>
          <path d='M12 20v2'></path>
          <path d='m4.93 4.93 1.41 1.41'></path>
          <path d='m17.66 17.66 1.41 1.41'></path>
          <path d='M2 12h2'></path>
          <path d='M20 12h2'></path>
          <path d='m6.34 17.66-1.41 1.41'></path>
          <path d='m19.07 4.93-1.41 1.41'></path>
        </svg>
        <svg
          class={`${styles.Header__ThemeIcon} ${styles.Header__ThemeIcon_moon}`}
          width='20'
          height='20'
          viewBox='0 0 24 24'
          fill='none'
          stroke='currentColor'
          stroke-width='2'
          stroke-linecap='round'
          stroke-linejoin='round'
          aria-hidden='true'
        >
          <path d='M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9'></path>
        </svg>
      </button>

      {
        showLanguageSwitcher && (
          <div class={styles.Header__Lang}>
            <LanguageSwitcher locale={locale} paths={languagePaths} label={copy.language} />
          </div>
        )
      }

      <div class={styles.Header__Buttons}>
        {!hideDownload && (
          <DownloadButton
            client:idle
            source='navbar'
            variant='primary'
            size='sm'
            label={copy.download}
            menuCopy={localeCopy.downloadMenu}
            forceOS={forceOS}
            showDropdown={false}
            className={styles.Header__DownloadBtn}
          />
        )}
      </div>
    </div>
  </div>

  <div
    id='header-mobile-menu'
    class={styles.Header__Menu}
    data-header-menu
  >
    <nav class={styles.Header__MenuNav} aria-label={menuLabel}>
      {navItems.map((item) => (
        <a href={item.href} class={menuLinkClass}>{item.label}</a>
      ))}
    </nav>

    <div class={styles.Header__MenuFooter}>
      <button
        type='button'
        class={styles.Header__MenuThemeToggle}
        data-theme-toggle
      >
        <svg
          class={`${styles.Header__ThemeIcon} ${styles.Header__ThemeIcon_sun}`}
          width='18'
          height='18'
          viewBox='0 0 24 24'
          fill='none'
          stroke='currentColor'
          stroke-width='2'
          stroke-linecap='round'
          stroke-linejoin='round'
          aria-hidden='true'
        >
          <circle cx='12' cy='12' r='4'></circle>
          <path d='M12 2v2'></path>
          <path d='M12 20v2'></path>
          <path d='m4.93 4.93 1.41 1.41'></path>
          <path d='m17.66 17.66 1.41 1.41'></path>
          <path d='M2 12h2'></path>
          <path d='M20 12h2'></path>
          <path d='m6.34 17.66-1.41 1.41'></path>
          <path d='m19.07 4.93-1.41 1.41'></path>
        </svg>
        <svg
          class={`${styles.Header__ThemeIcon} ${styles.Header__ThemeIcon_moon}`}
          width='18'
          height='18'
          viewBox='0 0 24 24'
          fill='none'
          stroke='currentColor'
          stroke-width='2'
          stroke-linecap='round'
          stroke-linejoin='round'
          aria-hidden='true'
        >
          <path d='M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9'></path>
        </svg>
        <span>{copy.toggleTheme}</span>
      </button>

      {
        showLanguageSwitcher && (
          <label class={styles.Header__MenuLang}>
            <svg
              class={styles.Header__MenuLangIcon}
              width='18'
              height='18'
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2'
              stroke-linecap='round'
              stroke-linejoin='round'
              aria-hidden='true'
            >
              <circle cx='12' cy='12' r='9'></circle>
              <path d='M3.6 9h16.8M3.6 15h16.8'></path>
              <path d='M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18'></path>
            </svg>
            <span class={styles.Header__MenuLangLabel}>{copy.language}</span>
            <select
              class={styles.Header__MenuLangSelect}
              aria-label={copy.language}
              data-language-switcher
              data-language-paths={JSON.stringify(languagePaths)}
            >
              {languageOptions.map((option) => (
                <option value={option.locale} selected={option.locale === locale}>
                  {option.meta.nativeLabel}
                </option>
              ))}
            </select>
            <svg
              class={styles.Header__MenuLangChevron}
              width='18'
              height='18'
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2'
              stroke-linecap='round'
              stroke-linejoin='round'
              aria-hidden='true'
            >
              <path d='m6 9 6 6 6-6'></path>
            </svg>
          </label>
        )
      }
    </div>
  </div>
</nav>

<script>
  // The burger panel only exists below the mobile breakpoint; above it the
  // toggle is hidden and the panel stays collapsed by CSS.
  const desktopQuery = window.matchMedia('(min-width: 769px)');

  function bindHeaderMenu() {
    const root = document.querySelector('[data-header-root]');
    if (!(root instanceof HTMLElement) || root.dataset.menuBound === 'true') return;

    const toggle = root.querySelector('[data-header-menu-toggle]');
    const menu = root.querySelector('[data-header-menu]');
    if (!(toggle instanceof HTMLButtonElement) || !(menu instanceof HTMLElement)) return;

    root.dataset.menuBound = 'true';

    const setOpen = (isOpen: boolean) => {
      root.dataset.menuOpen = isOpen ? 'true' : 'false';
      toggle.setAttribute('aria-expanded', String(isOpen));
    };

    toggle.addEventListener('click', () => {
      setOpen(root.dataset.menuOpen !== 'true');
    });

    // Every link navigates away or jumps to an anchor on the same page, so the
    // panel has to close itself; the theme toggle inside it deliberately does not.
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('click', (event) => {
      if (root.dataset.menuOpen !== 'true') return;
      if (event.target instanceof Node && root.contains(event.target)) return;
      setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || root.dataset.menuOpen !== 'true') return;
      setOpen(false);
      toggle.focus();
    });

    desktopQuery.addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }

  bindHeaderMenu();
  document.addEventListener('astro:after-swap', bindHeaderMenu);
</script>
