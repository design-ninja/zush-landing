---
// One AI mode as a hairline column (Blocks): accent icon, title, optional
// badge, copy.
import type { LucideIcon } from 'lucide-react';
import b from '@/components/Blocks/Blocks.module.scss';
import styles from './WaysToRun.module.scss';

interface Props {
  title: string;
  description: string;
  icon: LucideIcon;
  class?: string;
  badge?: string;
  badgeTone?: 'success';
}

const { title, description, icon: Icon, class: className, badge, badgeTone } = Astro.props;
---

<div class:list={[b.Column, styles.BentoCard, className]} data-bento-card>
  <span class={b.ColumnIcon}><Icon size={24} strokeWidth={1.7} aria-hidden='true' /></span>
  <div class={styles.BentoCard__TitleRow}>
    <h3 class={b.ColumnTitle}>{title}</h3>
    {badge && (
      <span class:list={[b.Badge, { [b.Badge_accent]: badgeTone !== 'success' }]}>
        {badge}
      </span>
    )}
  </div>
  <p class={b.ColumnText}>{description}</p>
</div>
