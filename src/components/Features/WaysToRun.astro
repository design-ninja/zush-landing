---
// "Choose where AI runs" — the homepage block (design/homepage-concept/native.dc.html):
// three AI modes as hairline columns with an accent icon. Every page that
// explains the AI modes renders this component; pages with their own wording
// (professions) pass a title, description and modes, plus an optional note
// in the default slot.
import { Cloud, KeyRound, ShieldCheck } from 'lucide-react';
import SectionHeader from '@/components/SectionHeader';
import { DEFAULT_FEATURE_CARDS_COPY, type FeatureCardsCopy } from '@/i18n/copy';
import BentoCard from './BentoCard.astro';
import b from '@/components/Blocks/Blocks.module.scss';

type AiModeKind = 'cloud-ai' | 'byok' | 'offline-ai';

export interface AiMode {
  kind: AiModeKind;
  title: string;
  description: string;
  badge?: string;
  badgeTone?: 'success';
}

interface Props {
  copy?: FeatureCardsCopy;
  /** Page-specific modes; defaults to the three from `copy`. */
  modes?: AiMode[];
  title?: string;
  description?: string;
  /** Section anchor (#ways-to-run on product pages, #privacy on professions). */
  id?: string;
  /** Heading id for aria-labelledby and deep links. */
  headingId?: string;
}

const MODE_ICONS = { 'cloud-ai': Cloud, byok: KeyRound, 'offline-ai': ShieldCheck } as const;

const {
  copy = DEFAULT_FEATURE_CARDS_COPY,
  modes = [
    { kind: 'cloud-ai', ...copy.cloudAi },
    { kind: 'byok', ...copy.byok },
    { kind: 'offline-ai', ...copy.offlineAi },
  ],
  title = copy.bandTitle,
  description = copy.bandSubtitle,
  id = 'ways-to-run',
  headingId,
} = Astro.props as Props;
---

<section id={id} class={b.Section} aria-labelledby={headingId}>
  <SectionHeader id={headingId} title={title} description={description} />

  <div class={b.Columns}>
    {modes.map(({ kind, title, description, badge, badgeTone }) => (
      <BentoCard title={title} description={description} icon={MODE_ICONS[kind]} badge={badge} badgeTone={badgeTone} />
    ))}
  </div>

  <slot />
</section>
