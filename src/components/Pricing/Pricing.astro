---
import SectionHeader from '@/components/SectionHeader';
import AppleIcon from '@/components/AppleIcon';
import StarRating from '@/components/StarRating';
import Text from '@/components/Text';
import WindowsIcon from '@/components/WindowsIcon';
import buttonStyles from '@/components/Button/Button.module.scss';
import { Check } from 'lucide-react';
import { PRO_ONE_TIME_PROMOTION } from '@/constants/promotion';
import { PRICING_PLANS, PRO_FEATURES } from './constants';
import styles from './Pricing.module.scss';

interface PlanCopy {
  titleSuffix?: string;
  description?: string;
  buttonText?: string;
  billing?: string;
}

interface Props {
  copy?: {
    title: string;
    description: string;
    buttonHint: string;
    features: Array<{ title: string; desc: string }>;
    oneTimeDifferentiators?: string[];
    monthlyPlan?: PlanCopy;
    oneTimePlan?: PlanCopy;
    bestValueBadge?: string;
    trustedByLine?: string;
  };
}

const { copy } = Astro.props as Props;
const featuredButtonClass = [
  buttonStyles.Button,
  buttonStyles.Button_primary,
  buttonStyles.Button_md,
  buttonStyles.Button_fluid,
].join(' ');
const regularButtonClass = [
  buttonStyles.Button,
  buttonStyles.Button_outline,
  buttonStyles.Button_md,
  buttonStyles.Button_fluid,
].join(' ');
const trustLine = copy?.buttonHint ?? '14-day money-back guarantee • Secure via Paddle';
const trustedByLine = copy?.trustedByLine ?? 'Trusted by 3000+ users';
const promotion = PRO_ONE_TIME_PROMOTION;
const rawTitle = copy?.title ?? 'Choose your PRO plan';
const titleHtml = rawTitle.replace(
  /\bPRO\b/,
  `<span class="${styles.Pricing__TitlePro}">PRO</span>`,
);
const proFeatures = PRO_FEATURES.map((feature, index) => ({
  ...feature,
  title: copy?.features[index]?.title ?? feature.title,
}));
const plans = PRICING_PLANS.map((plan) => {
  const planCopy: PlanCopy | undefined =
    plan.id === 'monthly' ? copy?.monthlyPlan : copy?.oneTimePlan;
  const featured = plan.id === 'one-time';

  return {
    ...plan,
    featured,
    titleSuffix: planCopy?.titleSuffix ?? plan.titleSuffix,
    description: planCopy?.description ?? plan.description,
    buttonText: planCopy?.buttonText ?? plan.buttonText,
    billing: planCopy?.billing ?? plan.billing,
    promotion: featured ? promotion : undefined,
    // The regular pays-off note is hidden while the promotional price is active.
    priceNote: featured ? undefined : plan.priceNote,
  };
});
---

<section id="pricing" class={styles.Pricing}>
  <div class={styles.Pricing__Container}>
    <img
      class={styles.Pricing__AppIcon}
      src="/logo-96.png"
      alt="Zush app icon"
      aria-hidden="true"
      width="96"
      height="96"
      loading="lazy"
      decoding="async"
    />
    <SectionHeader
      align="center"
      titleHtml={titleHtml}
      description={copy?.description ?? 'Monthly flexibility or one-time lifetime access. Both plans unlock unlimited PRO.'}
      className={styles.Pricing__Header}
    />

    <div class={styles.Pricing__Layout}>
      <div class={styles.Pricing__Trusted}>
        <svg class={styles.Pricing__Laurel} viewBox="0 0 28 58" fill="currentColor" aria-hidden="true">
          <defs>
            <path id="zush-laurel-leaf-a" d="M0 0 C-2.1 -2.6 -2.1 -6 0 -8.6 C2.1 -6 2.1 -2.6 0 0 Z" />
          </defs>
          <use href="#zush-laurel-leaf-a" transform="translate(19 52.5) rotate(-72)" />
          <use href="#zush-laurel-leaf-a" transform="translate(14.5 45.5) rotate(-62)" />
          <use href="#zush-laurel-leaf-a" transform="translate(16 46.5) rotate(-12) scale(0.85)" />
          <use href="#zush-laurel-leaf-a" transform="translate(11.5 37.5) rotate(-52)" />
          <use href="#zush-laurel-leaf-a" transform="translate(13.2 38.5) rotate(-4) scale(0.85)" />
          <use href="#zush-laurel-leaf-a" transform="translate(10 29.5) rotate(-42)" />
          <use href="#zush-laurel-leaf-a" transform="translate(11.8 30.5) rotate(4) scale(0.85)" />
          <use href="#zush-laurel-leaf-a" transform="translate(10.6 21.5) rotate(-32)" />
          <use href="#zush-laurel-leaf-a" transform="translate(12.4 22.3) rotate(12) scale(0.85)" />
          <use href="#zush-laurel-leaf-a" transform="translate(12 13.5) rotate(-22)" />
          <use href="#zush-laurel-leaf-a" transform="translate(13.8 14) rotate(18) scale(0.85)" />
          <use href="#zush-laurel-leaf-a" transform="translate(14.4 7) rotate(-6)" />
        </svg>
        <span class={styles.Pricing__TrustedContent}>
          <StarRating decorative className={styles.Pricing__TrustedStars} />
          <span class={styles.Pricing__TrustedLabel}>{trustedByLine}</span>
        </span>
        <svg class={`${styles.Pricing__Laurel} ${styles.Pricing__Laurel_mirrored}`} viewBox="0 0 28 58" fill="currentColor" aria-hidden="true">
          <defs>
            <path id="zush-laurel-leaf-b" d="M0 0 C-2.1 -2.6 -2.1 -6 0 -8.6 C2.1 -6 2.1 -2.6 0 0 Z" />
          </defs>
          <use href="#zush-laurel-leaf-b" transform="translate(19 52.5) rotate(-72)" />
          <use href="#zush-laurel-leaf-b" transform="translate(14.5 45.5) rotate(-62)" />
          <use href="#zush-laurel-leaf-b" transform="translate(16 46.5) rotate(-12) scale(0.85)" />
          <use href="#zush-laurel-leaf-b" transform="translate(11.5 37.5) rotate(-52)" />
          <use href="#zush-laurel-leaf-b" transform="translate(13.2 38.5) rotate(-4) scale(0.85)" />
          <use href="#zush-laurel-leaf-b" transform="translate(10 29.5) rotate(-42)" />
          <use href="#zush-laurel-leaf-b" transform="translate(11.8 30.5) rotate(4) scale(0.85)" />
          <use href="#zush-laurel-leaf-b" transform="translate(10.6 21.5) rotate(-32)" />
          <use href="#zush-laurel-leaf-b" transform="translate(12.4 22.3) rotate(12) scale(0.85)" />
          <use href="#zush-laurel-leaf-b" transform="translate(12 13.5) rotate(-22)" />
          <use href="#zush-laurel-leaf-b" transform="translate(13.8 14) rotate(18) scale(0.85)" />
          <use href="#zush-laurel-leaf-b" transform="translate(14.4 7) rotate(-6)" />
        </svg>
      </div>

      <div class={styles.Pricing__Plans} data-pricing-plans>
        {plans.map((plan) => (
        <article
          class:list={[styles.PricingCard, plan.featured && styles.PricingCard_featured]}
          id={plan.id === 'monthly' ? 'pro' : undefined}
        >
          <header class={styles.PricingCard__Header}>
            <h3 class={styles.PricingCard__Name}>
              <span class={styles.PricingCard__NamePro}>PRO</span>{' '}
              <span class={styles.PricingCard__NameStar} aria-hidden="true">🌟</span>{' '}
              <span>{plan.titleSuffix}</span>
            </h3>
            <Text
              as="p"
              size="sm"
              color="subtle"
              className={styles.PricingCard__Description}
            >
              {plan.description}
            </Text>
          </header>

          <div class={styles.PricingCard__Pricing}>
            <p class={styles.PricingCard__Price}>
              {plan.promotion && (
                <s class={styles.PricingCard__OriginalPrice}>{plan.price}</s>
              )}
              <span class={styles.PricingCard__PriceValue}>
                {plan.promotion?.discountedPrice.label ?? plan.price}
              </span>
              {plan.billing && (
                <span class={styles.PricingCard__PricePeriod}>{plan.billing} +VAT</span>
              )}
            </p>
            {plan.priceNote && (
              <p class={styles.PricingCard__PriceNote}>{plan.priceNote}</p>
            )}
          </div>

          <div class={styles.PricingCard__PromotionSlot}>
            {plan.promotion && (
              <div class={styles.PricingCard__Promotion} aria-label={`${plan.promotion.discountPercent}% discount with promo code ${plan.promotion.code}`}>
                <span class={styles.PricingCard__PromotionSaving}>
                  <span aria-hidden="true">✦</span>
                  Limited Offer
                </span>
                <span class={styles.PricingCard__PromotionMessage}>
                  <strong>{plan.promotion.discountPercent}% off</strong>
                  <span>with code</span>
                </span>
                <button
                  type="button"
                  class={styles.PricingCard__PromoCode}
                  data-promo-copy
                  data-promo-code={plan.promotion.code}
                  data-copy-state="idle"
                  aria-label={`Copy promo code ${plan.promotion.code}`}
                >
                  <span class={styles.PricingCard__PromoCodeValue}>{plan.promotion.code}</span>
                  <span class={styles.PricingCard__PromoCodeStatus} data-promo-copy-label aria-live="polite">Copy</span>
                  <svg class={styles.PricingCard__CopyIcon} viewBox="0 0 18 18" fill="none" aria-hidden="true">
                    <rect x="6.25" y="2.75" width="8.5" height="8.5" rx="2" stroke="currentColor" stroke-width="1.4" />
                    <path d="M11.5 12.25v.5a2 2 0 0 1-2 2H5.25a2 2 0 0 1-2-2V8.5a2 2 0 0 1 2-2h.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                  </svg>
                  <svg class={styles.PricingCard__CheckIcon} viewBox="0 0 18 18" fill="none" aria-hidden="true">
                    <path d="m4 9.25 3.1 3.1L14.25 5.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>
              </div>
            )}
          </div>

          <ul class={styles.PricingCard__Benefits}>
            {proFeatures.map((feature) => (
                <li class={styles.PricingCard__Benefit}>
                  <Check className={styles.PricingCard__Check} size={16} strokeWidth={2.5} aria-hidden="true" />
                  <span>{feature.title}</span>
                  {feature.platforms && (
                    <span class={styles.PricingCard__Platforms} role="img" aria-label="Mac, Windows">
                      <AppleIcon />
                      <span class={styles.PricingCard__PlatformsPlus} aria-hidden="true">+</span>
                      <WindowsIcon />
                    </span>
                  )}
                </li>
            ))}
          </ul>

          <div class={styles.PricingCard__ButtonWrapper}>
            <button
              type="button"
              class={plan.featured ? featuredButtonClass : regularButtonClass}
              data-paddle-checkout
              data-paddle-price-id={plan.paddlePriceId}
              data-pro-plan-id={plan.id}
              data-pro-plan-price={plan.promotion?.discountedPrice.label ?? plan.price}
              data-pro-plan-billing={plan.billing}
            >
              <span class={styles.PricingCard__ButtonText}>
                {plan.buttonText}
              </span>
            </button>
          </div>
        </article>
        ))}
      </div>
    </div>

    <Text as="p" size="sm" color="subtle" align="center" className={styles.Pricing__TrustLine}>
      {trustLine}
    </Text>
  </div>
</section>

<script>
  // A plain #pricing jump puts the section heading under the navbar and the plan
  // buttons below the fold. Scroll just far enough that the cards, buttons
  // included, end inside the viewport; when they cannot fit (stacked on phones),
  // start the cards right under the navbar instead.
  const BOTTOM_GAP = 24;

  const getPricingTarget = (): number | null => {
    const section = document.getElementById('pricing');
    const plans = section?.querySelector<HTMLElement>('[data-pricing-plans]');
    if (!section || !plans) return null;
    const offset = parseFloat(getComputedStyle(section).scrollMarginTop) || 0;
    const sectionTop = section.getBoundingClientRect().top + window.scrollY - offset;
    const plansRect = plans.getBoundingClientRect();
    const plansTop = plansRect.top + window.scrollY - offset;
    const plansBottom = plansRect.bottom + window.scrollY;
    const alignBottom = plansBottom + BOTTOM_GAP - window.innerHeight;
    return Math.max(sectionTop, Math.min(alignBottom, plansTop));
  };

  const scrollToPricing = (behavior: ScrollBehavior) => {
    const top = getPricingTarget();
    if (top === null) return;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.scrollTo({ top, behavior: reduced ? 'auto' : behavior });
  };

  document.addEventListener('click', (event) => {
    if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('a[href$="#pricing"]');
    if (!link) return;
    const url = new URL(link.href, window.location.href);
    if (url.pathname !== window.location.pathname || !document.getElementById('pricing')) return;
    event.preventDefault();
    if (window.location.hash !== '#pricing') history.pushState(null, '', '#pricing');
    scrollToPricing('smooth');
  });

  // Arriving from another page with #pricing: the browser has already jumped to
  // the section; nudge it once layout has settled.
  if (window.location.hash === '#pricing') {
    const settle = () => requestAnimationFrame(() => scrollToPricing('auto'));
    if (document.readyState === 'complete') settle();
    else window.addEventListener('load', settle, { once: true });
  }
</script>
