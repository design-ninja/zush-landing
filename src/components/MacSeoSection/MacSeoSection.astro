---
import {
  FolderSearch,
  KeyRound,
  ListChecks,
  Receipt,
  Search,
  WandSparkles,
} from 'lucide-react';
import PlatformSeoSection, { type PlatformSeoCard } from '@/components/PlatformSeoSection/PlatformSeoSection.astro';
import { APP_CONFIG, SUPPORTED_FORMAT_COUNT } from '@/constants';
import { PRO_PRICING_SUMMARY } from '@/constants/pricing';

const docsLinks = [
  { href: '/hazel-alternative', label: 'Hazel alternative' },
  { href: '/ai-file-organizer', label: 'AI file organizer' },
  { href: '/docs/folder-monitoring', label: 'Automate Downloads cleanup' },
  { href: '/docs/naming-blocks', label: 'Naming Blocks' },
  { href: '/docs/custom-ai-blocks', label: 'Custom AI Blocks' },
];

const cards: PlatformSeoCard[] = [
  {
    icon: ListChecks,
    title: 'Batch rename from Finder',
    body:
      'Drag files or folders from Finder, generate names from content, review every suggestion, and apply the full batch with undo history.',
  },
  {
    icon: FolderSearch,
    title: 'Automatic Downloads & Screenshots cleanup',
    body:
      'Monitor ~/Downloads, Desktop, or a screenshots folder so new files get readable names as they arrive — rename in place or enable optional AI folder sorting to group new files by content.',
  },
  {
    icon: Search,
    title: 'Searchable names for Finder & Spotlight',
    body:
      'Zush writes file content into readable filenames and metadata so Finder and Spotlight can surface files without opening each one.',
  },
  {
    icon: WandSparkles,
    title: 'Templates, Naming Blocks & Custom AI Blocks',
    body:
      'Combine AI titles with dates, clients, and counters from 145+ Naming Blocks, or describe your own field — client, case number, brand — with a Custom AI Block.',
  },
  {
    icon: KeyRound,
    title: 'LM Studio or Ollama',
    body:
      'Use Zush Cloud, connect Gemini, OpenRouter, OpenAI, or Claude with BYOK, or keep supported analysis on-device with LM Studio or Ollama.',
  },
  {
    icon: Receipt,
    title: 'Invoices, receipts, and scans',
    body:
      'Name invoice and receipt PDFs and photos by vendor, date, and amount, with scanned documents read by AI vision.',
    href: '/rename-invoices-with-ai',
  },
];

const rows: [string, string, string][] = [
  ['Name mixed files by what they contain', 'Zush for Mac', 'Every file can get a different descriptive name after AI analysis.'],
  ['Auto-clean Downloads and Screenshots', 'Zush for Mac', 'Folder monitoring names new files by content, with preview and undo.'],
  ['Move or tag files by rule, run scripts', 'Hazel', 'Rule engines still fit when the logic is about where a file came from.'],
];
---

<PlatformSeoSection
  eyebrow="Mac file organizing"
  title="Automatic file organizer for Mac"
  intro={`Zush is an AI file renamer and organizer for macOS 15 and later. It reads ${SUPPORTED_FORMAT_COUNT} formats, from screenshots and HEIC or RAW photos to PDFs, scans, Office files, video, and audio, and gives each file a descriptive name you review before applying. It can sort files into folders by your own plain-language rules and keep Downloads tidy with folder monitoring. Start with ${APP_CONFIG.free_tier_limit} free renames; PRO is ${PRO_PRICING_SUMMARY}.`}
  cards={cards}
  comparisonTitle="When Zush is a Hazel alternative for Mac"
  tableLabel="Mac file organizing comparison"
  rows={rows}
  docsLabel="Mac file organizing resources"
  docsLinks={docsLinks}
>
  <p>
    Hazel is a rule engine that watches folders and acts on files by conditions like name,
    date, or kind. Zush works the other way around: it reads what each file actually contains
    and suggests a descriptive, searchable name.
  </p>
  <p>
    Zush adds optional AI folder sorting and destination folders alongside
    folder monitoring and rename history. The Windows version supports in-place renaming — see the full
    <a href="/hazel-alternative"> Hazel alternative </a> comparison.
  </p>
</PlatformSeoSection>
