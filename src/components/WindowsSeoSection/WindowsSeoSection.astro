---
import {
  FolderSearch,
  History,
  KeyRound,
  ListChecks,
  MonitorDown,
  Search,
} from 'lucide-react';
import PlatformSeoSection, { type PlatformSeoCard } from '@/components/PlatformSeoSection/PlatformSeoSection.astro';
import SectionHeader from '@/components/SectionHeader';
import b from '@/components/Blocks/Blocks.module.scss';

const docsLinks = [
  { href: '/blog/best-file-renamer-windows-11', label: 'PowerRename and other renamers compared' },
  { href: '/rename-invoices-with-ai', label: 'Rename invoices with AI' },
  { href: '/docs/batch-rename-files', label: 'Batch rename files' },
  { href: '/docs/privacy-security', label: 'Privacy & security' },
  { href: '/docs/undo-history', label: 'Preview & undo history' },
  { href: '/docs/folder-monitoring', label: 'Automate Downloads cleanup' },
  { href: '/docs/file-search', label: 'Make files searchable' },
  { href: '/docs/supported-file-types', label: 'Supported file types' },
  { href: '/docs/folder-sorting', label: 'Nested folders & post-rename sorting' },
];

const cards: PlatformSeoCard[] = [
  {
    icon: ListChecks,
    title: 'Batch rename files on Windows',
    body:
      'Drag files from File Explorer, generate names from content, review every suggestion, and apply only when the batch is ready. Undo history keeps the original names available.',
  },
  {
    icon: FolderSearch,
    title: 'AI file organizer workflow',
    body:
      'Zush supports nested folder rules and sorting already renamed files without another rename credit. These workflows are available on both Windows and Mac.',
  },
  {
    icon: Search,
    title: 'Searchable Windows filenames',
    body:
      'Zush turns file content into readable filenames and metadata so File Explorer and Windows Search can surface files without opening each one.',
  },
  {
    icon: MonitorDown,
    title: 'Microsoft Store install',
    body:
      'Install from the Microsoft Store for Windows 10 and Windows 11, with Store-managed package trust and automatic updates.',
  },
  {
    icon: KeyRound,
    title: 'BYOK and Local AI',
    body:
      'Choose the privacy level for the job: use Zush Cloud, connect your own provider account with BYOK, or keep supported analysis on-device with Local AI.',
  },
  {
    icon: History,
    title: 'RenameClick alternative for Windows',
    body:
      'Compare Zush when you want Microsoft Store distribution, preview, undo, BYOK, Local AI, and a Windows-focused batch rename workflow.',
  },
];

const rows: [string, string, string][] = [
  ['Need a RenameClick alternative on Windows', 'Zush for Windows', 'Microsoft Store distribution, batch review, undo, BYOK, and Local AI in one workflow.'],
  ['Rename screenshots, PDFs, photos, videos, audio, or docs by content', 'Zush for Windows', 'Every file can get a different descriptive name after AI analysis.'],
  ['Add counters, prefixes, or case rules only', 'PowerRename / Bulk Rename Utility', 'Rule-based tools still fit when the same pattern applies to every filename.'],
];

const powerRenameRows: [string, string, string][] = [
  ['How names are made', 'Search-and-replace and regular expressions on the existing filename', 'AI reads each file and proposes a descriptive name from its content'],
  ['Mixed folders (scans, PDFs, photos, screenshots)', 'Every file gets the same rule applied', 'Every file can get its own name, built from your naming template'],
  ['Review and undo', 'Live preview before renaming', 'Preview of every proposed name, plus Rename History to restore originals'],
  ['Where it runs', 'Free part of Microsoft PowerToys, File Explorer context menu', 'Microsoft Store app for Windows 10 and 11, with Zush Cloud, BYOK, or Local AI'],
];
---

<PlatformSeoSection
  eyebrow="Windows file renaming"
  title="Batch rename and organize Windows files by content"
  intro="Zush is a Windows 10 and 11 AI file renamer for messy File Explorer folders. It proposes names first, lets you review every change, and keeps the original names in undo history after you apply a batch. Video support includes MP4, MOV, MKV, AVI, and WMV on both Windows and Mac."
  cards={cards}
  comparisonTitle="When Zush is a RenameClick alternative for Windows"
  tableLabel="Windows rename workflow comparison"
  rows={rows}
  docsLabel="Windows file renaming documentation"
  docsLinks={docsLinks}
>
  <p>
    RenameClick and traditional Windows rename tools can both help clean up folders. Zush is strongest when
    you want a Microsoft Store install, review before apply, undo history, BYOK, Local AI, and content-aware
    names for mixed Windows folders.
  </p>
</PlatformSeoSection>

<section class={b.Section}>
  <SectionHeader
    id="powerrename-alternative"
    eyebrow="PowerRename alternative"
    title="Zush as a PowerRename alternative on Windows"
    description={[
      'Zush is a PowerRename alternative for files that need names based on what is inside them. PowerRename in Microsoft PowerToys rewrites the existing filename with search-and-replace and regular expressions and never opens the file. Zush reads each document, image, PDF, screenshot, audio, or video file and proposes a descriptive name you review before applying.',
      'Keep PowerRename for uniform mechanical edits such as replacing a word, fixing case, or adding a counter. Use Zush when a folder of IMG_1234.jpg and scan_001.pdf files needs a different, meaningful name for every file.',
    ]}
  />
  <div class={b.Table} role="table" aria-label="PowerRename and Zush compared">
    <div class:list={[b.TableRow, b.TableRow_head]} role="row">
      <strong role="columnheader">Question</strong>
      <strong role="columnheader">PowerRename</strong>
      <strong role="columnheader">Zush</strong>
    </div>
    {powerRenameRows.map(([question, powerRename, zush]) => (
      <div class={b.TableRow} role="row">
        <span role="cell"><strong>{question}</strong></span>
        <span role="cell">{powerRename}</span>
        <span role="cell">{zush}</span>
      </div>
    ))}
  </div>
  <p class={b.BlockText}>
    See how <a href="/blog/best-file-renamer-windows-11">PowerRename and other Windows renamers compare</a>.
  </p>
</section>
