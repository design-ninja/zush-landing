---
import { Image } from 'astro:assets';
import heroPhoto from '@/assets/landing/hr-hero.webp';
import DownloadButton from '@/components/DownloadButton';
import Heading from '@/components/Heading';
import Text from '@/components/Text';
import { HR_HERO } from '@/data/hrLanding';
import styles from '@/components/LegalLandingPage/LegalHero.module.scss';
---

<section class={styles.Hero} aria-labelledby="hr-hero-title">
  <div class={styles.Hero__Media} aria-hidden="true">
    <Image
      class={styles.Hero__Photo}
      src={heroPhoto}
      alt={HR_HERO.photo.alt}
      widths={[640, 960, 1216, 1408]}
      sizes="100vw"
      loading="eager"
      decoding="async"
    />
  </div>
  <div class={styles.Hero__Scrim} aria-hidden="true"></div>

  <div class={styles.Hero__Container}>
    <div class={styles.Hero__Intro}>
      <p class={styles.Hero__Eyebrow}>{HR_HERO.eyebrow}</p>

      <Heading as="h1" align="center" id="hr-hero-title" className={styles.Hero__Title}>
        {HR_HERO.titleLead}<span class="brand-accent-text">{HR_HERO.titleAccent}</span>
      </Heading>

      <Text as="p" size="lg" color="subtle" align="center" className={styles.Hero__Subtitle}>
        {HR_HERO.subtitle}
      </Text>

      <div class={styles.Hero__Actions}>
        <div class={styles.Hero__Buttons}>
          <DownloadButton
            client:visible
            source="hero"
            size="lg"
            forceOS="mac"
            showDropdown={false}
            label="Download for Mac"
          />
          <DownloadButton
            client:visible
            source="hero"
            size="lg"
            forceOS="windows"
            showDropdown={false}
            label="Download for Windows"
          />
        </div>

        <ul class={styles.Hero__TrustRow} aria-label="Controls for HR document workflows">
          {HR_HERO.trustLine.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>
