---
import { DEFAULT_LOCALE, type Locale } from '@/i18n/config';
import styles from './FeaturedOn.module.scss';

interface Props {
  locale?: Locale;
}

const titleByLocale: Partial<Record<Locale, string>> = {
  en: 'Featured on',
  fr: 'Présenté sur',
  de: 'Bekannt aus',
  es: 'Destacado en',
  'pt-br': 'Em destaque em',
  it: 'In evidenza su',
  nl: 'Uitgelicht op',
  tr: 'Öne çıktığı platformlar',
  ja: '掲載カタログ',
  ko: '소개된 곳',
  'zh-cn': '收录平台',
};

const catalogs = [
  {
    name: 'G2',
    href: 'https://www.g2.com/products/zush/reviews',
    icon: '/images/featured-on/g2.png',
  },
  {
    name: 'Product Hunt',
    href: 'https://www.producthunt.com/products/zush',
    modifier: styles.FeaturedOnItem_producthunt,
  },
  {
    name: 'Capterra',
    href: 'https://www.capterra.com/p/10042644/Zush/',
    icon: '/images/featured-on/capterra.png',
  },
  {
    name: 'SourceForge',
    href: 'https://sourceforge.net/software/product/Zush/',
    icon: '/images/featured-on/sourceforge.png',
  },
  {
    name: 'Homebrew',
    href: 'https://formulae.brew.sh/cask/zush',
    icon: '/images/featured-on/homebrew.png',
  },
  {
    name: 'Software Advice',
    href: 'https://www.softwareadvice.com/product/549611-Zush/',
    icon: '/images/featured-on/software-advice.png',
  },
  {
    name: 'GetApp',
    href: 'https://www.getapp.com/all-software/a/zush/',
