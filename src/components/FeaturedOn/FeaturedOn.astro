    nofollow: true,
  },
  {
    name: 'ScrollLaunch',
    href: 'https://www.scrolllaunch.com/products/zush?ref=badge',
    iconSvg:
      'M22.0997 17.8596L31.9992 7.9602L29.8779 5.83883L22.539 13.1777V0H19.539V13.1777L12.2002 5.83883L10.0789 7.9602L19.9784 17.8596L21.039 18.9203L22.0997 17.8596ZM24.2204 19.981L34.1199 10.0815L36.2412 12.2028L28.9024 19.5416H41.998V22.5416H28.9024L36.2412 29.8805L34.1199 32.0018L24.2204 22.1023L23.1597 21.0416L24.2204 19.981ZM7.95821 32.0018L17.8576 22.1023L18.9183 21.0416L17.8576 19.981L7.95821 10.0815L5.83688 12.2028L13.1757 19.5416H0V22.5416H13.1757L5.83688 29.8805L7.95821 32.0018ZM19.9784 24.2236L10.0789 34.1231L12.2002 36.2444L19.539 28.9056V42H22.539V28.9056L29.8779 36.2444L31.9992 34.1231L22.0997 24.2236L21.039 23.1629L19.9784 24.2236Z',
    iconViewBox: '0 0 42 42',
    rel: 'noopener',
  },
  {
    name: 'Launchpadly',
    href: 'https://launchpadly.co/startup/zush?ref=badge',
    icon: '/images/featured-on/launchpadly.svg',
  },
  // PeerPush grants its "Verified" badge only for a link back to the product page.
  // Wordmark lifted from https://peerpush.com/logo.svg, square dropped so it reads in both themes.
  {
    name: 'PeerPush',
    href: 'https://peerpush.com/p/zush',
    iconSvg:
      'M718.48 342.94C710.72 339.91 702.74 337.38 694.49 335.46C675.07 253.81 601.55 192.89 514.07 192.89H234.27V432.9V563.75V806.57V878.1H305.8H371.83H443.36V806.57V701.31H651.62C753.85 701.31 837.05 618.12 837.05 515.88C837.06 437.2 787.81 369.8 718.48 342.94ZM305.81 264.43H514.07C559.74 264.43 599.25 291.5 617.4 330.46C624.17 345.04 627.96 361.27 627.96 378.33C627.96 386.42 627.14 394.34 625.48 401.99C614.59 453.49 568.75 492.23 514.06 492.23H443.35V401.99H602.81C604.9 394.45 605.95 386.47 605.95 378.33C605.95 360.83 601 344.38 592.47 330.46H371.83V492.23H305.8V432.92V264.43H305.81ZM651.63 629.78H443.36V585.76H371.83V637.87V701.31V806.57H305.8V563.75H371.83H443.36H514.07C605.08 563.75 681.01 497.83 696.58 411.22C703.68 414.3 710.45 418.04 716.72 422.5C746.21 443.08 765.53 477.25 765.53 515.87C765.53 578.72 714.41 629.78 651.63 629.78Z',
    iconViewBox: '234 192 604 687',
  },
  // Startup Fame's free "Verified" listing requires their own badge on the homepage,
  // and their verification bot looks for that exact image, so this row carries the
  // real badge instead of a styled chip. Themed pair, same idea as ThemedScreenshot.
  {
    name: 'Startup Fame',
    href: 'https://startupfa.me/s/zush?utm_source=zushapp.com',
    badge: {
      light: 'https://startupfa.me/badge?t=small&theme=default',
      dark: 'https://startupfa.me/badge?t=small&theme=dark',
      alt: 'Zush - Featured on Startup Fame',
      width: 240,
      height: 36,
    },
  },
  {
    name: 'winget',
    href: 'https://winstall.app/apps/Lirikpro.Zush',
    icon: '/images/featured-on/winstall.png',
  },
  {
    name: 'Stork.AI',
    href: 'https://www.stork.ai/en/zush',
    icon: '/images/featured-on/stork.png',
  },
  {
    name: 'ProductDirs',
    href: 'https://productdirs.com/projects/zush',
    icon: '/images/featured-on/productdirs.svg',
  },
  {
    name: 'MacApp.Supply',
    href: 'https://macapp.supply/app/zush',
    icon: '/images/featured-on/macapp-supply.png',
  },
  {
    name: 'Submit AI Tools',
    href: 'https://submitaitools.org/zushapp-com/',
    icon: '/images/featured-on/submit-ai-tools.png',
  },
];

const { locale = DEFAULT_LOCALE } = Astro.props as Props;
const title = titleByLocale[locale] ?? titleByLocale.en!;
---

<section class={styles.FeaturedOn} aria-labelledby='featured-on-title'>
  <div class={styles.FeaturedOn__Container}>
    <h2 id='featured-on-title' class={styles.FeaturedOn__Title}>{title}</h2>

    <div class={styles.FeaturedOn__Items}>
      {catalogs.map((catalog) => (
        <a
          href={catalog.href}
          class={`${styles.FeaturedOnItem} ${catalog.modifier ?? ''}`}
          target='_blank'
          rel={catalog.rel ?? (catalog.nofollow ? 'nofollow noopener noreferrer' : 'noopener noreferrer')}
        >
          {catalog.badge ? (
            (['light', 'dark'] as const).map((badgeTheme) => (
              <img
                data-badge-theme={badgeTheme}
                class={styles.FeaturedOnItem__Badge}
                src={catalog.badge![badgeTheme]}
                alt={catalog.badge!.alt}
                width={catalog.badge!.width}
                height={catalog.badge!.height}
                loading='lazy'
                decoding='async'
              />
            ))
          ) : catalog.name === 'Product Hunt' ? (
            <span class={styles.FeaturedOnItem__Icon}>
              <svg width='26' height='26' viewBox='0 0 24 24' fill='currentColor' aria-hidden='true'>
                <path d='M13.604 8.4h-3.405V12h3.405a1.8 1.8 0 0 0 0-3.6zM12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zm1.604 14.4h-3.405V18H7.801V6h5.804a4.2 4.2 0 0 1 0 8.4z' />
              </svg>
            </span>
          ) : catalog.iconSvg ? (
            <span class={styles.FeaturedOnItem__Icon}>
              <svg width='24' height='24' viewBox={catalog.iconViewBox} fill='currentColor' fill-rule='evenodd' aria-hidden='true'>
                <path d={catalog.iconSvg} />
              </svg>
            </span>
          ) : (
            <img
              class={styles.FeaturedOnItem__Logo}
              src={catalog.icon}
              alt=''
              aria-hidden='true'
              width='26'
              height='26'
              loading='lazy'
              decoding='async'
            />
          )}
          {!catalog.badge && <span class={styles.FeaturedOnItem__Label}>{catalog.name}</span>}
        </a>
      ))}
    </div>
  </div>
</section>
