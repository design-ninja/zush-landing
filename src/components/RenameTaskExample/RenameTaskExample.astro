---
import { ChevronDown, Copy } from 'lucide-react';
import DownloadButton from '@/components/DownloadButton/DownloadButton';
import type { RenameTaskExample } from '@/data/renameTaskExamples';
interface Props { example: RenameTaskExample; }
const { example } = Astro.props;
const headingId = `rename-task-${example.id}`;
---
<section class="rename-task" data-rename-task={example.id} aria-labelledby={headingId}>
  <p class="eyebrow">Workflow example</p>
  <h2 id={headingId}>{example.title}</h2>
  <p class="intro">{example.intro}</p>
  <figure>
    <div class="names">
      <span class="label">Original filename</span>
      <code class="before">{example.before}</code>
      <span class="label">Example new filename</span>
      <code class="after">{example.after}</code>
    </div>
    <figcaption>{example.evidence}</figcaption>
  </figure>
  <details>
    <summary><span>Use the {example.templateName} template</span><ChevronDown size={20} className="chevron" aria-hidden="true" /></summary>
    <div class="details-body">
      <p>Open <strong>Templates</strong> in Zush, create a template named <strong>{example.templateName}</strong>, and use these instructions in its <a href="/docs/custom-prompts">custom prompt</a>. Save it, generate names for a small batch, and review before applying.</p>
      <div class="prompt">
        <p data-task-prompt>{example.prompt}</p>
        <button type="button" data-task-copy><Copy size={16} aria-hidden="true" />Copy template instructions</button>
        <span data-task-status role="status" aria-live="polite"></span>
      </div>
    </div>
  </details>
  <p class="limitation">{example.limitation}</p>
  <p class="links"><a href={example.guideHref}>{example.guideLabel}</a><span aria-hidden="true">·</span><a href="/docs/templates">How to save a Template</a></p>
  <div class="trial">
    <strong>Try this workflow free — 50 renames</strong>
    <div class="downloads">
      <DownloadButton client:visible source="workflow-example" forceOS="mac" showDropdown={false} includeOtherOS={false} label="Mac — 50 free renames" size="md" />
      {!example.macOnly && <DownloadButton client:visible source="workflow-example" forceOS="windows" showDropdown={false} includeOtherOS={false} label="Windows — 50 free renames" size="md" />}
    </div>
    <p>No signup or credit card required. Preview the names before applying them.</p>
  </div>
</section>
<script>
  import { trackAnalyticsEvent } from '@/utils/analytics';
  const bindTaskCopies = () => {
    document.querySelectorAll<HTMLElement>('[data-rename-task]').forEach((root) => {
      const button = root.querySelector<HTMLButtonElement>('[data-task-copy]');
      const status = root.querySelector<HTMLElement>('[data-task-status]');
      const prompt = root.querySelector<HTMLElement>('[data-task-prompt]');
      if (!button || !status || !prompt || button.dataset.bound) return;
      button.dataset.bound = 'true';
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(prompt.textContent?.trim() ?? '');
          status.textContent = 'Copied. Paste into your Template’s custom prompt in Zush.';
          trackAnalyticsEvent('copy_naming_template', { page_path: window.location.pathname, template_id: root.dataset.renameTask, placement: 'workflow-example' });
        } catch {
          status.textContent = 'Copy unavailable. Select the instructions above and copy them manually.';
        }
      });
    });
  };
  bindTaskCopies();
  document.addEventListener('astro:after-swap', bindTaskCopies);
</script>
<style>
  .rename-task { width: min(50rem, calc(100% - 2.5rem)); margin: 3rem auto; padding: 2rem; border: 1px solid var(--border); border-radius: 1.5rem; background: var(--muted); color: var(--foreground); }
  .eyebrow { display: inline-flex; margin: 0 0 .75rem; padding: .35rem .85rem; border-radius: 9999px; background: var(--primary-soft); color: var(--primary); font-size: .75rem; font-weight: 600; line-height: 1.4; text-transform: uppercase; }
  h2 { margin: 0 0 .75rem; font-family: var(--font-family-heading); font-size: clamp(1.5rem, 3vw, 1.85rem); font-weight: 600; font-variation-settings: 'opsz' 32; line-height: 1.2; text-wrap: balance; scroll-margin-top: 7rem; }
  p, figcaption { margin: 0; color: var(--muted-foreground); line-height: 1.6; }
  .intro { font-size: 1rem; }
  figure { margin: 1.5rem 0 0; }
  .names { display: grid; gap: .15rem; padding: 1rem 1.25rem; border: 1px solid var(--border); border-radius: 1rem; background: var(--card); }
  .label { font-size: .7rem; font-weight: 500; color: var(--muted-foreground); }
  .label:nth-of-type(2) { margin-top: .6rem; }
  code { font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace; overflow-wrap: anywhere; line-height: 1.45; }
  .before { font-size: .8rem; color: var(--muted-foreground); text-decoration: line-through; }
  .after { font-size: .92rem; font-weight: 600; color: var(--foreground); }
  figcaption { font-size: .8125rem; margin-top: .75rem; }
  details { margin: 1.5rem 0 0; background: var(--card); outline: 1px solid var(--border); border-radius: 1rem; overflow: hidden; transition: outline .3s ease; }
  details[open] { outline: 3px solid var(--primary); }
  summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.1rem 1.25rem; font-weight: 600; line-height: 1.4; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary:focus-visible { outline: 2px solid var(--primary); outline-offset: -2px; border-radius: 1rem; }
  summary :global(.chevron) { flex-shrink: 0; color: var(--muted-foreground); transition: transform .3s ease; }
  details[open] summary :global(.chevron) { transform: rotate(180deg); color: var(--primary); }
  .details-body { display: grid; gap: 1rem; padding: 0 1.25rem 1.25rem; font-size: .92rem; }
  .details-body strong { color: var(--foreground); font-weight: 600; }
  .prompt { display: grid; gap: .75rem; justify-items: start; padding: 1rem; border: 1px solid var(--border); border-radius: .75rem; background: var(--muted); }
  .prompt p { color: var(--foreground); font-size: .88rem; }
  button { display: inline-flex; align-items: center; gap: .45rem; font: inherit; font-size: .85rem; font-weight: 500; cursor: pointer; border: 0; border-radius: 9999px; padding: .55rem 1rem; color: var(--primary); background: var(--primary-soft); }
  button:focus-visible { outline: 2px solid var(--primary); outline-offset: 3px; }
  [data-task-status] { display: block; font-size: .85rem; color: var(--muted-foreground); }
  [data-task-status]:empty { display: none; }
  a { color: var(--primary); font-weight: var(--font-weight-link); text-underline-offset: .2em; }
  a:hover { text-decoration: underline; }
  .limitation { margin-top: 1.25rem; font-size: .875rem; }
  .links { display: flex; flex-wrap: wrap; align-items: baseline; gap: .35rem .6rem; margin-top: .75rem; font-size: .92rem; }
  .links span { color: var(--muted-foreground); }
  .trial { display: grid; gap: .85rem; border-top: 1px solid var(--border); margin-top: 1.5rem; padding-top: 1.5rem; }
  .trial strong { font-weight: 600; }
  .downloads { display: flex; flex-wrap: wrap; gap: .75rem; }
  .trial p { font-size: .8125rem; }
  @media (max-width: 768px) { .rename-task { padding: 1.25rem; margin-block: 2rem; } }
  :global(.markdown-content) .rename-task { width: 100%; margin: 2rem 0; }
  :global(.markdown-content) .rename-task h2 { margin-top: 0; }
  :global(.markdown-content) .rename-task p { margin: 0; }
  :global(.markdown-content) .rename-task .limitation { margin-top: 1.25rem; }
  :global(.markdown-content) .rename-task .links { margin-top: .75rem; }
</style>
