---
import { Image } from 'astro:assets';
import accountantImage from '@/assets/landing/accountants-hero.webp';
import hrImage from '@/assets/landing/hr-hero.webp';
import legalImage from '@/assets/landing/legal-hero.webp';
import medicalImage from '@/assets/landing/medical-hero.webp';
import photographerImage from '@/assets/landing/photographers-hero.webp';
import realEstateImage from '@/assets/landing/real-estate-hero.webp';
import Heading from '@/components/Heading';
import Text from '@/components/Text';
import styles from './HomeProfessions.module.scss';
import { getLocalizedPath, type Locale } from '@/i18n/config';
import type { HomeCopy } from '@/i18n/copy';
import type { ProfessionKey, ProfessionLocaleCopy } from '@/i18n/professions/types';

interface Props {
  locale?: Locale;
  homeCopy?: HomeCopy;
  professionCopy?: ProfessionLocaleCopy;
}

const { locale = 'en', homeCopy, professionCopy } = Astro.props as Props;

// English source cards; localized homepages replace these with locale-owned
// profession titles, descriptions, routes, and image alternatives below.
const PROFESSIONS: Array<{
  title: string;
  description: string;
  route: string;
  image: typeof accountantImage;
  imageAlt: string;
}> = [
  {
    title: 'Accountants & bookkeepers',
    description: 'Invoices, receipts, and statements named by vendor, date, number, and amount — ready for reconciliation.',
    route: '/for-accountants',
    image: accountantImage,
    imageAlt: 'Accountant reviewing client documents beside a desktop computer',
  },
  {
    title: 'Medical practices',
    description: 'Scanned records named by identifier, date of service, and record type — with a local AI mode, so files never leave the machine.',
    route: '/for-medical',
    image: medicalImage,
    imageAlt: 'Physician organizing medical records at a desktop computer',
  },
  {
    title: 'Legal teams',
    description: 'Filings, contracts, and correspondence named by matter, date, type, and party — the folder reads as the case chronology.',
    route: '/for-legal',
    image: legalImage,
    imageAlt: 'Attorney reviewing legal documents at a desktop computer',
  },
  {
    title: 'HR & people teams',
    description: 'Candidate, onboarding, review, and policy files named by employee, date, type, role, period, and status.',
    route: '/for-hr',
    image: hrImage,
    imageAlt: 'HR professionals reviewing onboarding documents in a modern office',
  },
  {
    title: 'Photographers & videographers',
    description: 'RAW photos, clips, and exports named by project, date, subject, scene, and take — from ingest to archive.',
    route: '/for-photographers',
    image: photographerImage,
    imageAlt: 'Photographer and videographer reviewing a shoot together in a studio',
  },
  {
    title: 'Real estate teams',
    description: 'Agreements, disclosures, inspections, appraisals, and property photos named by address, date, type, party, and status.',
    route: '/for-real-estate',
    image: realEstateImage,
    imageAlt: 'Real estate professional reviewing transaction documents at a laptop',
  },
];

const professionImages = {
  accountants: accountantImage,
  medical: medicalImage,
  photographers: photographerImage,
  legal: legalImage,
  hr: hrImage,
  'real-estate': realEstateImage,
} as const;
const professionOrder: ProfessionKey[] = ['accountants', 'medical', 'legal', 'hr', 'photographers', 'real-estate'];
const localizedProfessions = professionCopy
  ? professionOrder.map((key) => {
      const page = professionCopy[key];
      return {
        title: page.pageTitle,
        description: page.seo.description,
        route: getLocalizedPath(page.path, locale),
        image: professionImages[key],
        imageAlt: page.hero.photoAlt,
      };
    })
  : null;
const professions = localizedProfessions ?? PROFESSIONS;
const professionEyebrows: Record<Locale, string> = {
  en: 'Who it’s for',
  fr: 'Pour les professionnels',
  de: 'Für Profis',
  es: 'Para profesionales',
  'pt-br': 'Para profissionais',
  it: 'Per i professionisti',
  nl: 'Voor professionals',
  tr: 'Profesyoneller için',
  ja: 'プロフェッショナル向け',
  ko: '전문가를 위한',
  'zh-cn': '面向专业人士',
  ar: 'للمحترفين',
};
const eyebrow = professionEyebrows[locale];
const title = locale === 'en' ? 'Built for people who work with files all day' : homeCopy?.useCasesTitle;
const description = locale === 'en'
  ? 'Every profession has its own naming convention. Zush reads each file and fills the structure you choose — without changing the folders or tools you already use.'
  : homeCopy?.useCasesDescription;
---

<section class={styles.Professions} aria-labelledby="home-professions-title">
  <div class={styles.Professions__Container}>
    <div class={styles.Professions__Intro}>
      <p class={styles.Professions__Eyebrow}>{eyebrow}</p>
      <Heading
        as="h2"
        id="home-professions-title"
        className={styles.Professions__Title}
      >
        {title}
      </Heading>
      <Text
        as="p"
        size="lg"
        color="subtle"
        className={styles.Professions__Description}
      >
        {description}
      </Text>
    </div>

    <div class={styles.Professions__List}>
      {professions.map(({ title, description, route, image, imageAlt }) => (
        <a class={styles.Profession} href={route}>
          <div class={styles.Profession__Media}>
            <Image
              class={styles.Profession__Image}
              src={image}
              alt={imageAlt}
              widths={[224, 352, 528]}
              sizes="(max-width: 640px) 7rem, (max-width: 1024px) 10rem, 11rem"
              format="webp"
              quality={78}
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class={styles.Profession__Content}>
            <Heading as="h3" size="h4" className={styles.Profession__Title}>
              {title}
            </Heading>
            <Text className={styles.Profession__Description}>{description}</Text>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
