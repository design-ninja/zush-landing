---
import RenameTaskExample from '@/components/RenameTaskExample/RenameTaskExample.astro';
import { RENAME_TASK_EXAMPLES } from '@/data/renameTaskExamples';
import Breadcrumbs from '@/components/Breadcrumbs';
import ComparisonTable from '@/components/ComparisonTable/ComparisonTable.astro';
import PillLink from '@/components/PillLink';
import Features from '@/components/Features/Features.astro';
import WaysToRun from '@/components/Features/WaysToRun.astro';
import Heading from '@/components/Heading';
import SectionHeader from '@/components/SectionHeader';
import Hero from '@/components/Hero';
import HeroWave from '@/components/HeroWave/HeroWave.astro';
import DemoVideo from '@/components/DemoVideo/DemoVideo.astro';
import {
  FOLDER_SORTING_DEMO_VIDEO,
  WINDOWS_FOLDER_SORTING_DEMO_VIDEO,
  type DemoVideoAsset,
} from '@/data/showcaseMedia';
import Pricing from '@/components/Pricing/Pricing.astro';
import SupportedFormats from '@/components/SupportedFormats';
import Tour from '@/components/Tour';
import DownloadCTA from '@/components/DownloadCTA/DownloadCTA.astro';
import CrossPlatformBanner from '@/components/CrossPlatformBanner/CrossPlatformBanner.astro';
import TrustSignals from '@/components/TrustSignals';
import type { FeatureLandingPageProps } from './FeatureLandingPage';
import { getPdfDeepDiveCopy } from '@/data/pdfDeepDive';
import FeatureFAQ from './FeatureFAQ';
import { PRODUCT_FACTS_REVIEWED_AT } from '@/constants';
import TaskWorkflow from './TaskWorkflow.astro';
import LandingWorkflow from './LandingWorkflow.astro';
import PdfScenarios from './PdfScenarios.astro';
import { getLandingWorkflow } from '@/data/landingWorkflows';
import {
  DEFAULT_LOCALE,
  getLocalesForRoute,
  getLocalizedPath,
  isLocalizedRoute,
  stripLocaleFromPath,
  type Locale,
} from '@/i18n/config';
import { getCopy, type FeatureCopy } from '@/i18n/copy';
import {
  MICROSOFT_STORE_RATED_ON_LABELS,
  MICROSOFT_STORE_RATING_ARIA_LABELS,
} from '@/i18n/microsoftStoreRating';
import { SOFTPEDIA_RATED_BY_LABELS, SOFTPEDIA_REVIEW_ARIA_LABELS } from '@/i18n/softpediaReview';
import macChangelogSource from '@/content/changelog.md?raw';
import windowsChangelogSource from '@/content/changelog.windows.md?raw';
import { parseLatestVersion } from '@/utils/version';
import styles from './FeatureLandingPage.module.scss';
import b from '@/components/Blocks/Blocks.module.scss';
import faq from '@/components/FAQ/FAQ.module.scss';

interface LocalizedProps {
  locale?: Locale;
  localizedCopy?: FeatureCopy;
  localizedBlogPosts?: Array<{ title: string; href: string }>;
  localizedContextualGuideLink?: FeatureLandingPageProps['contextualGuideLink'];
}

const {
  h1,
  h1Accent,
  definitionText,
  showcaseSlides,
  faqItems,
  relatedBlogPosts,
  relatedPages,
  contextualGuideLink,
  directAnswerSection,
  comparison,
  forceOS,
  category = 'general',
} = Astro.props as FeatureLandingPageProps & LocalizedProps;

const localizedProps = Astro.props as FeatureLandingPageProps & LocalizedProps;
const currentLocale = localizedProps.locale ?? DEFAULT_LOCALE;
const currentCopy = getCopy(currentLocale);
const pageCopy = localizedProps.localizedCopy;
const guideLinks = localizedProps.localizedBlogPosts
  ?? (currentLocale === DEFAULT_LOCALE
    ? relatedBlogPosts.map((post) => ({ ...post, href: `/blog/${post.href}` }))
    : []);
const resolvedContextualGuideLink = localizedProps.localizedContextualGuideLink
  ?? (currentLocale === DEFAULT_LOCALE ? contextualGuideLink : undefined);
// English-only answers stay off localized pages unless a translation is provided.
const resolvedDirectAnswerSection = pageCopy?.directAnswerSection
  ?? (currentLocale === DEFAULT_LOCALE ? directAnswerSection : undefined);
const heroSlides = pageCopy?.showcaseSlides ?? (currentLocale === DEFAULT_LOCALE ? showcaseSlides : currentCopy.home.showcaseSlides);
const breadcrumbItems = [
  { label: currentLocale === DEFAULT_LOCALE ? 'Home' : 'Zush', href: getLocalizedPath('/', currentLocale) },
  { label: pageCopy?.h1 ?? h1 },
];
const shouldRenderPdfDeepDive = category === 'pdf';
const pdfDeepDive = getPdfDeepDiveCopy(currentLocale);
const { route: currentRoute } = stripLocaleFromPath(Astro.url.pathname);
const taskExample = currentLocale === DEFAULT_LOCALE ? RENAME_TASK_EXAMPLES[currentRoute] : undefined;
const landingWorkflow = getLandingWorkflow(currentRoute, currentLocale);
const showPdfScenariosEarly = currentRoute === '/rename-pdf-with-ai';
// Pages about sorting show the sorting block inside the features block.
const sortingRoute = ['/ai-file-organizer', '/ai-file-sorter', '/hazel-alternative'].includes(currentRoute);
// Routes with a recording of their own get the homepage hero layout: a centered
// intro over the point wave with the demo video below it, instead of the slides.
const HERO_DEMO_VIDEOS: Record<string, { mac: DemoVideoAsset; windows?: DemoVideoAsset; subtitle?: string }> = {
  '/ai-file-sorter': {
    mac: FOLDER_SORTING_DEMO_VIDEO,
    windows: WINDOWS_FOLDER_SORTING_DEMO_VIDEO,
    subtitle: 'Describe your folders in plain language or let Auto group files by content. Zush reads, renames, and moves each file after you review the plan.',
  },
  '/ai-file-organizer': {
    mac: FOLDER_SORTING_DEMO_VIDEO,
    windows: WINDOWS_FOLDER_SORTING_DEMO_VIDEO,
    subtitle: 'Zush reads each file, gives it a searchable name, and sorts it into folders on Mac and Windows. Review every batch first; undo restores names and folders.',
  },
  // forceOS is 'mac' on this page, so it never switches to the Windows recording.
  '/hazel-alternative': {
    mac: FOLDER_SORTING_DEMO_VIDEO,
    subtitle: 'Hazel runs the conditions you write. Zush reads what each file shows, names it, and sorts it by rules you describe in plain language.',
  },
};
const heroDemoVideo = HERO_DEMO_VIDEOS[currentRoute];
const macVersion = parseLatestVersion(macChangelogSource) ?? undefined;
const windowsVersion = parseLatestVersion(windowsChangelogSource) ?? undefined;
const relatedPageHref = (href: string) =>
  isLocalizedRoute(href) && getLocalesForRoute(href).includes(currentLocale)
    ? getLocalizedPath(href, currentLocale)
    : href;
const relatedPageTitle = (href: string, fallback: string) =>
  isLocalizedRoute(href) ? currentCopy.featurePages[href]?.h1 ?? fallback : fallback;
---

<Breadcrumbs items={breadcrumbItems} align={heroDemoVideo ? 'center' : 'start'} />
<article class={styles.Page}>
  {heroDemoVideo ? (
    <>
      <HeroWave>
        <Hero
          as='header'
          forceOS={forceOS}
          title={pageCopy?.h1 ?? h1}
          titleAccent={pageCopy?.accent ?? h1Accent}
          subtitle={pageCopy?.definitionText ?? heroDemoVideo.subtitle ?? definitionText}
          compactTopSpacing
          buyLabel={currentCopy.home.buyPro}
          downloadLabel={taskExample ? 'Try free — 50 renames' : currentCopy.header.download}
          downloadMenu={currentCopy.downloadMenu}
          trustSignals={currentCopy.home.trustSignals}
          macVersion={macVersion}
          windowsVersion={windowsVersion}
          softpediaRatedByLabel={SOFTPEDIA_RATED_BY_LABELS[currentLocale]}
          softpediaReviewAriaLabel={SOFTPEDIA_REVIEW_ARIA_LABELS[currentLocale]}
          microsoftStoreRatedOnLabel={MICROSOFT_STORE_RATED_ON_LABELS[currentLocale]}
          microsoftStoreRatingAriaLabel={MICROSOFT_STORE_RATING_ARIA_LABELS[currentLocale]}
          client:visible
          centered
          splitByOS={!forceOS}
          waveBackground
        />
      </HeroWave>
      <DemoVideo
        label={pageCopy?.h1 ?? h1}
        media={heroDemoVideo.mac}
        windowsMedia={forceOS === 'mac' ? undefined : heroDemoVideo.windows}
      />
    </>
  ) : (
    <Hero
      as='header'
      forceOS={forceOS}
      title={pageCopy?.h1 ?? h1}
      titleAccent={pageCopy?.accent ?? h1Accent}
      subtitle={pageCopy?.definitionText ?? definitionText}
      slides={heroSlides}
      compactTopSpacing
      buyLabel={currentCopy.home.buyPro}
      downloadLabel={taskExample ? 'Try free — 50 renames' : currentCopy.header.download}
      downloadMenu={currentCopy.downloadMenu}
      trustSignals={currentCopy.home.trustSignals}
      macVersion={macVersion}
      windowsVersion={windowsVersion}
      softpediaRatedByLabel={SOFTPEDIA_RATED_BY_LABELS[currentLocale]}
      softpediaReviewAriaLabel={SOFTPEDIA_REVIEW_ARIA_LABELS[currentLocale]}
      microsoftStoreRatedOnLabel={MICROSOFT_STORE_RATED_ON_LABELS[currentLocale]}
      microsoftStoreRatingAriaLabel={MICROSOFT_STORE_RATING_ARIA_LABELS[currentLocale]}
      client:visible
    />
  )}

  {taskExample && !(currentLocale === DEFAULT_LOCALE && ['/rename-pdf-with-ai', '/rename-audio-with-ai'].includes(currentRoute)) && <RenameTaskExample example={taskExample} />}

  {landingWorkflow && !(currentLocale === DEFAULT_LOCALE && currentRoute === '/rename-pdf-with-ai') && <LandingWorkflow workflow={landingWorkflow} />}

  {currentLocale === DEFAULT_LOCALE && ['/rename-pdf-with-ai', '/rename-videos-with-ai', '/rename-audio-with-ai'].includes(Astro.url.pathname) && (
    <TaskWorkflow
      category={category}
      forceOS={forceOS}
      downloadLabel={currentCopy.header.download}
      downloadMenu={currentCopy.downloadMenu}
    />
  )}

  {showPdfScenariosEarly && <PdfScenarios copy={pdfDeepDive} locale={currentLocale} showReviewNote />}

  <Tour copy={currentCopy.home.showcase} />
  <Features title={currentCopy.home.featuresTitle} description={currentCopy.home.featuresDescription} copy={currentCopy.home.featureCards} locale={currentLocale} sorting={sortingRoute} sorterLink={false} />
  <WaysToRun copy={currentCopy.home.featureCards} />
  <SupportedFormats
    category={category}
    title={currentCopy.home.supportedFormats}
    imagesLabel={currentCopy.home.images}
    designLabel={currentCopy.home.designLabel}
    documentsLabel={currentCopy.home.documents}
    videosLabel={currentCopy.home.videosLabel}
    audioLabel={currentCopy.home.audioLabel}
  />
  <DownloadCTA
    forceOS={forceOS}
    title={currentCopy.home.downloadTitle}
    subtitle={currentCopy.home.downloadSubtitle}
    hintPrefix={currentCopy.home.downloadHintPrefix}
    downloadLabel={currentCopy.header.download}
    downloadMenu={currentCopy.downloadMenu}
  />
  <CrossPlatformBanner locale={currentLocale} />

  {currentLocale === DEFAULT_LOCALE && comparison && (
    <ComparisonTable {...comparison} />
  )}

  {shouldRenderPdfDeepDive && (
    <>
      {!showPdfScenariosEarly && <PdfScenarios copy={pdfDeepDive} locale={currentLocale} />}

      <section class={b.Section}>
        <SectionHeader
          eyebrow={pdfDeepDive.comparisonEyebrow}
          title={pdfDeepDive.comparisonTitle}
          description={pdfDeepDive.comparisonIntro}
        />

        <div class:list={[b.Table, styles.PdfComparisonTable]}>
          <div class:list={[b.TableRow, b.TableRow_head]}>
            <span>{pdfDeepDive.comparisonHeaders?.tool ?? 'Tool'}</span>
            <span>{pdfDeepDive.comparisonHeaders?.bestFor ?? 'Best for'}</span>
            <span>{pdfDeepDive.comparisonHeaders?.gap ?? 'Filename gap'}</span>
          </div>
          {pdfDeepDive.comparisonRows.map((row) => (
            <div class={b.TableRow}>
              <strong>{row.tool}</strong>
              <span>{row.bestFor}</span>
              <span>{row.gap}</span>
            </div>
          ))}
        </div>
      </section>
    </>
  )}

  {resolvedContextualGuideLink && (
    <div class={styles.ContextualGuideLink}>
      <p>
        {resolvedContextualGuideLink.before}{' '}
        <a href={resolvedContextualGuideLink.href}>{resolvedContextualGuideLink.label}</a>{' '}
        {resolvedContextualGuideLink.after ?? ''}
      </p>
    </div>
  )}

  {resolvedDirectAnswerSection && !landingWorkflow && (
    <section class={b.Section}>
      <SectionHeader
        title={resolvedDirectAnswerSection.heading}
        description={resolvedDirectAnswerSection.answer}
      />
      <ol class={styles.Steps}>
        {resolvedDirectAnswerSection.steps.map((step) => <li>{step}</li>)}
      </ol>
    </section>
  )}

  <section id='faq' class={faq.FAQ}>
    <div class={faq.FAQ__Container}>
      <SectionHeader title={pageCopy?.faqTitle ?? 'Frequently Asked Questions'} />
      <FeatureFAQ faqItems={pageCopy?.faqItems ?? faqItems} />
      {currentLocale === DEFAULT_LOCALE && (
        <p class={styles.FactsReviewed}>
          Product facts checked <time datetime={PRODUCT_FACTS_REVIEWED_AT}>{new Date(`${PRODUCT_FACTS_REVIEWED_AT}T00:00:00Z`).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</time>.
        </p>
      )}
    </div>
  </section>

  <Pricing copy={currentCopy.pricing} />
  {currentLocale === DEFAULT_LOCALE && <TrustSignals />}

  {(relatedPages.length > 0 || guideLinks.length > 0) && (
    <section class={b.Section}>
      <div class={b.Columns}>
        {relatedPages.length > 0 && (
          <div class={b.Column}>
            <Heading as='h3' className={b.ColumnTitle}>
              {pageCopy?.relatedToolsTitle ?? 'Related Tools'}
            </Heading>
            <div class={styles.RelatedLinks}>
              {relatedPages.map((page) => (
                <PillLink href={relatedPageHref(page.href)} withArrow>{relatedPageTitle(page.href, page.title)}</PillLink>
              ))}
            </div>
          </div>
        )}

        {guideLinks.length > 0 && (
          <div class={b.Column}>
            <Heading as='h3' className={b.ColumnTitle}>
              {pageCopy?.relatedGuidesTitle ?? 'Related Guides'}
            </Heading>
            <div class={styles.RelatedLinks}>
              {guideLinks.map((post) => (
                <PillLink href={post.href} withArrow>{post.title}</PillLink>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  )}
</article>
