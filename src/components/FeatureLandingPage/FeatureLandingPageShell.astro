---
import Breadcrumbs from '@/components/Breadcrumbs';
import ComparisonTable from '@/components/ComparisonTable/ComparisonTable.astro';
import PillLink from '@/components/PillLink';
import Features from '@/components/Features/Features.astro';
import Heading from '@/components/Heading';
import Hero from '@/components/Hero';
import Pricing from '@/components/Pricing/Pricing.astro';
import SupportedFormats from '@/components/SupportedFormats';
import Tour from '@/components/Tour';
import DownloadCTA from '@/components/DownloadCTA/DownloadCTA.astro';
import CrossPlatformBanner from '@/components/CrossPlatformBanner/CrossPlatformBanner.astro';
import TrustSignals from '@/components/TrustSignals';
import type { FeatureLandingPageProps } from './FeatureLandingPage';
import { getPdfDeepDiveCopy } from '@/data/pdfDeepDive';
import FeatureFAQ from './FeatureFAQ';
import LandingWorkflow from './LandingWorkflow.astro';
import PdfScenarios from './PdfScenarios.astro';
import { getLandingWorkflow } from '@/data/landingWorkflows';
import {
  DEFAULT_LOCALE,
  getLocalesForRoute,
  getLocalizedPath,
  isLocalizedRoute,
  stripLocaleFromPath,
  type Locale,
} from '@/i18n/config';
import { getCopy, type FeatureCopy } from '@/i18n/copy';
import {
  MICROSOFT_STORE_RATED_ON_LABELS,
  MICROSOFT_STORE_RATING_ARIA_LABELS,
} from '@/i18n/microsoftStoreRating';
import { SOFTPEDIA_RATED_BY_LABELS, SOFTPEDIA_REVIEW_ARIA_LABELS } from '@/i18n/softpediaReview';
import macChangelogSource from '@/content/changelog.md?raw';
import windowsChangelogSource from '@/content/changelog.windows.md?raw';
import { parseLatestVersion } from '@/utils/version';
import styles from './FeatureLandingPage.module.scss';

interface LocalizedProps {
  locale?: Locale;
  localizedCopy?: FeatureCopy;
}

const {
  h1,
  h1Accent,
  definitionText,
  showcaseSlides,
  faqItems,
  relatedBlogPosts,
  relatedPages,
  contextualGuideLink,
  directAnswerSection,
  comparison,
  forceOS,
  category = 'general',
} = Astro.props as FeatureLandingPageProps & LocalizedProps;

const localizedProps = Astro.props as FeatureLandingPageProps & LocalizedProps;
const currentLocale = localizedProps.locale ?? DEFAULT_LOCALE;
const currentCopy = getCopy(currentLocale);
const pageCopy = localizedProps.localizedCopy;
const resolvedDirectAnswerSection = pageCopy?.directAnswerSection ?? directAnswerSection;
const heroSlides = pageCopy?.showcaseSlides ?? (currentLocale === DEFAULT_LOCALE ? showcaseSlides : currentCopy.home.showcaseSlides);
const breadcrumbItems = [
  { label: currentLocale === DEFAULT_LOCALE ? 'Home' : 'Zush', href: getLocalizedPath('/', currentLocale) },
  { label: pageCopy?.h1 ?? h1 },
];
const shouldRenderPdfDeepDive = category === 'pdf';
const pdfDeepDive = getPdfDeepDiveCopy(currentLocale);
const { route: currentRoute } = stripLocaleFromPath(Astro.url.pathname);
const landingWorkflow = getLandingWorkflow(currentRoute, currentLocale);
const showPdfScenariosEarly = currentRoute === '/rename-pdf-with-ai';
const macVersion = parseLatestVersion(macChangelogSource) ?? undefined;
const windowsVersion = parseLatestVersion(windowsChangelogSource) ?? undefined;
const relatedPageHref = (href: string) =>
  isLocalizedRoute(href) && getLocalesForRoute(href).includes(currentLocale)
    ? getLocalizedPath(href, currentLocale)
    : href;
const relatedPageTitle = (href: string, fallback: string) =>
  isLocalizedRoute(href) ? currentCopy.featurePages[href]?.h1 ?? fallback : fallback;
---

<Breadcrumbs items={breadcrumbItems} />
<article class={styles.Page}>
  <Hero
    as='header'
    forceOS={forceOS}
    title={pageCopy?.h1 ?? h1}
    titleAccent={pageCopy?.accent ?? h1Accent}
    subtitle={pageCopy?.definitionText ?? definitionText}
    slides={heroSlides}
    compactTopSpacing
    buyLabel={currentCopy.home.buyPro}
    downloadLabel={currentCopy.header.download}
    downloadMenu={currentCopy.downloadMenu}
    trustSignals={currentCopy.home.trustSignals}
    macVersion={macVersion}
    windowsVersion={windowsVersion}
    softpediaRatedByLabel={SOFTPEDIA_RATED_BY_LABELS[currentLocale]}
    softpediaReviewAriaLabel={SOFTPEDIA_REVIEW_ARIA_LABELS[currentLocale]}
    microsoftStoreRatedOnLabel={MICROSOFT_STORE_RATED_ON_LABELS[currentLocale]}
    microsoftStoreRatingAriaLabel={MICROSOFT_STORE_RATING_ARIA_LABELS[currentLocale]}
    client:visible
  />

  {landingWorkflow && <LandingWorkflow workflow={landingWorkflow} />}

  {showPdfScenariosEarly && <PdfScenarios copy={pdfDeepDive} locale={currentLocale} showReviewNote />}

  <Tour client:visible copy={currentCopy.home.showcase} />
  <Features title={currentCopy.home.featuresTitle} description={currentCopy.home.featuresDescription} copy={currentCopy.home.featureCards} locale={currentLocale} />
  <SupportedFormats
    category={category}
    title={currentCopy.home.supportedFormats}
    imagesLabel={currentCopy.home.images}
    designLabel={currentCopy.home.designLabel}
    documentsLabel={currentCopy.home.documents}
    videosLabel={currentCopy.home.videosLabel}
    audioLabel={currentCopy.home.audioLabel}
  />
  <DownloadCTA
    forceOS={forceOS}
    title={currentCopy.home.downloadTitle}
    subtitle={currentCopy.home.downloadSubtitle}
    hintPrefix={currentCopy.home.downloadHintPrefix}
    downloadLabel={currentCopy.header.download}
    downloadMenu={currentCopy.downloadMenu}
  />
  <CrossPlatformBanner locale={currentLocale} />

  {currentLocale === DEFAULT_LOCALE && comparison && (
    <ComparisonTable {...comparison} />
  )}

  {shouldRenderPdfDeepDive && (
    <>
      {!showPdfScenariosEarly && <PdfScenarios copy={pdfDeepDive} locale={currentLocale} />}

      <section class={styles.PdfComparison}>
        <div class={styles.Section__Container}>
          <div class={styles.PdfDeepDive__Header}>
            <p class={styles.PdfDeepDive__Eyebrow}>{pdfDeepDive.comparisonEyebrow}</p>
            <Heading as='h2' align='center'>
              {pdfDeepDive.comparisonTitle}
            </Heading>
            <p class={styles.PdfDeepDive__Intro}>
              {pdfDeepDive.comparisonIntro}
            </p>
          </div>

          <div class={styles.PdfComparisonTable}>
            <div class={styles.PdfComparisonTable__Head}>
              <span>{pdfDeepDive.comparisonHeaders?.tool ?? 'Tool'}</span>
              <span>{pdfDeepDive.comparisonHeaders?.bestFor ?? 'Best for'}</span>
              <span>{pdfDeepDive.comparisonHeaders?.gap ?? 'Filename gap'}</span>
            </div>
            {pdfDeepDive.comparisonRows.map((row) => (
              <div class={styles.PdfComparisonTable__Row}>
                <strong>{row.tool}</strong>
                <span>{row.bestFor}</span>
                <span>{row.gap}</span>
              </div>
            ))}
          </div>
        </div>
      </section>
    </>
  )}

  {currentLocale === DEFAULT_LOCALE && contextualGuideLink && (
    <div class={styles.ContextualGuideLink}>
      <p>
        {contextualGuideLink.before}{' '}
        <a href={contextualGuideLink.href}>{contextualGuideLink.label}</a>
        {contextualGuideLink.after ?? ''}
      </p>
    </div>
  )}

  {resolvedDirectAnswerSection && !landingWorkflow && (
    <section class={`${styles.Section} ${styles.DirectAnswer}`}>
      <div class={styles.DirectAnswer__Container}>
        <Heading as='h2' align='left'>
          {resolvedDirectAnswerSection.heading}
        </Heading>
        <p class={styles.DirectAnswer__Answer}>{resolvedDirectAnswerSection.answer}</p>
        <ol class={styles.DirectAnswer__Steps}>
          {resolvedDirectAnswerSection.steps.map((step) => <li>{step}</li>)}
        </ol>
      </div>
    </section>
  )}

  <section id='faq' class={styles.Section}>
    <div class={styles.Section__Container}>
      <Heading as='h2' align='center' style={{ marginBottom: '3rem' }}>
        {pageCopy?.faqTitle ?? 'Frequently Asked Questions'}
      </Heading>
      <FeatureFAQ faqItems={pageCopy?.faqItems ?? faqItems} client:visible />
    </div>
  </section>

  <Pricing copy={currentCopy.pricing} />
  {currentLocale === DEFAULT_LOCALE && <TrustSignals />}

  {(relatedPages.length > 0 || relatedBlogPosts.length > 0) && (
    <section class={styles.Section}>
      <div class={styles.Section__Container}>
        {relatedPages.length > 0 && (
          <>
            <Heading as='h3' align='center' style={{ marginBottom: '2rem' }}>
              {pageCopy?.relatedToolsTitle ?? 'Related Tools'}
            </Heading>
            <div class={styles.RelatedLinks}>
              {relatedPages.map((page) => (
                <PillLink href={relatedPageHref(page.href)} withArrow>{relatedPageTitle(page.href, page.title)}</PillLink>
              ))}
            </div>
          </>
        )}

        {currentLocale === DEFAULT_LOCALE && relatedBlogPosts.length > 0 && (
          <div class={relatedPages.length > 0 ? styles.RelatedSection : ''}>
            <Heading as='h3' align='center' style={{ marginBottom: '2rem' }}>
              {pageCopy?.relatedGuidesTitle ?? 'Related Guides'}
            </Heading>
            <div class={styles.RelatedLinks}>
              {relatedBlogPosts.map((post) => (
                <PillLink href={`/blog/${post.href}`} withArrow>{post.title}</PillLink>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  )}
</article>
