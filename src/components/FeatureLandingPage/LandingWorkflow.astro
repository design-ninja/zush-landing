---
import type { LandingWorkflow } from '@/data/landingWorkflows';
interface Props { workflow: LandingWorkflow }
const { workflow } = Astro.props;
---

<section class="landing-workflow" data-landing-workflow aria-labelledby="landing-workflow-heading">
  <h2 id="landing-workflow-heading">{workflow.heading}</h2>
  <p class="answer">{workflow.answer}</p>
  <ol>{workflow.steps.map((step) => <li>{step}</li>)}</ol>
  {workflow.setupOptions && (
    <div class="setup-options">
      {workflow.setupOptions.map((option) => (
        <section><h3>{option.title}</h3><p>{option.instructions}</p><a href={option.href}>{option.label}</a></section>
      ))}
    </div>
  )}
  {workflow.image && (
    <figure>
      <img src={workflow.image.src} alt={workflow.image.alt} width="2560" height="1440" loading="lazy" decoding="async" />
      <figcaption>{workflow.image.caption}</figcaption>
    </figure>
  )}
  {workflow.example && (
    <figure>
      <div class="example"><bdi dir="ltr"><code>{workflow.example.before}</code></bdi><span aria-hidden="true"> → </span><bdi dir="ltr"><code>{workflow.example.after}</code></bdi></div>
      <figcaption>{workflow.example.caption}</figcaption>
    </figure>
  )}
  <p>{workflow.limit}</p>
  <ul class="links">{workflow.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
</section>

<style lang="scss">
  @use 'styles/variables' as *;
  @use 'styles/mixins' as *;

  .landing-workflow {
    @include page-section;

    > * { max-width: 45rem; }
    > .setup-options, > figure:has(img) { max-width: none; }
  }

  h2 { @include heading('h2'); margin: 0; }
  h3 { margin: 0 0 .625rem; font-size: 1.1875rem; letter-spacing: -0.01em; }
  p, li, figcaption { @include body-copy; }
  p { margin: 0; }
  .answer { margin-block: 1rem 2rem; font-size: 1.0625rem; }
  ol { display: grid; gap: .75rem; margin: 0; padding-inline-start: 1.5rem; list-style: decimal; }
  ol li::marker { color: var(--primary); font-family: var(--font-mono); font-size: .8125rem; }
  .setup-options { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18.75rem), 1fr)); gap: 3rem; margin-block: 3rem; }
  .setup-options > section { @include hairline-item; }
  .setup-options p { overflow-wrap: anywhere; margin-bottom: .75rem; font-size: .9375rem; }
  figure { margin: 3rem 0; }
  img { display: block; width: 100%; height: auto; @include frame; }
  .example { display: flex; align-items: baseline; flex-wrap: wrap; gap: .5rem; direction: ltr; @include hairline-item(1.25rem); }
  bdi { min-width: 0; overflow-wrap: anywhere; }
  code { @include mono-sample; font-size: .875rem; color: var(--foreground); }
  figcaption { margin-block-start: .75rem; font-size: .875rem; }
  .links { @include link-row; margin-top: 1.5rem; }
  a { @include text-link; }
</style>
