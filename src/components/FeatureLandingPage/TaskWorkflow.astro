---
import { AudioLines, ChevronDown, Download, FileArchive, FileType2, Film } from 'lucide-react';
import DownloadCTA from '@/components/DownloadCTA/DownloadCTA.astro';
import Heading from '@/components/Heading';
import PillLink from '@/components/PillLink';
import ThemedScreenshot from '@/components/OrganizationFeatures/ThemedScreenshot.astro';
import buttonStyles from '@/components/Button/Button.module.scss';
import type { FeatureCategory } from '@/data/featureContent';
import landingStyles from './FeatureLandingPage.module.scss';
import styles from './TaskWorkflow.module.scss';
import type { DownloadMenuCopy } from '@/i18n/copy';
import type { DownloadOS } from '@/utils/download';
interface Props { category: FeatureCategory; forceOS?: DownloadOS; downloadLabel?: string; downloadMenu?: DownloadMenuCopy }
const { category, forceOS, downloadLabel, downloadMenu } = Astro.props;
const workflows = {
  pdf: {
    title: 'From a downloaded PDF to a name you can find',
    intro: 'Start with a few copies of your invoices, contracts, or scans. Review the suggested names before applying a batch.',
    steps: [
      ['Download the starters', 'Download two Templates and the fictional invoice and meeting notes. Try these copies first.'],
      ['Import and select a Template', 'Open Templates → More (…) → Import Templates. Then choose the invoice or document Template in AI Rename.'],
      ['Review, then rename', 'Check the date, vendor and number against the PDF. Apply the reviewed names; rename history lets you undo.'],
    ],
    pattern: '2026-08-18_northstar-studio_ns-1042.pdf',
    caption: 'Example pattern: issue date, vendor and invoice number. Verify each field against the PDF. This is an illustrative target, not a measured result.',
    testedInput: 'file_001.pdf',
    testedResult: 'Invoice NS-1042 from Northstar Studio',
    testedContext: 'A fictional invoice for Northstar Studio, number NS-1042. The recorded suggestion kept the vendor and invoice number; it did not include the invoice date.',
    limit: 'Do not treat an inferred date or number as a verified accounting field. Poor scans and missing information can produce incomplete suggestions. Renaming changes the filename, not the PDF contents.',
    guide: '/blog/automatically-rename-invoices-ai',
    label: 'Set up an invoice naming workflow',
  },
  video: {
    title: 'Find the right clip without opening every export',
    intro: 'Use visible content to name screen recordings, camera clips, and b-roll. Keep a copy of linked editing projects before changing source filenames.',
    steps: [
      ['Add a few representative clips', 'Start with supported MP4 or MOV files. Include a screen recording and a camera clip to check both kinds of material.'],
      ['Generate names from sampled context', 'Zush uses sampled frames and available subtitle context. Keep matching SRT or VTT files nearby when you have them.'],
      ['Check the description and apply', 'Make sure the suggested subject matches the clip. Review names before applying and use rename history to undo a batch if needed.'],
    ],
    pattern: 'Product-Demo_Batch-Rename-Preview.mp4',
    caption: 'Illustrative naming pattern for a software demo. A sampled frame is context, not a transcript of the entire video.',
    testedInput: 'file_008.mp4',
    testedResult: 'AI Rename application demo',
    testedContext: 'An existing Zush demo showing the batch rename interface. The recorded name describes an AI Rename application demonstration.',
    limit: 'A short scene can be missed between sampled frames. Names do not guarantee full-video understanding. Renaming source media can break links in editing projects; verify or relink those projects after a rename.',
    guide: '/blog/rename-video-files-with-ai',
    label: 'Read the video renaming workflow',
  },
  audio: {
    title: 'Turn a voice memo into a searchable recording',
    intro: 'Choose names that help you recognise a meeting, interview, podcast segment, or music track without replaying it.',
    steps: [
      ['Download the starters', 'Download two Templates, a short spoken WAV and a tagged FLAC tone. Try speech and music tags separately.'],
      ['Import and select a Template', 'Open Templates → More (…) → Import Templates. In AI Rename, use Spoken audio topic for WAV or Tagged music artist and title for FLAC.'],
      ['Check names before renaming', 'Check the topic and any inferred details. Apply the reviewed names; rename history lets you undo.'],
    ],
    pattern: 'autumn-product-launch.wav',
    caption: 'Illustrative topic from the spoken sample. Exact names can vary. The separate FLAC sample tests embedded artist/title tags, not song recognition.',
    testedInput: 'file_007.wav',
    testedResult: 'Autumn product launch discussion',
    testedContext: 'An 11.49-second synthetic spoken recording about an autumn product launch. The recorded name describes that discussion.',
    limit: 'Noise, missing tags, unsupported transcription paths, or unclear speech can limit the result. AI may not identify a speaker or song reliably. Changing filenames does not rewrite audio tags or repair links in playlists and editing projects.',
    guide: '/blog/rename-audio-files-with-ai',
    label: 'Read the audio renaming workflow',
  },
};
const workflow = workflows[category as keyof typeof workflows];
const starter = category === 'pdf' || category === 'audio' ? category : undefined;
const starterRoot = '/downloads/workflow-starters';
const starterLabel = starter === 'pdf' ? 'PDF' : 'audio';
const FileIcon = category === 'audio' ? AudioLines : category === 'video' ? Film : FileType2;
const fileBadge = category === 'audio' ? 'WAV' : category === 'video' ? 'MP4' : 'PDF';
const beforeName = starter === 'pdf' ? 'scan_001.pdf' : starter === 'audio' ? 'voice_memo_042.wav' : workflow?.testedInput;
const buttonClass = (variant: 'primary' | 'ghost') =>
  [buttonStyles.Button, buttonStyles[`Button_${variant}`], buttonStyles.Button_md, styles.TaskWorkflow__Button].join(' ');
---
{workflow && (
  <section
    class:list={[landingStyles.Section, styles.TaskWorkflow]}
    id={starter ? `try-${starter}` : undefined}
    aria-labelledby="task-workflow-title"
    data-category={category}
    data-has-cta={starter ? '' : undefined}
  >
    <div class={landingStyles.Section__Container}>
      <header class={landingStyles.PdfDeepDive__Header}>
        <p class={landingStyles.PdfDeepDive__Eyebrow}>{starter ? 'Try it with sample files' : 'How it works'}</p>
        <Heading as="h2" align="center" id="task-workflow-title">{workflow.title}</Heading>
        <p class={landingStyles.PdfDeepDive__Intro}>{workflow.intro}</p>
      </header>

      <ol class={styles.Steps} role="list">
        {workflow.steps.map(([title, text], index) => (
          <li class={styles.Step}>
            <span class={styles.Step__Number} aria-hidden="true">{index + 1}</span>
            <Heading as="h3" size="h4" className={styles.Step__Title}>{title}</Heading>
            <p class={styles.Step__Text}>{text}</p>
          </li>
        ))}
      </ol>

      <div class:list={[styles.Demo, { [styles.Demo_withMedia]: starter }]}>
        <div class={styles.Demo__Main}>
          <figure class={styles.Example}>
            <div class={landingStyles.PdfFileItem}>
              <div class={landingStyles.PdfFileItem__Preview} data-tone={category} aria-hidden="true">
                <FileIcon size={24} strokeWidth={2.2} />
                <span class={landingStyles.PdfFileItem__Badge}>{fileBadge}</span>
              </div>
              <div class={styles.Example__Names}>
                <span class={styles.Example__Label}>Before</span>
                <code class={styles.Example__Before}>{beforeName}</code>
                <span class={styles.Example__Label}>Example result</span>
                <code class={styles.Example__After}>{workflow.pattern}</code>
              </div>
            </div>
            <figcaption class={styles.Caption}>{workflow.caption}</figcaption>
          </figure>

          {starter && (
            <div class={styles.Downloads}>
              <div class={styles.Downloads__Buttons}>
                <a
                  class={buttonClass('primary')}
                  href={`${starterRoot}/${starter}-starters.zushtemplates`}
                  download
                  aria-label={`Download ${starterLabel} Templates (2 Templates, .zushtemplates)`}
                >
                  <Download size={18} aria-hidden="true" />
                  <span>Download Templates</span>
                </a>
                <a
                  class={buttonClass('ghost')}
                  href={`${starterRoot}/${starter}-examples.zip`}
                  download
                  aria-label="Download sample files (2 synthetic files, ZIP)"
                >
                  <FileArchive size={18} aria-hidden="true" />
                  <span>Sample files</span>
                </a>
              </div>
              <p class={styles.Caption}>
                2 Templates (.zushtemplates) and 2 synthetic files (ZIP). Mac 3.13+ · Windows 3.10+. English output; sorting and metadata writing off.{starter === 'audio' && ' Speech analysis depends on your AI mode.'}{' '}
                <a href={`${starterRoot}/README.md`}>Setup and sample details</a>
              </p>
            </div>
          )}
        </div>

        {starter && (
          <figure class={styles.Demo__Media}>
            <a
              class={styles.Screenshot}
              href="/images/showcase/macos/template-transfer-light-1920.webp"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Open the full Mac import screenshot"
            >
              <ThemedScreenshot id="template-transfer" zoom alt="Zush for Mac Templates menu with Import Templates and Export All Templates." />
            </a>
            <figcaption class={styles.Caption}>
              <strong>Import once, reuse the Template.</strong> The Mac Templates menu is shown here; Windows has its own import action.{' '}
              <a href="/docs/template-import-export">Import instructions</a>
            </figcaption>
          </figure>
        )}
      </div>

      <div class={styles.Notes}>
        <p class={styles.Notes__Limit}>{workflow.limit}</p>

        <details class={styles.Result}>
          <summary class={styles.Result__Summary}>
            <span>See a recorded test result</span>
            <ChevronDown size={20} className={styles.Result__Icon} aria-hidden="true" />
          </summary>
          <div class={styles.Result__Body}>
            <p>{workflow.testedContext}</p>
            <dl class={styles.Result__Facts}>
              <div><dt>File</dt><dd><code>{workflow.testedInput}</code></dd></div>
              <div><dt>Named as</dt><dd>{workflow.testedResult}</dd></div>
              <div><dt>Setup</dt><dd>Sept 5, 2026 · Zush 3.11.0 for Mac · Cloud AI · Smart Title Name</dd></div>
              <div><dt>Contents</dt><dd>Unchanged, byte-for-byte</dd></div>
            </dl>
            <p class={styles.Result__Note}>
              The test used a non-English output language; the name is translated here. A small test, not an accuracy guarantee{starter ? '; the starter Templates were not part of it' : ''}.{' '}
              <a href="/benchmarks/ai-file-renamer-pilot-2026-09-05/README.md">Full test setup and results</a>
            </p>
          </div>
        </details>

        <div class={styles.Notes__Guide}>
          <PillLink href={workflow.guide} withArrow>{workflow.label}</PillLink>
        </div>
      </div>

    </div>
  </section>
)}
{workflow && starter && (
  <DownloadCTA
    forceOS={forceOS}
    title={`Try the ${starterLabel} workflow in Zush`}
    subtitle="Import a starter Template and preview the sample names. Free includes 50 renames in total across all AI modes; PRO removes the app limit."
    downloadLabel={downloadLabel}
    downloadMenu={downloadMenu}
  />
)}
