---
import styles from './DemoVideo.module.scss';
import { MAC_DEMO_VIDEO, type DemoVideoAsset } from '@/data/showcaseMedia';

interface Props {
  label: string;
  media?: DemoVideoAsset;
  /** Recording shown instead of `media` to visitors on Windows. */
  windowsMedia?: DemoVideoAsset;
  autoplay?: boolean;
  preload?: 'none' | 'metadata' | 'auto';
}

const {
  label,
  media = MAC_DEMO_VIDEO,
  windowsMedia,
  autoplay = true,
  preload = 'metadata',
} = Astro.props as Props;

// Two recordings of the same demo exist, one per theme. Render a single video
// without an SSR `src`; the client assigns only the active theme's source. This
// keeps autoplay while preventing the hidden recording from being downloaded.
//
// The light poster ships in the HTML so the frame paints before any script runs;
// the recording itself is attached only once the page has loaded and the video is
// near the viewport. Phones and data-saver connections get the poster with
// click-to-play instead of a multi-megabyte autoplay.
//
// Neither file has an audio track, which is also why the native controls show
// no volume slider: browsers omit it when there is nothing to mute.
const isThemeAware = media.sources.light !== media.sources.dark;
const windowsAttributes = windowsMedia
  ? {
      'data-win-light-src': windowsMedia.sources.light,
      'data-win-dark-src': windowsMedia.sources.dark,
      'data-win-light-poster': windowsMedia.posters.light,
      'data-win-dark-poster': windowsMedia.posters.dark,
      'data-win-aspect': `${windowsMedia.width} / ${windowsMedia.height}`,
    }
  : {};

const frameStyle = { '--demo-video-aspect-ratio': `${media.width} / ${media.height}` };
---

<!-- Opted out of the scroll-reveal fade: the demo sits right under the hero
     and should already be on screen when the page paints. -->
<section class={styles.DemoVideo} aria-label={label} data-scroll-reveal-skip>
  <div class={styles.DemoVideo__Container}>
    <div class={styles.DemoVideo__Frame} style={frameStyle}>
      <video
        class={styles.DemoVideo__Video}
        data-demo-video
        data-light-src={media.sources.light}
        data-dark-src={isThemeAware ? media.sources.dark : media.sources.light}
        data-light-poster={media.posters.light}
        data-dark-poster={isThemeAware ? media.posters.dark : media.posters.light}
        {...windowsAttributes}
        poster={media.posters.light}
        controls
        controlslist="nodownload"
        autoplay={autoplay}
        loop
        muted
        playsinline
        preload={preload}
        aria-label={label}
      ></video>
    </div>
  </div>
</section>

<script>
  import { detectFromUA, readPreferredOS } from '@/utils/detectOS';

  // Videos with a Windows recording switch to it for visitors on Windows, and
  // the frame takes that recording's aspect ratio.
  const pickMedia = (video: HTMLVideoElement) => {
    const theme = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
    const { dataset } = video;
    const windows = Boolean(dataset.winLightSrc) && (readPreferredOS() ?? detectFromUA()) === 'windows';
    if (windows && dataset.winAspect) {
      video.parentElement?.style.setProperty('--demo-video-aspect-ratio', dataset.winAspect);
    }
    if (windows) {
      return theme === 'dark'
        ? { src: dataset.winDarkSrc, poster: dataset.winDarkPoster }
        : { src: dataset.winLightSrc, poster: dataset.winLightPoster };
    }
    return theme === 'dark'
      ? { src: dataset.darkSrc, poster: dataset.darkPoster }
      : { src: dataset.lightSrc, poster: dataset.lightPoster };
  };

  const applyDemoVideoTheme = (video: HTMLVideoElement) => {
    const { src: nextSrc, poster: nextPoster } = pickMedia(video);

    if (!nextSrc || video.getAttribute('src') === nextSrc) return;

    // Detach the previous theme before attaching the next one, so a theme
    // switch never leaves two downloadable media sources in the document.
    video.pause();
    video.removeAttribute('src');
    video.load();

    if (nextPoster) video.poster = nextPoster;
    video.src = nextSrc;
    video.muted = true;
    video.load();

    if (video.autoplay) {
      void video.play().catch(() => {
        // Autoplay can still be blocked by a browser-level user preference.
      });
    }
  };

  const prefersLightweightMedia = () => {
    const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
    return Boolean(connection?.saveData) || window.matchMedia('(max-width: 767px)').matches;
  };

  const activateDemoVideo = (video: HTMLVideoElement) => {
    if (video.dataset.demoActive === 'true') return;
    video.dataset.demoActive = 'true';
    if (prefersLightweightMedia()) {
      video.autoplay = false;
      video.preload = 'none';
    }
    applyDemoVideoTheme(video);
  };

  // Attach sources after the load event so the recording never competes with
  // the hero for bandwidth, and only for videos close to the viewport.
  const visibilityObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      visibilityObserver.unobserve(entry.target);
      activateDemoVideo(entry.target as HTMLVideoElement);
    });
  }, { rootMargin: '200px 0px' });

  let pageLoaded = document.readyState === 'complete';

  // Posters follow the theme right away; sources wait for the load event.
  const syncPoster = (video: HTMLVideoElement) => {
    const { poster } = pickMedia(video);
    if (poster && video.getAttribute('poster') !== poster) video.poster = poster;
  };

  const initializeDemoVideos = () => {
    document
      .querySelectorAll<HTMLVideoElement>('video[data-demo-video]')
      .forEach((video) => {
        if (video.dataset.demoActive === 'true') {
          applyDemoVideoTheme(video);
          return;
        }
        syncPoster(video);
        if (pageLoaded) visibilityObserver.observe(video);
      });
  };

  initializeDemoVideos();
  if (!pageLoaded) {
    window.addEventListener('load', () => {
      pageLoaded = true;
      initializeDemoVideos();
    }, { once: true });
  }
  document.addEventListener('astro:page-load', initializeDemoVideos);

  const demoVideoThemeObserver = new MutationObserver(initializeDemoVideos);
  demoVideoThemeObserver.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme'],
  });
</script>
