---
import { Image } from 'astro:assets';
import { ArrowRight, Bot, Cloud, KeyRound } from 'lucide-react';
import audienceAgentImage from '@/assets/landing/real-estate-audience-agent.webp';
import audienceCoordinatorImage from '@/assets/landing/real-estate-audience-coordinator.webp';
import audienceListingMediaImage from '@/assets/landing/real-estate-audience-listing-media.webp';
import CloudFolders from '@/components/CloudFolders';
import DemoVideo from '@/components/DemoVideo/DemoVideo.astro';
import DownloadCTA from '@/components/DownloadCTA/DownloadCTA.astro';
import FAQ from '@/components/FAQ';
import BentoCard from '@/components/Features/BentoCard.astro';
import FeatureAnimation from '@/components/Features/FeatureAnimation';
import featureStyles from '@/components/Features/Features.module.scss';
import Heading from '@/components/Heading';
import Pricing from '@/components/Pricing/Pricing.astro';
import ProfessionGuides from '@/components/ProfessionGuides/ProfessionGuides.astro';
import Text from '@/components/Text';
import sectionHeaderStyles from '@/components/SectionHeader/SectionHeader.module.scss';
import testimonialStyles from '@/components/Testimonials/Testimonials.module.scss';
import {
  REAL_ESTATE_AUDIENCES,
  REAL_ESTATE_DOCUMENT_TYPES,
  REAL_ESTATE_FAQ,
  REAL_ESTATE_OUTCOMES,
  REAL_ESTATE_PRIVACY_MODES,
  REAL_ESTATE_PRIVACY_NOTE,
  REAL_ESTATE_WORKFLOW,
} from '@/data/realEstateLanding';
import { getCopy } from '@/i18n/copy';
import { FEATURE_DEMO_COPY } from '@/i18n/featureDemoCopy';
import styles from '@/components/LegalLandingPage/LegalLandingPage.module.scss';
import { RealEstateFieldExplorer } from './RealEstateFieldExplorer';
import RealEstateHero from './RealEstateHero.astro';

const copy = getCopy('en');
const demoCopy = FEATURE_DEMO_COPY.en;
const PRIVACY_ICONS = { cloud: Cloud, byok: KeyRound, offline: Bot } as const;
const AUDIENCE_IMAGES = {
  agent: {
    src: audienceAgentImage,
    alt: 'A real estate agent reviewing an inspection report with a home inspector at a property',
  },
  coordinator: {
    src: audienceCoordinatorImage,
    alt: 'A real estate transaction coordinator reviewing closing documents beside a laptop',
  },
  'listing-media': {
    src: audienceListingMediaImage,
    alt: 'A listing specialist organizing property photos and transaction files at a desktop computer',
  },
} as const;
---

<RealEstateHero />

<div class={styles.HeroDemo}>
  <DemoVideo label="Zush organizing real estate transaction documents by property address" />
</div>

<section class={styles.Audiences} aria-labelledby="real-estate-audiences-title">
  <div class={styles.Audiences__Container}>
    <div class={styles.Audiences__Intro}>
      <p class={styles.Audiences__Eyebrow}>Real estate file organization</p>
      <Heading as="h2" id="real-estate-audiences-title" className={styles.Audiences__Title}>
        Keep every property file recognizable from offer to archive
      </Heading>
      <Text as="p" color="subtle" className={styles.Audiences__Description}>
        Zush gives the documents and media around each transaction a consistent address-based identity without replacing the tools your brokerage already uses.
      </Text>
    </div>

    <ul class={styles.Audiences__List}>
      {REAL_ESTATE_AUDIENCES.map((audience) => (
        <li class={styles.Audience}>
          <div class={styles.Audience__Media}>
            <Image
              src={AUDIENCE_IMAGES[audience.icon].src}
              alt={AUDIENCE_IMAGES[audience.icon].alt}
              class={styles.Audience__Image}
              widths={[240, 360, 480, 720, 960]}
              sizes="(max-width: 640px) 100vw, 11rem"
              format="webp"
              quality={78}
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class={styles.Audience__Content}>
            <h3 class={styles.Audience__Title}>{audience.title}</h3>
            <p class={styles.Audience__Description}>{audience.description}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<section id="fields" class={styles.Fields} aria-labelledby="real-estate-fields-title">
  <div class={styles.Fields__Container}>
    <div class={sectionHeaderStyles.SectionHeader}>
      <Heading as="h2" align="center" id="real-estate-fields-title" className={sectionHeaderStyles.SectionHeader__Title}>
        Turn a transaction folder into a property record
      </Heading>
      <Text as="p" size="lg" color="subtle" align="center" className={sectionHeaderStyles.SectionHeader__Description}>
        Extract the property address, document date, type, party, status, closing date, listing number, and other fields already inside each file. Your Template controls their order.
      </Text>
    </div>

    <RealEstateFieldExplorer client:visible />
  </div>
</section>

<section id="privacy" class={styles.Privacy} aria-labelledby="real-estate-privacy-title">
  <div class={styles.Privacy__Container}>
    <div class={sectionHeaderStyles.SectionHeader}>
      <Heading as="h2" align="center" id="real-estate-privacy-title" className={sectionHeaderStyles.SectionHeader__Title}>
        Process transaction documents on your terms
      </Heading>
      <Text as="p" size="lg" color="subtle" align="center" className={sectionHeaderStyles.SectionHeader__Description}>
        Choose local processing, your brokerage’s approved AI provider, or Zush-managed AI based on the files in the workflow. Source documents remain in their existing folders.
      </Text>
    </div>

    <div class={featureStyles.Band__Grid}>
      {REAL_ESTATE_PRIVACY_MODES.map((mode) => (
        <BentoCard
          title={mode.title}
          description={mode.description}
          icon={PRIVACY_ICONS[mode.id]}
          badge={mode.badge}
          badgeTone={mode.badgeTone}
        >
          <div class={featureStyles.UI_FeatureAnimation}>
            <FeatureAnimation kind={mode.kind} demoCopy={demoCopy} client:visible />
          </div>
        </BentoCard>
      ))}
    </div>

    <p class={styles.Privacy__Note}>
      {REAL_ESTATE_PRIVACY_NOTE}{' '}
      <a class={styles.ArrowLink} href="/docs/privacy-security">
        Read how the modes handle data
        <ArrowRight size={15} aria-hidden="true" />
      </a>
    </p>
  </div>
</section>

<section id="workflow" class={styles.Workflow} aria-labelledby="real-estate-workflow-title">
  <div class={styles.Workflow__Container}>
    <div class={sectionHeaderStyles.SectionHeader}>
      <Heading as="h2" align="center" id="real-estate-workflow-title" className={sectionHeaderStyles.SectionHeader__Title}>
        Add consistent filenames to the transaction flow you already have
      </Heading>
      <Text as="p" size="lg" color="subtle" align="center" className={sectionHeaderStyles.SectionHeader__Description}>
        Use Zush between email, e-signature downloads, scanners, property visits, shared folders, and your transaction management system.
      </Text>
    </div>

    <ol class={styles.Workflow__Steps}>
      {REAL_ESTATE_WORKFLOW.map((step, index) => (
        <li class={styles.WorkflowStep}>
          <span class={styles.WorkflowStep__Number} aria-hidden="true">{index + 1}</span>
          <h3 class={styles.WorkflowStep__Title}>{step.title}</h3>
          <p class={styles.WorkflowStep__Description}>{step.description}</p>
        </li>
      ))}
    </ol>

    <div class={styles.Workflow__Links}>
      <a class={styles.ArrowLink} href="/blog/real-estate-document-naming-convention">
        Build a real estate document naming convention
        <ArrowRight size={15} aria-hidden="true" />
      </a>
      <a class={styles.ArrowLink} href="/blog/how-to-organize-real-estate-transaction-files">
        Organize the complete transaction folder
        <ArrowRight size={15} aria-hidden="true" />
      </a>
      <a class={styles.ArrowLink} href="/blog/rename-docusign-files-by-property-address">
        Rename DocuSign downloads by property
        <ArrowRight size={15} aria-hidden="true" />
      </a>
    </div>
  </div>
</section>

<CloudFolders title={copy.home.cloudFoldersTitle} />

<section class={styles.Documents} aria-labelledby="real-estate-document-types-title">
  <div class={styles.Documents__Container}>
    <div class={sectionHeaderStyles.SectionHeader}>
      <Heading as="h2" align="center" id="real-estate-document-types-title" className={sectionHeaderStyles.SectionHeader__Title}>
        One organizer for the files around every property transaction
      </Heading>
      <Text as="p" size="lg" color="subtle" align="center" className={sectionHeaderStyles.SectionHeader__Description}>
        Use separate Templates for purchases, listings, leases, closing packages, and property media while keeping the address consistent across each workflow.
      </Text>
    </div>

    <div class={styles.Documents__Grid}>
      {REAL_ESTATE_DOCUMENT_TYPES.map((documentType) => (
        <article class={styles.DocumentType}>
          <h3 class={styles.DocumentType__Title}>{documentType.title}</h3>
          <p class={styles.DocumentType__Description}>{documentType.description}</p>
          <code class={styles.DocumentType__Example}>{documentType.example}</code>
        </article>
      ))}
    </div>
  </div>
</section>

<section id="organization-outcomes" class={testimonialStyles.Testimonials} aria-labelledby="real-estate-outcomes-title">
  <div class={testimonialStyles.Testimonials__Container}>
    <div class={sectionHeaderStyles.SectionHeader}>
      <Heading as="h2" align="center" id="real-estate-outcomes-title" className={sectionHeaderStyles.SectionHeader__Title}>
        What changes when property files have useful names
      </Heading>
      <Text as="p" size="lg" color="subtle" align="center" className={sectionHeaderStyles.SectionHeader__Description}>
        The goal is a transaction folder that still makes sense outside a portal and after the deal closes.
      </Text>
    </div>

    <div class={`${testimonialStyles.Testimonials__Grid} ${styles.Testimonials__Grid}`}>
      {REAL_ESTATE_OUTCOMES.map((outcome) => (
        <article class={testimonialStyles.TestimonialCard}>
          <h3 class={testimonialStyles.TestimonialCard__Name}>{outcome.title}</h3>
          <Text as="p" size="sm" color="subtle">{outcome.description}</Text>
        </article>
      ))}
    </div>
  </div>
</section>

<Pricing copy={copy.pricing} />

<FAQ
  client:visible
  items={REAL_ESTATE_FAQ}
  title="Real estate document organization, answered"
  description="How AI file renaming works with transaction systems, DocuSign downloads, closing documents, property photos, sensitive files, preview, and undo."
/>

<ProfessionGuides
  id="real-estate-guides"
  title="Real estate transaction file guides"
  description="Separate guides for naming conventions, transaction folder structure, and automatic cleanup of e-signature downloads."
  slugs={[
    'real-estate-document-naming-convention',
    'how-to-organize-real-estate-transaction-files',
    'rename-docusign-files-by-property-address',
  ]}
/>

<div class={styles.FinalCta}>
  <DownloadCTA
    title="Try Zush on one copied transaction folder"
    subtitle="Start with a small batch of DocuSign downloads, inspection reports, disclosures, or closing files. Review the proposed names, refine the Template, and undo the batch if it needs another pass."
  />
</div>
