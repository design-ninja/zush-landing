---
import SectionHeader from '@/components/SectionHeader';
import blocks from '@/components/Blocks/Blocks.module.scss';
import {
  getLocalesForRoute,
  getLocalizedPath,
  isLocalizedRoute,
  type Locale,
} from '@/i18n/config';
import type { HomeWorkflowKey, HomeWorkflowsCopy } from '@/i18n/copy';

interface Props {
  copy: HomeWorkflowsCopy;
  locale: Locale;
}

const { copy, locale } = Astro.props;

const WORKFLOWS: Array<{
  key: HomeWorkflowKey;
  route: string;
}> = [
  { key: 'screenshots', route: '/rename-screenshots-with-ai' },
  { key: 'pdfs', route: '/rename-pdf-with-ai' },
  { key: 'photos', route: '/rename-photos-with-ai' },
  { key: 'documents', route: '/rename-documents-with-ai' },
  { key: 'organizer', route: '/ai-file-organizer' },
  { key: 'design', route: '/rename-design-files-with-ai' },
  { key: 'videos', route: '/rename-videos-with-ai' },
  { key: 'audio', route: '/rename-audio-with-ai' },
  { key: 'batch', route: '/batch-rename-files' },
];

const localizedHref = (route: string): string =>
  isLocalizedRoute(route) && getLocalesForRoute(route).includes(locale)
    ? getLocalizedPath(route, locale)
    : route;

---

<section class={blocks.Section} aria-labelledby="home-workflows-title">
  <SectionHeader
    align="left" id="home-workflows-title" title={copy.title} description={copy.description} />

  <div class:list={[blocks.Columns, blocks.Columns_list]}>
    {WORKFLOWS.map(({ key, route }) => (
      <a class={blocks.RowLink} href={localizedHref(route)}>
        <span>
          <h3 class={blocks.RowTitle}>{copy.items[key].title}</h3>
          <span class={blocks.RowText}>{copy.items[key].description}</span>
        </span>
      </a>
    ))}
  </div>
</section>
