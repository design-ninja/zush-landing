---
// Real-world scenarios for a platform page: file samples in hairline columns.
import { Image } from 'astro:assets';
import { FileSpreadsheet, FileText, FileType2, Film, Palette, Presentation } from 'lucide-react';
import SectionHeader from '@/components/SectionHeader';
import { PLATFORM_SPECIFICS_CONTENT, type PlatformSpecificsKey, type ScenarioFileType } from '@/data/platformSpecifics';
import { DEFAULT_LOCALE, type Locale } from '@/i18n/config';
import { getCopy } from '@/i18n/copy';
import { getPlatformSpecificsCopy } from '@/i18n/platformSpecifics';
import { getLocalizedPlatformSpecificsContent } from '@/i18n/platformSpecificsContent';
import b from '@/components/Blocks/Blocks.module.scss';

interface Props {
  platform: PlatformSpecificsKey;
  locale?: Locale;
  scenarioLimit?: number;
}

const { platform, locale = DEFAULT_LOCALE, scenarioLimit = 4 } = Astro.props as Props;
const copy = getPlatformSpecificsCopy(locale);
const data = getLocalizedPlatformSpecificsContent(
  platform,
  locale,
  getCopy(locale),
  PLATFORM_SPECIFICS_CONTENT[platform],
);
const isMac = platform === 'mac';
const scenarios = data.scenarios.slice(0, scenarioLimit);

const FILE_TYPE_META: Record<Exclude<ScenarioFileType, 'image'>, { Icon: typeof FileText; label: string }> = {
  design: { Icon: Palette, label: 'FIG' },
  doc: { Icon: FileText, label: 'DOCX' },
  sheet: { Icon: FileSpreadsheet, label: 'XLSX' },
  slides: { Icon: Presentation, label: 'PPTX' },
  pdf: { Icon: FileType2, label: 'PDF' },
  video: { Icon: Film, label: 'MP4' },
};
---

<section class={b.Section}>
  <SectionHeader
    eyebrow={copy.scenariosEyebrow}
    title={copy.scenariosTitle}
    description={isMac ? copy.scenariosDescriptionMac : copy.scenariosDescriptionWindows}
  />

  <div class:list={[b.Columns, b.Columns_four]}>
    {scenarios.map((scenario) => {
      const meta = scenario.fileType !== 'image' ? FILE_TYPE_META[scenario.fileType] : null;
      return (
        <article class:list={[b.Column, b.Column_stack]}>
          <div class={b.File}>
            {scenario.image ? (
              <Image
                class={b.FileTile}
                src={scenario.image}
                alt={`${scenario.title}: ${scenario.before} renamed to ${scenario.after}`}
                width={320}
                height={240}
                loading='lazy'
                decoding='async'
              />
            ) : (
              meta && (
                <div class={b.FileTile} data-tone={scenario.fileType} aria-hidden='true'>
                  <meta.Icon size={22} strokeWidth={2.2} />
                  <span class={b.FileBadge}>{scenario.badgeLabel ?? meta.label}</span>
                </div>
              )
            )}
            <div class={b.FileNames}>
              <div class={b.FileBefore}>{scenario.before}</div>
              <div class={b.FileAfter}>{scenario.after}</div>
            </div>
          </div>
          <h3 class={b.ColumnTitle}>{scenario.title}</h3>
          <p class={b.ColumnText}>{scenario.description}</p>
        </article>
      );
    })}
  </div>
</section>
