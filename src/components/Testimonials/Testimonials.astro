---
import Heading from '@/components/Heading';
import StarRating from '@/components/StarRating';
import Text from '@/components/Text';
import { DEFAULT_LOCALE, type Locale } from '@/i18n/config';
import { MICROSOFT_STORE_REVIEWS } from '@/data/microsoftStoreReviews';
import { SOFTPEDIA_REVIEW } from '@/data/accountantsLanding';
import sectionHeaderStyles from '@/components/SectionHeader/SectionHeader.module.scss';
import styles from './Testimonials.module.scss';

interface Props {
  locale?: Locale;
}

const testimonials = [
  ...MICROSOFT_STORE_REVIEWS.map((review) => ({
    ...review,
    sourceLabel: 'Microsoft Store (US)',
  })),
  {
    name: SOFTPEDIA_REVIEW.author,
    title: 'Independent editorial review',
    quote: SOFTPEDIA_REVIEW.quote,
    rating: 4.5,
    publishedAt: '2026-08-06',
    source: SOFTPEDIA_REVIEW.href,
    sourceLabel: SOFTPEDIA_REVIEW.publication,
  },
];

const copyByLocale: Partial<Record<Locale, { title: string; description: string; sourcePrefix: string; dateLocale: string }>> = {
  en: { title: 'What people say about', description: 'Published reviews from the US Microsoft Store, plus Softpedia’s independent editorial assessment.', sourcePrefix: 'Read on', dateLocale: 'en-US' },
  de: { title: 'Was Menschen über', description: 'Veröffentlichte Rezensionen aus dem US Microsoft Store sowie die unabhängige Bewertung von Softpedia.', sourcePrefix: 'Lesen auf', dateLocale: 'de-DE' },
  fr: { title: 'Ce que les clients disent de', description: 'Avis publiés sur le Microsoft Store américain, ainsi que l’évaluation éditoriale indépendante de Softpedia.', sourcePrefix: 'Lire sur', dateLocale: 'fr-FR' },
  es: { title: 'Lo que los clientes dicen de', description: 'Reseñas publicadas en Microsoft Store de EE. UU. y la evaluación editorial independiente de Softpedia.', sourcePrefix: 'Leer en', dateLocale: 'es-ES' },
  'pt-br': { title: 'O que os clientes dizem sobre', description: 'Avaliações publicadas na Microsoft Store dos EUA e a análise editorial independente da Softpedia.', sourcePrefix: 'Ler na', dateLocale: 'pt-BR' },
  it: { title: 'Cosa dicono i clienti di', description: 'Recensioni pubblicate nel Microsoft Store statunitense e la valutazione editoriale indipendente di Softpedia.', sourcePrefix: 'Leggi su', dateLocale: 'it-IT' },
  nl: { title: 'Wat klanten zeggen over', description: 'Gepubliceerde recensies uit de Amerikaanse Microsoft Store, plus Softpedia’s onafhankelijke redactionele beoordeling.', sourcePrefix: 'Lees op', dateLocale: 'nl-NL' },
  ja: { title: 'お客様の声：', description: '米国 Microsoft Store に掲載されたレビューと、Softpedia による独立した編集評価です。', sourcePrefix: '掲載元', dateLocale: 'ja-JP' },
  ko: { title: '고객들이 말하는', description: '미국 Microsoft Store에 게시된 리뷰와 Softpedia의 독립 편집 평가입니다.', sourcePrefix: '원문 보기', dateLocale: 'ko-KR' },
  'zh-cn': { title: '客户如何评价', description: '来自美国 Microsoft Store 的公开评论，以及 Softpedia 的独立编辑评测。', sourcePrefix: '查看来源', dateLocale: 'zh-CN' },
};

const { locale = DEFAULT_LOCALE } = Astro.props as Props;
const copy = copyByLocale[locale] ?? copyByLocale.en!;
---

<section id='reviews' class={styles.Testimonials} aria-labelledby='testimonials-title'>
  <div class={styles.Testimonials__Container}>
    <div class={sectionHeaderStyles.SectionHeader}>
      <Heading id='testimonials-title' as='h2' align='center' className={sectionHeaderStyles.SectionHeader__Title}>
        {copy.title}{' '}<span class={`${styles.Testimonials__TitleBrand} brand-accent-text`}>Zush</span>
      </Heading>
      <Text as='p' size='lg' color='subtle' align='center' className={sectionHeaderStyles.SectionHeader__Description}>
        {copy.description}
      </Text>
    </div>

    <div class={styles.Testimonials__Grid}>
      {testimonials.map((testimonial) => (
        <article class={styles.TestimonialCard}>
          <div class={styles.TestimonialCard__Rating}>
            <StarRating
              className={styles.TestimonialCard__Stars}
              value={testimonial.rating}
              label={`${testimonial.rating} out of 5 stars`}
            />
            <span>{testimonial.rating.toFixed(1)}</span>
          </div>
          <h3 class={styles.TestimonialCard__Title}>{testimonial.title}</h3>
          <blockquote class={styles.TestimonialCard__Quote} lang='en-US'>
            <Text as='p' size='sm'>{testimonial.quote}</Text>
          </blockquote>
          <footer class={styles.TestimonialCard__Author}>
            <Text as='p' size='sm' className={styles.TestimonialCard__Name}>{testimonial.name}</Text>
            <Text as='p' size='sm' color='subtle'>
              <time datetime={testimonial.publishedAt}>
                {new Intl.DateTimeFormat(copy.dateLocale, { dateStyle: 'medium' }).format(new Date(`${testimonial.publishedAt}T12:00:00Z`))}
              </time>
              {' · '}
              <a href={testimonial.source} target='_blank' rel='noopener noreferrer external'>
                {copy.sourcePrefix} {testimonial.sourceLabel}
              </a>
            </Text>
          </footer>
        </article>
      ))}
    </div>
  </div>
</section>
