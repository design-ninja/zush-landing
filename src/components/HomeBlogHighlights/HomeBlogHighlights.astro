---
import Heading from '@/components/Heading';
import Text from '@/components/Text';
import BlogPostCard from '@/components/blog/BlogPostCard.astro';
import blocks from '@/components/Blocks/Blocks.module.scss';
import { getAllPosts } from '@/data/blog';
import styles from './HomeBlogHighlights.module.scss';

const FEATURED_SLUGS = [
  'best-ai-file-renamer-tools-windows-compared',
  'best-ai-file-organizers-windows',
  'best-ai-file-renamer-tools-mac-compared',
  'sort-files-into-folders-with-ai-mac',
] as const;

const posts = await getAllPosts();
const featured = FEATURED_SLUGS.map((slug) => {
  const post = posts.find((item) => item.slug === slug);

  if (!post) {
    throw new Error(`HomeBlogHighlights: missing blog post for slug "${slug}"`);
  }

  return post;
});
---

<section class={blocks.Section} aria-labelledby="home-blog-title">
  <div class={styles.HomeBlogHighlights__Header}>
    <div class={styles.HomeBlogHighlights__Intro}>
      <Heading as="h2" id="home-blog-title">Guides and comparisons</Heading>
      <Text as="p" size="lg" color="subtle">
        Compare AI file renamers and organizers for Mac and Windows, and sort files into
        folders with AI.
      </Text>
    </div>
    <a class={styles.HomeBlogHighlights__ActionLink} href="/blog">
      Read all guides
    </a>
  </div>

  <div class={styles.HomeBlogHighlights__Grid}>
    {featured.map((post) => (
      <BlogPostCard post={post} variant="tile" />
    ))}
  </div>
</section>
