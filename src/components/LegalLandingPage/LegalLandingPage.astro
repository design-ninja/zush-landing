---
import { Image } from 'astro:assets';
import { ArrowRight, Bot, Cloud, KeyRound } from 'lucide-react';
import audienceAttorneyImage from '@/assets/landing/legal-audience-attorney.webp';
import audienceOperationsImage from '@/assets/landing/legal-audience-operations.webp';
import audienceParalegalImage from '@/assets/landing/legal-audience-paralegal.webp';
import CloudFolders from '@/components/CloudFolders';
import DemoVideo from '@/components/DemoVideo/DemoVideo.astro';
import DownloadCTA from '@/components/DownloadCTA/DownloadCTA.astro';
import FAQ from '@/components/FAQ';
import BentoCard from '@/components/Features/BentoCard.astro';
import FeatureAnimation from '@/components/Features/FeatureAnimation';
import featureStyles from '@/components/Features/Features.module.scss';
import Heading from '@/components/Heading';
import Pricing from '@/components/Pricing/Pricing.astro';
import Text from '@/components/Text';
import sectionHeaderStyles from '@/components/SectionHeader/SectionHeader.module.scss';
import testimonialStyles from '@/components/Testimonials/Testimonials.module.scss';
import {
  LEGAL_AUDIENCES,
  LEGAL_DOCUMENT_TYPES,
  LEGAL_FAQ,
  LEGAL_ORGANIZATION_OUTCOMES,
  LEGAL_PRIVACY_MODES,
  LEGAL_PRIVACY_NOTE,
  LEGAL_WORKFLOW,
} from '@/data/legalLanding';
import { getCopy } from '@/i18n/copy';
import { FEATURE_DEMO_COPY } from '@/i18n/featureDemoCopy';
import { LegalFieldExplorer } from './LegalFieldExplorer';
import LegalHero from './LegalHero.astro';
import styles from './LegalLandingPage.module.scss';

const copy = getCopy('en');
const demoCopy = FEATURE_DEMO_COPY.en;
const PRIVACY_ICONS = { cloud: Cloud, byok: KeyRound, offline: Bot } as const;
const AUDIENCE_IMAGES = {
  attorney: {
    src: audienceAttorneyImage,
    alt: 'Solo attorney discussing a case file with a client in a private office',
  },
  paralegal: {
    src: audienceParalegalImage,
    alt: 'Paralegal scanning incoming case documents at a law firm',
  },
  operations: {
    src: audienceOperationsImage,
    alt: 'Legal operations specialist reviewing matter documents beside a laptop',
  },
} as const;
---

<LegalHero />

<div class={styles.HeroDemo}>
  <DemoVideo label="Zush organizing legal documents into searchable case files" />
</div>

<section class={styles.Audiences} aria-labelledby="legal-audiences-title">
  <div class={styles.Audiences__Container}>
    <div class={styles.Audiences__Intro}>
      <p class={styles.Audiences__Eyebrow}>Legal file organization</p>
      <Heading as="h2" id="legal-audiences-title" className={styles.Audiences__Title}>
        When the folder is the workspace, filenames become the index
      </Heading>
      <Text as="p" color="subtle" className={styles.Audiences__Description}>
        Zush helps legal teams organize the documents that live before, beside, and outside a formal document management system.
      </Text>
    </div>

    <ul class={styles.Audiences__List}>
      {LEGAL_AUDIENCES.map((audience) => (
        <li class={styles.Audience}>
          <div class={styles.Audience__Media}>
            <Image
              src={AUDIENCE_IMAGES[audience.icon].src}
              alt={AUDIENCE_IMAGES[audience.icon].alt}
              class={styles.Audience__Image}
              widths={[240, 360, 480, 720, 960]}
              sizes="(max-width: 640px) 100vw, 11rem"
              format="webp"
              quality={78}
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class={styles.Audience__Content}>
            <h3 class={styles.Audience__Title}>{audience.title}</h3>
            <p class={styles.Audience__Description}>{audience.description}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<section id="fields" class={styles.Fields} aria-labelledby="legal-fields-title">
  <div class={styles.Fields__Container}>
    <div class={sectionHeaderStyles.SectionHeader}>
      <Heading as="h2" align="center" id="legal-fields-title" className={sectionHeaderStyles.SectionHeader__Title}>
        Turn every case folder into a searchable matter record
      </Heading>
      <Text as="p" size="lg" color="subtle" align="center" className={sectionHeaderStyles.SectionHeader__Description}>
        Extract the client or matter number, document date, type, party, court, status, and version already inside each file. Your Template decides what appears in the filename and in which order.
      </Text>
    </div>

    <LegalFieldExplorer client:visible />
  </div>
</section>

<section id="privacy" class={styles.Privacy} aria-labelledby="legal-privacy-title">
  <div class={styles.Privacy__Container}>
    <div class={sectionHeaderStyles.SectionHeader}>
      <Heading as="h2" align="center" id="legal-privacy-title" className={sectionHeaderStyles.SectionHeader__Title}>
        Organize confidential legal documents on your terms
      </Heading>
      <Text as="p" size="lg" color="subtle" align="center" className={sectionHeaderStyles.SectionHeader__Description}>
        Choose local processing, your firm’s approved AI provider, or Zush-managed AI based on the documents in the workflow. The source files stay where your team already keeps them.
      </Text>
    </div>

    <div class={featureStyles.Band__Grid}>
      {LEGAL_PRIVACY_MODES.map((mode) => (
        <BentoCard
          title={mode.title}
          description={mode.description}
          icon={PRIVACY_ICONS[mode.id]}
          badge={mode.badge}
          badgeTone={mode.badgeTone}
        >
          <div class={featureStyles.UI_FeatureAnimation}>
            <FeatureAnimation kind={mode.kind} demoCopy={demoCopy} client:visible />
          </div>
        </BentoCard>
      ))}
    </div>

    <p class={styles.Privacy__Note}>
      {LEGAL_PRIVACY_NOTE}{' '}
      <a class={styles.ArrowLink} href="/docs/privacy-security">
        Read how the modes handle data
        <ArrowRight size={15} aria-hidden="true" />
      </a>
    </p>
  </div>
</section>

<section id="workflow" class={styles.Workflow} aria-labelledby="legal-workflow-title">
  <div class={styles.Workflow__Container}>
    <div class={sectionHeaderStyles.SectionHeader}>
      <Heading as="h2" align="center" id="legal-workflow-title" className={sectionHeaderStyles.SectionHeader__Title}>
        Add consistent file organization to the tools you already use
      </Heading>
      <Text as="p" size="lg" color="subtle" align="center" className={sectionHeaderStyles.SectionHeader__Description}>
        Use Zush as the naming layer between email, court downloads, scanners, shared folders, and your legal document management system.
      </Text>
    </div>

    <ol class={styles.Workflow__Steps}>
      {LEGAL_WORKFLOW.map((step, index) => (
        <li class={styles.WorkflowStep}>
          <span class={styles.WorkflowStep__Number} aria-hidden="true">{index + 1}</span>
          <h3 class={styles.WorkflowStep__Title}>{step.title}</h3>
          <p class={styles.WorkflowStep__Description}>{step.description}</p>
        </li>
      ))}
    </ol>

    <div class={styles.Workflow__Links}>
      <a class={styles.ArrowLink} href="/docs/templates/legal-documents">
        Build a legal document naming Template
        <ArrowRight size={15} aria-hidden="true" />
      </a>
      <a class={styles.ArrowLink} href="/docs/folder-monitoring">
        Automate legal document intake folders
        <ArrowRight size={15} aria-hidden="true" />
      </a>
      <a class={styles.ArrowLink} href="/blog/legal-file-naming-conventions">
        See legal file naming conventions and examples
        <ArrowRight size={15} aria-hidden="true" />
      </a>
    </div>
  </div>
</section>

<CloudFolders title={copy.home.cloudFoldersTitle} />

<section class={styles.Documents} aria-labelledby="legal-document-types-title">
  <div class={styles.Documents__Container}>
    <div class={sectionHeaderStyles.SectionHeader}>
      <Heading as="h2" align="center" id="legal-document-types-title" className={sectionHeaderStyles.SectionHeader__Title}>
        One organizer for the documents around every legal matter
      </Heading>
      <Text as="p" size="lg" color="subtle" align="center" className={sectionHeaderStyles.SectionHeader__Description}>
        Create separate naming rules for litigation, transactional work, discovery, and client intake while keeping a consistent matter-based structure across the firm.
      </Text>
    </div>

    <div class={styles.Documents__Grid}>
      {LEGAL_DOCUMENT_TYPES.map((documentType) => (
        <article class={styles.DocumentType}>
          <h3 class={styles.DocumentType__Title}>{documentType.title}</h3>
          <p class={styles.DocumentType__Description}>{documentType.description}</p>
          <code class={styles.DocumentType__Example}>{documentType.example}</code>
        </article>
      ))}
    </div>
  </div>
</section>

<section id="organization-outcomes" class={testimonialStyles.Testimonials} aria-labelledby="legal-outcomes-title">
  <div class={testimonialStyles.Testimonials__Container}>
    <div class={sectionHeaderStyles.SectionHeader}>
      <Heading as="h2" align="center" id="legal-outcomes-title" className={sectionHeaderStyles.SectionHeader__Title}>
        What better legal file organization changes
      </Heading>
      <Text as="p" size="lg" color="subtle" align="center" className={sectionHeaderStyles.SectionHeader__Description}>
        The goal is not prettier filenames. It is a case file that remains understandable wherever the documents go.
      </Text>
    </div>

    <div class={`${testimonialStyles.Testimonials__Grid} ${styles.Testimonials__Grid}`}>
      {LEGAL_ORGANIZATION_OUTCOMES.map((outcome) => (
        <article class={testimonialStyles.TestimonialCard}>
          <h3 class={testimonialStyles.TestimonialCard__Name}>{outcome.title}</h3>
          <Text as="p" size="sm" color="subtle">{outcome.description}</Text>
        </article>
      ))}
    </div>
  </div>
</section>

<Pricing copy={copy.pricing} />

<FAQ
  client:visible
  items={LEGAL_FAQ}
  title="Legal document organization, answered"
  description="How AI file organization works with matter folders, shared drives, legal document management software, confidential files, preview, and undo."
/>

<div class={styles.FinalCta}>
  <DownloadCTA
    title="Organize one copied case folder with Zush"
    subtitle="Start with a matter folder full of downloads, drafts, and scans. Review the proposed filenames, refine the naming rule, and undo the batch if it needs another pass."
  />
</div>
