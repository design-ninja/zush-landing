---
import SectionHeader from '@/components/SectionHeader';
import { DEFAULT_LOCALE, getLocalizedPath, type Locale } from '@/i18n/config';
import { ORGANIZATION_FEATURES } from '@/i18n/organizationFeatures';
import ThemedScreenshot from './ThemedScreenshot.astro';
import b from '@/components/Blocks/Blocks.module.scss';
import styles from './OrganizationFeatures.module.scss';
interface Props { locale?: Locale; platform?: 'mac' | 'windows'; showProductLink?: boolean }
const { locale = DEFAULT_LOCALE, platform = 'mac', showProductLink = false } = Astro.props;
const copy = ORGANIZATION_FEATURES[locale];
const sorterPath = getLocalizedPath('/ai-file-sorter', locale);
const guidePath = getLocalizedPath(`/blog/sort-files-into-folders-with-ai-mac${locale === DEFAULT_LOCALE ? '' : `-${locale}`}`, locale);
---

<section class={b.Section} aria-labelledby="organization-title">
  <SectionHeader eyebrow="BETA" id="organization-title" title={copy.sortingTitle} />
  <div class={styles.Feature}>
    <div class={styles.Copy}>
      <div class={styles.Mode}>
        <h3 class={b.ColumnTitle}>{copy.autoTitle}</h3>
        <p class={b.ColumnText}>{copy.autoDescription}</p>
      </div>
      <div class={styles.Mode}>
        <h3 class={b.ColumnTitle}>{copy.customTitle}</h3>
        <p class={b.ColumnText}>{copy.customDescription}</p>
        <div class={styles.Prompt}>
          <span class={styles.PromptLabel}>{copy.promptLabel}</span>
          <blockquote class={styles.RuleExample}>“{copy.ruleExample}”</blockquote>
        </div>
      </div>
      {copy.exampleFrom && copy.exampleTo && (
        <figure class={styles.Example}>
          <figcaption class={styles.PromptLabel}>{copy.exampleLabel}</figcaption>
          <p class={styles.ExamplePath}>
            <bdi dir="ltr"><code>{copy.exampleFrom}</code></bdi>
            <span class={styles.ExampleArrow} role="img" aria-label={copy.exampleArrowLabel ?? 'moves to'}>{locale === 'ar' ? '←' : '→'}</span>
            <bdi dir="ltr"><code>{copy.exampleTo}</code></bdi>
          </p>
          {copy.exampleCaption && <p class={styles.ExampleCaption}>{copy.exampleCaption}</p>}
        </figure>
      )}
      <p class={b.Links}>
        {showProductLink && copy.productLink && (
          <a href={sorterPath}>{copy.productLink} <span aria-hidden="true">→</span></a>
        )}
        <a href={guidePath}>{copy.sortingLink} <span aria-hidden="true">→</span></a>
      </p>
    </div>
    <div class:list={[b.Frame, styles.Visual]}>
      <ThemedScreenshot id="folder-sorting" platform={platform} alt={copy.sortingTab} zoom />
    </div>
  </div>
</section>
