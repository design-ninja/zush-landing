---
// "How it works" — design/homepage-concept/native.dc.html.
import SectionHeader from '@/components/SectionHeader';
import b from '@/components/Blocks/Blocks.module.scss';

const steps = [
  {
    title: 'Add your files',
    text: 'Documents, photos, video and audio.',
  },
  {
    title: 'Build the name',
    text: 'Set your rules with Naming Blocks.',
  },
  {
    title: 'Review & rename',
    text: 'Preview first, optionally sort into folders, undo when needed.',
  },
];
---

<section class={b.Section} aria-labelledby="rename-workflow-title">
  <SectionHeader
    align="left"
    id="rename-workflow-title"
    title="How Zush’s AI file renamer and organizer works"
    description="Zush reads the content and metadata of PDFs, photos, video and audio to suggest descriptive names. You review before applying, files stay put unless you turn on AI folder sorting (beta), and every rename or move can be undone."
  />

  <ol class={b.Columns}>
    {steps.map((step, index) => (
      <li class:list={[b.Column, b.Column_stack]}>
        <span class={b.StepNumber}>{String(index + 1).padStart(2, '0')}</span>
        <h3 class={b.ColumnTitle}>{step.title}</h3>
        <p class={b.ColumnText}>{step.text}</p>
        {index === 0 && <p class={b.Mono}>scan_001.pdf<br />IMG_2048.jpg<br />recording_03.wav</p>}
        {index === 1 && (
          <p class={b.Mono}>
            Vendor <span class={b.MonoStrong}>Acme</span> · Type <span class={b.MonoStrong}>Invoice</span> · Number <span class={b.MonoStrong}>1042</span><br />Vendor_Type_Number.pdf
          </p>
        )}
        {index === 2 && (
          <p class={b.Mono}>
            <s>scan_001.pdf</s><br /><span class={b.MonoStrong}>Acme_Invoice_1042.pdf</span><br />You can undo this rename
          </p>
        )}
      </li>
    ))}
  </ol>
</section>
