---
import Hero from '@/components/Hero';
import HomeRenameWorkflow from './HomeRenameWorkflow.astro';
import DemoVideo from '@/components/DemoVideo/DemoVideo.astro';
import Tour from '@/components/Tour';
import HomeFeatures from './HomeFeatures.astro';
import HomeWaysToRun from './HomeWaysToRun.astro';
import SupportedFormats from '@/components/SupportedFormats';
import CloudFolders from '@/components/CloudFolders';
import HomeBlogHighlights from '@/components/HomeBlogHighlights/HomeBlogHighlights.astro';
import HomeProfessions from '@/components/HomeProfessions/HomeProfessions.astro';
import HomeWorkflows from '@/components/HomeWorkflows/HomeWorkflows.astro';
import Pricing from '@/components/Pricing/Pricing.astro';
import FAQ from '@/components/FAQ';
import DownloadCTA from '@/components/DownloadCTA/DownloadCTA.astro';
import CrossPlatformBanner from '@/components/CrossPlatformBanner/CrossPlatformBanner.astro';
import EvidenceSignals from '@/components/EvidenceSignals/EvidenceSignals.astro';
import Testimonials from '@/components/Testimonials/Testimonials.astro';
import FeaturedOn from '@/components/FeaturedOn/FeaturedOn.astro';
import ComparisonTable from '@/components/ComparisonTable/ComparisonTable.astro';
import { HOME_COMPARISON } from '@/data/homeComparison';
import macChangelogSource from '@/content/changelog.md?raw';
import windowsChangelogSource from '@/content/changelog.windows.md?raw';
import { parseLatestVersion } from '@/utils/version';
import type { Locale } from '@/i18n/config';
import type { LocaleCopy } from '@/i18n/copy';
import type { ProfessionLocaleCopy } from '@/i18n/professions/types';
import { SOFTPEDIA_RATED_BY_LABELS, SOFTPEDIA_REVIEW_ARIA_LABELS } from '@/i18n/softpediaReview';
import { MICROSOFT_STORE_RATED_ON_LABELS, MICROSOFT_STORE_RATING_ARIA_LABELS } from '@/i18n/microsoftStoreRating';

interface Props {
  copy: LocaleCopy;
  locale: Locale;
  secondaryHref?: string;
  professionCopy?: ProfessionLocaleCopy;
}

const { copy, locale, secondaryHref, professionCopy } = Astro.props as Props;
const macVersion = parseLatestVersion(macChangelogSource) ?? undefined;
const windowsVersion = parseLatestVersion(windowsChangelogSource) ?? undefined;
---

<div class="home-hero">
<div class="home-hero__wave" aria-hidden="true"><canvas class="home-hero__canvas" data-hero-wave></canvas></div>
<div class="home-hero__scrim" aria-hidden="true"></div>
<Hero
  client:idle
  title={copy.home.heroTitle}
  titleAccent={copy.home.heroAccent}
  titleHighlight={copy.home.heroTitle.includes('\n') ? copy.home.heroTitle.split('\n').pop() : copy.home.heroAccent}
  subtitle={copy.home.heroSubtitle}
  subtitleHighlights={copy.home.heroHighlights}
  buyLabel={copy.home.buyPro}
  downloadLabel={copy.header.download}
  downloadMenu={copy.downloadMenu}
  trustSignals={copy.home.trustSignals}
  secondaryHref={secondaryHref}
  centered
  splitByOS
  macVersion={macVersion}
  windowsVersion={windowsVersion}
  softpediaRatedByLabel={SOFTPEDIA_RATED_BY_LABELS[locale]}
  softpediaReviewAriaLabel={SOFTPEDIA_REVIEW_ARIA_LABELS[locale]}
  microsoftStoreRatedOnLabel={MICROSOFT_STORE_RATED_ON_LABELS[locale]}
  microsoftStoreRatingAriaLabel={MICROSOFT_STORE_RATING_ARIA_LABELS[locale]}
  waveBackground
/>
</div>
<script>
  import '@/scripts/hero-wave';
</script>
<style>
  /* Animated point-wave behind the homepage intro (src/scripts/hero-wave.ts).
     The canvas stays outside the hydrated Hero island on purpose. */
  .home-hero {
    position: relative;
    isolation: isolate;
    overflow-x: clip;
  }

  .home-hero :global([data-hero-root]) {
    position: relative;
    z-index: 1;
  }

  .home-hero__wave {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    mask-image: linear-gradient(to bottom, transparent 0%, #000 24%, #000 70%, transparent 100%);
  }

  .home-hero__canvas {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .home-hero__canvas[data-ready='true'] {
    opacity: 1;
  }

  /* Soft pool of page colour under the copy so the points never fight the text. */
  .home-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(
      ellipse 40% 36% at 50% 52%,
      color-mix(in oklch, var(--background) 78%, transparent) 0%,
      color-mix(in oklch, var(--background) 78%, transparent) 42%,
      transparent 100%
    );
  }

  @media (max-width: 768px) {
    .home-hero__scrim {
      background: radial-gradient(
        ellipse 80% 46% at 50% 50%,
        color-mix(in oklch, var(--background) 84%, transparent) 0%,
        color-mix(in oklch, var(--background) 84%, transparent) 50%,
        transparent 100%
      );
    }
  }
</style>
<DemoVideo label={copy.home.showcase.title} />
<EvidenceSignals locale={locale} variant="intro" />
{locale === 'en'
  ? <HomeRenameWorkflow />
  : <EvidenceSignals locale={locale} variant="control" showControlHeading />}
<HomeFeatures
  title={copy.home.featuresTitle}
  description={copy.home.featuresDescription}
  copy={copy.home.featureCards}
  locale={locale}
/>
<HomeWaysToRun copy={copy.home.featureCards} />
{(locale === 'en' || professionCopy) && (
  <HomeProfessions locale={locale} homeCopy={copy.home} professionCopy={professionCopy} />
)}
<HomeWorkflows copy={copy.home.workflows} locale={locale} />
<CloudFolders title={copy.home.cloudFoldersTitle} />
<Testimonials locale={locale} />
<Tour copy={copy.home.showcase} />
<Pricing copy={copy.pricing} />
<FAQ
  title={copy.home.faqTitle}
  description={copy.home.faqDescription}
  items={copy.home.faqItems}
/>
<DownloadCTA
  title={copy.home.downloadTitle}
  subtitle={copy.home.downloadSubtitle}
  hintPrefix={copy.home.downloadHintPrefix}
  downloadLabel={copy.header.download}
  downloadMenu={copy.downloadMenu}
/>
<CrossPlatformBanner locale={locale} />
{locale === 'en' && <ComparisonTable {...HOME_COMPARISON} />}
{locale === 'en' && <HomeBlogHighlights />}
<EvidenceSignals locale={locale} variant="facts" />
<SupportedFormats
  title={copy.home.supportedFormats}
  imagesLabel={copy.home.images}
  designLabel={copy.home.designLabel}
  documentsLabel={copy.home.documents}
  videosLabel={copy.home.videosLabel}
  audioLabel={copy.home.audioLabel}
/>
<EvidenceSignals locale={locale} variant="sources" />
<FeaturedOn locale={locale} />
