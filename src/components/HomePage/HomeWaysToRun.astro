---
// "Choose where AI runs" — design/homepage-concept/native.dc.html.
import { Cloud, KeyRound, ShieldCheck } from 'lucide-react';
import SectionHeader from '@/components/SectionHeader';
import { DEFAULT_FEATURE_CARDS_COPY, type FeatureCardsCopy } from '@/i18n/copy';
import b from '@/components/Blocks/Blocks.module.scss';

interface Props {
  copy?: FeatureCardsCopy;
}

const { copy = DEFAULT_FEATURE_CARDS_COPY } = Astro.props as Props;
const modes = [
  { Icon: Cloud, ...copy.cloudAi },
  { Icon: KeyRound, ...copy.byok },
  { Icon: ShieldCheck, ...copy.offlineAi },
];
---

<section id="ways-to-run" class={b.Section}>
  <SectionHeader title={copy.bandTitle} description={copy.bandSubtitle} />

  <div class={b.Columns}>
    {modes.map(({ Icon, title, description }) => (
      <div class={b.Column}>
        <span class={b.ColumnIcon}><Icon size={24} strokeWidth={1.7} aria-hidden="true" /></span>
        <h3 class={b.ColumnTitle}>{title}</h3>
        <p class={b.ColumnText}>{description}</p>
      </div>
    ))}
  </div>
</section>
