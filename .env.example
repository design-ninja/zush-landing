# Environment-variable catalog for Zush Landing. Keep placeholders only.
# Do not copy secrets into a plaintext `.env` file.
#
# Local commands use ignored `.env.1password*` files containing only `op://`
# references. Vercel deployment secrets remain in Vercel Environment Variables.

PUBLIC_SUPABASE_URL=

PUBLIC_PADDLE_TOKEN=your_paddle_token_here
PUBLIC_PADDLE_ENVIRONMENT=sandbox
PUBLIC_PADDLE_PRO_MONTHLY_PRICE_ID=pri_...
PUBLIC_PADDLE_PRO_ONE_TIME_PRICE_ID=pri_...
PADDLE_API_KEY=

# Optional AI keys used by promo capture scripts.
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

GH_TOKEN=
GITHUB_TOKEN=

# Google Search Console
GSC_SITE_URL=
GSC_TOKEN_FILE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Bing Webmaster Tools
BING_WEBMASTER_API_KEY=

# Optional Google Ads website conversion tracking.
# Use values from Google Ads > Goals > Conversions > Website.
#
# Leave PUBLIC_GOOGLE_ADS_ID unset while no campaign is running. The build
# then tree-shakes src/utils/adTracking.ts down to empty no-ops and emits
# zero googletagmanager / doubleclick references — verified 2026-07-28.
# Setting it costs ~61 KB of unused JS plus three third-party connections
# on every page, so only set it while ads are actually live.
PUBLIC_GOOGLE_ADS_ID=AW-000000000
PUBLIC_GOOGLE_ADS_DOWNLOAD_CONVERSION_LABEL=
PUBLIC_GOOGLE_ADS_PURCHASE_CONVERSION_LABEL=

# Google Ads MCP / API access (local only).
# Requires Google Ads API enabled in the Google Cloud project.
# Keep GOOGLE_ADS_MCP_OAUTH_CLIENT_ID / GOOGLE_ADS_MCP_OAUTH_CLIENT_SECRET
# unset for local stdio mode; setting them switches the MCP server to HTTP.
GOOGLE_PROJECT_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Hosted review API (Vercel Production only).
RESEND_API_KEY=
REVIEW_FROM_EMAIL=Zush Reviews <support@zushapp.com>

# YouTube uploader (local script only)
YOUTUBE_REDIRECT_PORT=8787

# Optional local notifications and operations
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# PostHog
# Project key also gates the server-side capture in /download/mac and the
# distinct_id read from PostHog's own cookie.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=/e
# Optional PostHog dashboard host; defaults to https://us.posthog.com.
PUBLIC_POSTHOG_UI_HOST=
POSTHOG_PERSONAL_API_KEY=
